---
/**
 * Footer link target for campaign emails (?token=…). GET never changes
 * anything (mail scanners prefetch links); the button POSTs to
 * /api/unsubscribe, which redirects back here with ?done=1.
 */
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import siteData from "@/data/site.json";
import { findByToken } from "@/lib/server/subscribers";

export const prerender = false;

const token = Astro.url.searchParams.get("token") ?? "";
const row = token ? await findByToken(Astro.locals.runtime.env.DB, token) : null;
const state: "invalid" | "confirm" | "done" = !row ? "invalid" : row.status === "unsubscribed" ? "done" : "confirm";
---
<Base title="Unsubscribe" description="Manage your BU SHPE mailing list subscription.">
  {state === "invalid" && (
    <PageHero
      eyebrow="Mailing list"
      headline="We couldn't find that link."
      headlineAccent="couldn't"
      subtitle="This unsubscribe link is incomplete or no longer valid. Use the link at the bottom of any recent email from us, or write to us and we'll take you off the list."
      ctas={[{ href: `mailto:${siteData.contactEmail}?subject=Unsubscribe`, label: "Email us" }]}
    />
  )}

  {state === "confirm" && row && (
    <>
      <PageHero
        eyebrow="Mailing list"
        headline="Leaving so soon?"
        headlineAccent="so soon"
        subtitle={`Confirm below and ${row.email} will stop receiving BU SHPE emails.`}
      />
      <section class="mx-auto max-w-[1200px] px-6 py-24">
        <form method="post" action="/api/unsubscribe" class="flex flex-wrap items-center gap-4">
          <input type="hidden" name="token" value={token} />
          <button type="submit" class="btn-dossier">Unsubscribe me</button>
          <a href="/" class="btn-dossier-ghost">Keep me on the list</a>
        </form>
      </section>
    </>
  )}

  {state === "done" && row && (
    <>
      <PageHero
        eyebrow="Mailing list"
        headline="You're unsubscribed."
        headlineAccent="unsubscribed"
        subtitle={`${row.email} won't get any more BU SHPE emails. Hasta pronto.`}
      />
      <section class="mx-auto max-w-[1200px] px-6 py-24">
        <p class="max-w-3xl text-base leading-relaxed text-ink-muted">
          Changed your mind? You can rejoin anytime from the <a href="/join" class="text-link underline">join page</a>.
        </p>
      </section>
    </>
  )}
</Base>
