---
import Base from "@/layouts/Base.astro";
import OrangeTick from "@/components/OrangeTick.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";

import siteData from "@/data/site.json";
import eventsRaw from "@/data/events.json";

import type { EventItem } from "@/types";

const events = eventsRaw as EventItem[];

const today = new Date().toISOString().slice(0, 7);

const categories = [...new Set(events.map((e) => e.category))];

const upcoming = events
  .filter((e) => e.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date));

const past = events
  .filter((e) => e.date < today)
  .sort((a, b) => b.date.localeCompare(a.date));

const totalCount = events.length;

const monthNames = [
  "JAN", "FEB", "MAR", "APR", "MAY", "JUN",
  "JUL", "AUG", "SEP", "OCT", "NOV", "DEC",
];

function formatDate(iso: string): string {
  const [y, m, d] = iso.split("-");
  const monthIdx = parseInt(m, 10) - 1;
  const month = monthNames[monthIdx] ?? "—";
  if (d) return `${d} ${month}`;
  return `${month} ${y.slice(2)}`;
}

const chipBase = "inline-flex items-center rounded-full px-5 py-2 font-sans text-xs font-semibold uppercase tracking-[0.12em] transition-colors";
const chipInactive = "border border-rule/60 text-ink-muted hover:border-ink hover:text-ink";
---

<Base
  title="All Events"
  description="The full BU SHPE event calendar — every workshop, mixer, and trip from the chapter's recent history."
>

  <!-- ① Compact navy hero -->
  <section class="bg-deep py-24 md:py-32 px-6">
    <div class="max-w-[1200px] mx-auto">
      <OrangeTick />
      <p class="eyebrow text-cream/70 mb-4">ALL EVENTS</p>
      <h1 class="display text-5xl md:text-6xl text-cream leading-none">
        The whole <em class="font-serif italic font-normal lowercase tracking-normal text-accent">season</em>.
      </h1>
      <p class="max-w-2xl mt-8 text-cream/80 text-lg">
        The full chapter calendar — every workshop, mixer, and trip. {totalCount} {totalCount === 1 ? "event" : "events"} on record.
      </p>
    </div>
  </section>

  <!-- ② Content: back link + filter chips + upcoming + past -->
  <section id="all-events-content" class="max-w-[1200px] mx-auto px-6 py-16 md:py-24">

    <!-- Top row: back link (left) + filter chips (right) -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-12">
      <a
        href="/events"
        class="group inline-flex items-center gap-2 font-sans text-sm font-medium text-ink-muted hover:text-ink transition-colors self-start"
      >
        <Icon name="arrow-forward" class="w-4 h-4 rotate-180 transition-transform group-hover:-translate-x-1" />
        <span class="border-b border-current pb-0.5">Back to events</span>
      </a>
      <div class="flex flex-wrap gap-3 items-center md:justify-end">
        <span class="eyebrow text-ink-muted mr-2">Filter by</span>

        <a
          data-chip
          data-chip-value=""
          href="/events/all"
          class:list={[chipBase, chipInactive]}
        >
          All
        </a>

        {categories.map((cat) => (
          <a
            data-chip
            data-chip-value={cat}
            href={`/events/all?cat=${encodeURIComponent(cat)}`}
            class:list={[chipBase, chipInactive]}
          >
            {cat}
          </a>
        ))}
      </div>
    </div>

    <!-- Empty state (JS toggles visibility) -->
    <p data-empty-state hidden class="text-ink-muted italic text-center py-16">No events match this filter.</p>

    {/* Upcoming */}
    {upcoming.length > 0 && (
      <div data-section="upcoming" class="mb-24">
        <div class="flex items-end justify-between mb-12 border-b border-outline-soft pb-6">
          <h2 class="display text-3xl md:text-4xl text-ink">Upcoming</h2>
          <p class="eyebrow text-ink-muted" data-count>{upcoming.length} {upcoming.length === 1 ? "event" : "events"}</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 gap-y-16">
          {upcoming.map((event) => (
            <article data-event data-category={event.category} class="group flex flex-col">
              <div class="aspect-[4/3] overflow-hidden bg-surface-soft mb-5">
                {event.photo && (
                  <img
                    src={event.photo}
                    alt={event.title}
                    class="w-full h-full object-cover transition group-hover:scale-[1.02]"
                    loading="lazy"
                  />
                )}
              </div>
              <div class="flex items-baseline gap-3 mb-3">
                <span class="display text-xl text-accent leading-none tabular-nums">{formatDate(event.date)}</span>
                <span class="eyebrow text-ink-muted">{event.category}</span>
              </div>
              <h3 class="display text-xl md:text-2xl text-ink mb-2 leading-tight">{event.title}</h3>
              <p class="text-sm text-ink-muted leading-relaxed">{event.description}</p>
            </article>
          ))}
        </div>
      </div>
    )}

    {/* Past */}
    {past.length > 0 && (
      <div data-section="past">
        <div class="flex items-end justify-between mb-12 border-b border-outline-soft pb-6">
          <h2 class="display text-3xl md:text-4xl text-ink">Past</h2>
          <p class="eyebrow text-ink-muted" data-count>{past.length} {past.length === 1 ? "event" : "events"}</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 gap-y-16">
          {past.map((event) => (
            <article data-event data-category={event.category} class="group flex flex-col">
              <div class="aspect-[4/3] overflow-hidden bg-surface-soft mb-5">
                {event.photo && (
                  <img
                    src={event.photo}
                    alt={event.title}
                    class="w-full h-full object-cover transition group-hover:scale-[1.02]"
                    loading="lazy"
                  />
                )}
              </div>
              <div class="flex items-baseline gap-3 mb-3">
                <span class="display text-xl text-ink leading-none tabular-nums">{formatDate(event.date)}</span>
                <span class="eyebrow text-ink-muted">{event.category}</span>
              </div>
              <h3 class="display text-xl md:text-2xl text-ink mb-2 leading-tight">{event.title}</h3>
              <p class="text-sm text-ink-muted leading-relaxed">{event.description}</p>
            </article>
          ))}
        </div>
      </div>
    )}

  </section>

  <!-- ③ Mailing list CTA -->
  <CtaBand
    heading="Don't miss the next one."
    body="The mailing list is how members hear about workshops, mixers, and conference travel."
    primaryCta={{ label: "Join the mailing list", href: "/join" }}
    secondaryCta={{ label: "Follow on Instagram", href: siteData.socials.instagram }}
  />

  <script is:inline>
    (function () {
      var root = document.getElementById("all-events-content");
      if (!root) return;

      var chips = root.querySelectorAll("[data-chip]");
      var events = root.querySelectorAll("[data-event]");
      var sections = root.querySelectorAll("[data-section]");
      var emptyState = root.querySelector("[data-empty-state]");

      var inactiveClasses = ["border", "border-rule/60", "text-ink-muted", "hover:border-ink", "hover:text-ink"];
      var activeClasses = ["bg-ink", "text-cream"];

      function setActive(value) {
        chips.forEach(function (chip) {
          var chipValue = chip.getAttribute("data-chip-value") || "";
          if (chipValue === value) {
            inactiveClasses.forEach(function (c) { chip.classList.remove(c); });
            activeClasses.forEach(function (c) { chip.classList.add(c); });
            chip.setAttribute("aria-current", "true");
          } else {
            activeClasses.forEach(function (c) { chip.classList.remove(c); });
            inactiveClasses.forEach(function (c) { chip.classList.add(c); });
            chip.removeAttribute("aria-current");
          }
        });
      }

      function applyFilter(cat) {
        cat = cat || "";
        setActive(cat);
        events.forEach(function (el) {
          var matches = !cat || el.getAttribute("data-category") === cat;
          el.hidden = !matches;
        });
        sections.forEach(function (section) {
          var visible = Array.prototype.filter.call(
            section.querySelectorAll("[data-event]"),
            function (el) { return !el.hidden; }
          );
          section.hidden = visible.length === 0;
          var countEl = section.querySelector("[data-count]");
          if (countEl) {
            countEl.textContent = visible.length + " " + (visible.length === 1 ? "event" : "events");
          }
        });
        if (emptyState) {
          var anyVisible = Array.prototype.some.call(events, function (el) { return !el.hidden; });
          emptyState.hidden = anyVisible;
        }
      }

      var params = new URLSearchParams(location.search);
      applyFilter(params.get("cat"));

      chips.forEach(function (chip) {
        chip.addEventListener("click", function (e) {
          e.preventDefault();
          var value = chip.getAttribute("data-chip-value") || "";
          var url = value
            ? location.pathname + "?cat=" + encodeURIComponent(value)
            : location.pathname;
          history.pushState({}, "", url);
          applyFilter(value);
        });
      });

      window.addEventListener("popstate", function () {
        var p = new URLSearchParams(location.search);
        applyFilter(p.get("cat"));
      });
    })();
  </script>

</Base>
