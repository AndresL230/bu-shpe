---
import Base from "@/layouts/Base.astro";
import EventDetailClassic from "@/components/variants/EventDetailClassic.astro";
import EventDetailDossier from "@/components/variants/EventDetailDossier.astro";

import { formatEventDate, isUpcoming } from "@/lib/events";
import { getEventBySlug, PUBLIC_EVENTS_CACHE_CONTROL } from "@/lib/server/events";

// Rendered on demand from D1 so newly published events appear without a rebuild.
export const prerender = false;

const slug = Astro.params.slug ?? "";
const event = await getEventBySlug(Astro.locals.runtime.env.DB, slug);

// Unknown slug or a draft: real 404. Rewrites to /404 so a future
// src/pages/404.astro is picked up; until then Astro serves its default.
if (!event) {
  return Astro.rewrite("/404");
}

Astro.response.headers.set("Cache-Control", PUBLIC_EVENTS_CACHE_CONTROL);

const upcoming = isUpcoming(event.date);
const displayDate = formatEventDate(event.date, { withDay: upcoming });
const currentYear = new Date().getFullYear();
---

<Base
  title={event.title}
  description={event.description}
>
  <div data-variant-block="classic">
    <EventDetailClassic event={event} displayDate={displayDate} currentYear={currentYear} />
  </div>
  <div data-variant-block="dossier">
    <EventDetailDossier event={event} displayDate={displayDate} upcoming={upcoming} />
  </div>
</Base>
