---
import Base from "@/layouts/Base.astro";
import OrangeTick from "@/components/OrangeTick.astro";
import ZigZagBlock from "@/components/ZigZagBlock.astro";
import CtaBand from "@/components/CtaBand.astro";
import Reveal from "@/components/Reveal.astro";
import Icon from "@/components/Icon.astro";
import SponsorGrid from "@/components/SponsorGrid.astro";

import siteData from "@/data/site.json";
import eventsRaw from "@/data/events.json";
import sponsorsRaw from "@/data/sponsors.json";

import type { EventItem, Sponsor } from "@/types";

const events = [...(eventsRaw as EventItem[])].sort((a, b) => b.date.localeCompare(a.date));
const recentEvents = events.slice(0, 3);

const sponsors = sponsorsRaw as Sponsor[];

const MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"] as const;

function formatEventDate(iso: string): string {
  // ISO is either "yyyy-mm" or "yyyy-mm-dd".
  const parts = iso.split("-");
  const year = parts[0];
  const monthIdx = Number(parts[1]) - 1;
  const month = MONTHS[monthIdx] ?? "";
  if (parts.length >= 3) {
    // Day available — render "DD MON".
    return `${parts[2].padStart(2, "0")} ${month}`;
  }
  // Month-only — render "MON YY".
  const yy = year.slice(-2);
  return `${month} ${yy}`;
}
---

<Base title="Home">
  <!-- ① Hero — split: light text panel + campus photo -->
  <section class="relative grid grid-cols-1 md:grid-cols-2 min-h-[calc(100vh-72px)] overflow-hidden">
    <div class="flex items-center justify-center px-6 md:px-12 lg:px-16 xl:px-24 py-12 md:py-0 guide-pad">
      <div class="max-w-[672px] w-full guide-content">
        <div class="w-8 h-[3px] bg-accent mb-6"></div>
        <h1 class="display text-5xl md:text-6xl lg:text-7xl text-ink leading-[1.02] mb-4">
          <span class="block">SHPE</span>
          <span class="block">Boston University</span>
        </h1>
        <p class="font-serif italic text-accent text-xl mb-6">¡Bienvenidos a la familia!</p>
        <p class="text-ink-muted text-lg leading-relaxed mb-10">
          Building the next generation of Hispanic engineers, <em class="font-serif italic font-normal lowercase tracking-normal text-accent">together</em>. {siteData.mission}
        </p>
        <div class="flex flex-wrap items-center gap-6">
          <a
            href="/about"
            class="group inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 font-sans text-xs font-semibold uppercase tracking-[0.12em] text-white shadow-sm transition hover:-translate-y-px hover:shadow-md"
          >
            Explore Chapter
            <Icon name="arrow-forward" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
          </a>
          <a
            href="/events"
            class="group inline-flex items-center gap-2 font-sans text-base font-medium text-ink transition-colors hover:text-accent"
          >
            <span class="border-b border-current pb-0.5">View Events</span>
            <Icon name="arrow-forward" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
          </a>
        </div>
      </div>
    </div>
    <div class="relative flex flex-col py-8 md:py-16 pr-6 md:pr-12 lg:pr-16 xl:pr-24 guide-pad">
      <div class="relative w-full flex-1 overflow-hidden guide-content">
        <img
          src="/assets/campus/Boston-University-Center-For-Computing-Data-Sciences-Building-Located-Near-The-Charles-River-In-Boston-Massachusetts-USA.jpg"
          alt="The Charles River with BU's Center for Computing & Data Sciences and the Boston skyline"
          class="absolute inset-0 w-full h-full object-cover select-none"
          style="object-position: 65% center;"
          loading="eager"
          draggable="false"
        />
        <div class="absolute bottom-4 left-4 bg-deep text-cream px-4 py-2 font-cond uppercase tracking-widest text-xs md:text-sm z-10">
          EST. 1974
        </div>
      </div>
    </div>
  </section>

  <!-- ② Hairline divider -->
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="border-t border-rule"></div>
  </div>

  <!-- ③ Mission band — 40/60 asymmetric -->
  <section>
    <div class="max-w-[1200px] mx-auto px-6 py-24 md:py-32 flex flex-col md:flex-row gap-12 md:gap-20">
      <div class="md:w-2/5 order-2 md:order-1">
        <OrangeTick />
        <p class="pullquote text-ink">
          "Diversity is not just a metric; it is the catalyst for the innovation that will solve the next century's most pressing engineering challenges."
        </p>
        <p class="eyebrow mt-8 text-ink-muted">— BU SHPE Executive Board</p>
      </div>
      <div class="md:w-3/5 order-1 md:order-2">
        <p class="eyebrow text-ink-muted mb-4">OUR MISSION</p>
        <h2 class="display text-4xl md:text-5xl text-ink mb-8">
          Paving a pathway for Hispanic brilliance in STEM.
        </h2>
        <p class="text-ink-muted mb-6 text-lg">{siteData.mission}</p>
        <p class="text-ink-muted mb-6 text-lg">
          Our chapter at Boston University provides a home-away-from-home for engineers, designers, and scientists, offering a unique blend of professional mentorship and academic rigor.
        </p>
      </div>
    </div>
  </section>

  <!-- ④ Pillars zig-zag -->
  <section class="bg-surface-soft py-24 md:py-32">
    <div class="max-w-[1200px] mx-auto px-6 space-y-24 md:space-y-32">
      <Reveal>
        <ZigZagBlock
          image="/assets/conferences/national-convention-2023-slc.jpeg"
          imageAlt="SHPE National Convention 2023 in Salt Lake City"
          heading="Conferences"
          body="Every year, we take members to the SHPE National Convention — the largest Hispanic technical conference in the world. It's where résumés meet dream jobs."
          bullets={["Resume reviews", "Interview prep", "Career fairs"]}
          split="60-40"
        />
      </Reveal>
      <Reveal>
        <ZigZagBlock
          image="/assets/volunteering/museum-of-science-1.jpeg"
          imageAlt="BU SHPE volunteering at the Museum of Science"
          heading="Volunteering"
          body="Giving back is in our DNA. We mentor local high school students and run workshops to inspire the next generation to pursue careers in STEM."
          bullets={["K-12 outreach", "Local STEM fairs", "Chapter mentorship"]}
          reverse={true}
        />
      </Reveal>
      <Reveal>
        <ZigZagBlock
          image="/assets/events/capital-one-workshop.jpg"
          imageAlt="Capital One workshop"
          heading="Professional Development"
          body="From LinkedIn optimizations to technical workshops with industry partners, we ensure our members are ready for the workforce."
          bullets={["Corporate mixers", "Tech talks", "Soft-skills seminars"]}
          split="60-40"
        />
      </Reveal>
    </div>
  </section>

  <!-- ⑤ Recent events grid -->
  <section class="py-24 md:py-32">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="flex items-end justify-between gap-6">
        <h3 class="display text-3xl md:text-4xl text-ink">Recent events</h3>
        <a
          href="/events"
          class="group inline-flex items-center gap-2 font-sans text-base font-medium text-ink hover:text-accent transition-colors"
        >
          <span class="border-b border-current pb-0.5">View all</span>
          <Icon name="arrow-forward" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 border border-outline-soft mt-12">
        {recentEvents.map((event) => (
          <article class="border-r border-outline-soft last:border-r-0 group p-8 flex flex-col bg-surface hover:bg-surface-soft transition-colors">
            <span class="eyebrow text-accent">{event.category}</span>
            <div class="display text-5xl text-ink leading-[0.8] opacity-10 group-hover:opacity-20 transition my-6">
              {formatEventDate(event.date)}
            </div>
            <h4 class="display text-2xl text-ink mb-4 group-hover:text-accent transition">{event.title}</h4>
            <p class="text-ink-muted text-sm flex-grow mb-8">{event.description}</p>
            <div class="border-t border-rule pt-4 flex justify-between items-center">
              <span class="font-cond uppercase tracking-widest text-xs">{event.category}</span>
              <Icon name="arrow-forward" class="w-4 h-4 text-accent" />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑥ Sponsor strip -->
  <section class="bg-surface-soft py-24 md:py-32">
    <div class="max-w-[1200px] mx-auto px-6">
      <p class="eyebrow text-ink-muted mb-8">With support from</p>
      <SponsorGrid sponsors={sponsors} />
    </div>
  </section>

  <!-- ⑦ CTA band -->
  <CtaBand
    heading={'Become part of the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">familia</em>.'}
    body="Whether you are a student, alum, or corporate partner, there is a place for you in our mission to change the face of engineering."
    primaryCta={{ label: "Join SHPE", href: "/join" }}
    secondaryCta={{ label: "Meet the board", href: "/board" }}
  />
</Base>
