---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { listAllEvents } from "@/lib/server/events";
import { flashMessage } from "@/lib/server/event-form";
import { formatEventDate, isUpcoming } from "@/lib/events";
import { formatShpeYear, parseShpeYear, shpeYearOf } from "@/lib/shpe-year";

export const prerender = false;

const everything = await listAllEvents(Astro.locals.runtime.env.DB);

// SHPE year filter (?year=2026). Date-TBA events count as the current year.
const years = [...new Set(everything.map((e) => shpeYearOf(e.date)))].sort((a, b) => b - a);
const yearParam = parseShpeYear(Astro.url.searchParams.get("year"));
const year = yearParam !== null && years.includes(yearParam) ? yearParam : null;
const all = year === null ? everything : everything.filter((e) => shpeYearOf(e.date) === year);

const views = [
  { key: "all", label: "All" },
  { key: "upcoming", label: "Upcoming" },
  { key: "past", label: "Past" },
  { key: "drafts", label: "Drafts" },
] as const;
type View = (typeof views)[number]["key"];
const requested = Astro.url.searchParams.get("view");
const view: View = views.some((v) => v.key === requested) ? (requested as View) : "all";

const counts: Record<View, number> = {
  all: all.length,
  upcoming: all.filter((e) => e.published && isUpcoming(e.date)).length,
  past: all.filter((e) => e.published && !isUpcoming(e.date)).length,
  drafts: all.filter((e) => !e.published).length,
};

let rows = all;
if (view === "upcoming") rows = all.filter((e) => e.published && isUpcoming(e.date)).reverse(); // soonest first
if (view === "past") rows = all.filter((e) => e.published && !isUpcoming(e.date));
if (view === "drafts") rows = all.filter((e) => !e.published);

const href = (v: View, y: number | null) => {
  const q = new URLSearchParams();
  if (v !== "all") q.set("view", v);
  if (y !== null) q.set("year", String(y));
  return q.size ? `/admin/events?${q}` : "/admin/events";
};

const ok = flashMessage(Astro.url.searchParams.get("ok"));
const error = flashMessage(Astro.url.searchParams.get("error"));
---
<AdminLayout title="Events" accent="ledger" eyebrow="01 — Events" section="events">
  <a slot="actions" href="/admin/events/new" class="btn-dossier">+ New event</a>

  {ok && <p class="adm-flash adm-flash--ok mb-8" role="status">{ok}</p>}
  {error && <p class="adm-flash adm-flash--error mb-8" role="alert">{error}</p>}

  <div class="mb-6 flex flex-wrap items-center gap-x-6 gap-y-3">
    <nav class="adm-segment" aria-label="Filter events">
      {views.map((v) => (
        <a href={href(v.key, year)} aria-current={v.key === view ? "page" : undefined}>
          {v.label} <span class="opacity-60">{counts[v.key]}</span>
        </a>
      ))}
    </nav>
    {years.length > 1 && (
      <nav class="adm-segment" aria-label="SHPE year">
        <a href={href(view, null)} aria-current={year === null ? "page" : undefined}>All years</a>
        {years.map((y) => (
          <a href={href(view, y)} aria-current={y === year ? "page" : undefined}>{formatShpeYear(y)}</a>
        ))}
      </nav>
    )}
  </div>

  {rows.length === 0 ? (
    <div class="adm-panel">
      <p class="mono-label mb-2">Empty</p>
      <p class="text-ink-muted">Nothing in this view yet.</p>
    </div>
  ) : (
    <div class="overflow-x-auto">
      <table class="adm-table adm-table--stack">
        <thead>
          <tr>
            <th>Date</th>
            <th>Year</th>
            <th>Title</th>
            <th>Category</th>
            <th>Status</th>
            <th>Featured</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((e) => {
            const upcoming = isUpcoming(e.date);
            return (
              <tr>
                <td data-label="Date" class="whitespace-nowrap font-mono text-xs text-ink-muted">
                  {formatEventDate(e.date, { withDay: true })}
                </td>
                <td data-label="SHPE year" class="whitespace-nowrap font-mono text-xs text-ink-muted">{formatShpeYear(shpeYearOf(e.date))}</td>
                <td data-label="">
                  <a href={`/admin/events/${e.id}`} class="font-semibold text-ink hover:text-accent">{e.title}</a>
                  {e.location && <span class="block text-xs text-ink-muted">{e.location}</span>}
                </td>
                <td data-label="Category" class="whitespace-nowrap text-ink-muted">{e.category}</td>
                <td data-label="Status">
                  {e.published
                    ? <span class:list={["adm-badge", upcoming ? "adm-badge--live" : "adm-badge--muted"]}>{upcoming ? "Upcoming" : "Published"}</span>
                    : <span class="adm-badge adm-badge--draft">Draft</span>}
                </td>
                <td data-label="Featured" class:list={["font-mono text-xs", !e.featured && "max-sm:hidden!"]}>{e.featured ? <span class="text-accent">★ Yes</span> : <span class="text-ink-muted">—</span>}</td>
                <td data-label="" class="adm-cell-actions whitespace-nowrap text-right">
                  <a href={`/admin/events/${e.id}`} class="adm-link">Edit</a>
                  {e.published && (
                    <a href={`/events/${e.slug}`} class="adm-link ml-4" target="_blank" rel="noopener">View ↗</a>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>
