---
/**
 * Hidden admin sign-in (not linked from the public nav). Middleware sends
 * already-signed-in visitors on to /admin/dashboard.
 */
import AuthShell from "@/components/admin/AuthShell.astro";

export const prerender = false;

const ERRORS: Record<string, string> = {
  not_allowed: "That Google account isn't on the admin list. Ask a chapter owner to add your email, then try again.",
  oauth_failed: "Google sign-in didn't complete. Give it another try.",
  cancelled: "Sign-in was cancelled before Google returned an account.",
  not_configured: "Google sign-in isn't configured on this deployment yet (missing OAuth client credentials).",
};

const errorKey = Astro.url.searchParams.get("error");
const errorMessage = errorKey ? (ERRORS[errorKey] ?? ERRORS.oauth_failed) : null;
const signedOut = Astro.url.searchParams.has("signed_out");
---
<AuthShell title="Sign in">
  <div class="grid w-full gap-14 py-16 lg:grid-cols-[1.3fr_1fr] lg:items-end">
    <div>
      <p class="mono-label mb-6 text-cream/60">00 — Admin portal</p>
      <h1 class="display max-w-2xl text-6xl leading-[1.02] text-cream md:text-7xl">
        The chapter's
        <em class="font-serif font-normal lowercase italic tracking-normal text-accent">control room</em>
      </h1>
      <p class="mt-8 max-w-md leading-relaxed text-cream/70">
        Events, the mailing list, and campaigns — edited by the board, published to the site.
        Access is limited to board members on the allowlist.
      </p>
    </div>

    <div class="border-t border-cream/20 pt-8 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
      {errorMessage && (
        <p class="adm-flash adm-flash--error mb-6" role="alert">{errorMessage}</p>
      )}
      {signedOut && !errorMessage && (
        <p class="adm-flash adm-flash--ok mb-6" role="status">You've been signed out.</p>
      )}
      <p class="mono-label mb-4 text-cream/60">Sign in with your board Google account</p>
      <a
        href="/api/auth/google"
        data-google-signin
        class="btn-dossier group inline-flex items-center gap-3 hover:bg-cream hover:text-ink"
      >
        <span class="inline-flex h-6 w-6 items-center justify-center rounded-[2px] bg-surface">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 48 48">
            <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/>
            <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
            <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
            <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/>
          </svg>
        </span>
        Continue with Google
      </a>
      <p class="mt-5 max-w-xs text-sm leading-relaxed text-cream/55">
        Opens a Google window. Not on the list? Ask a chapter owner to add you.
      </p>
    </div>
  </div>
  <Fragment slot="footer">BU SHPE // Admin portal // noindex</Fragment>
</AuthShell>

<script>
  const btn = document.querySelector<HTMLAnchorElement>("[data-google-signin]");

  function finish(data: unknown) {
    if (!data || typeof data !== "object") return;
    const msg = data as { type?: string; ok?: boolean; error?: string };
    if (msg.type !== "shpe-auth") return;
    if (msg.ok) location.assign("/admin/dashboard");
    else location.assign(`/admin?error=${encodeURIComponent(msg.error ?? "oauth_failed")}`);
  }

  // Primary channel: postMessage from the popup (same origin only).
  window.addEventListener("message", (e) => {
    if (e.origin !== location.origin) return;
    finish(e.data);
  });
  // Backup channel: if Google's COOP headers severed window.opener during the
  // popup's trip through accounts.google.com, the callback still broadcasts.
  if ("BroadcastChannel" in window) {
    new BroadcastChannel("shpe-auth").addEventListener("message", (e) => finish(e.data));
  }

  btn?.addEventListener("click", (e) => {
    e.preventDefault();
    const w = 500;
    const h = 620;
    const left = Math.max(0, window.screenX + (window.outerWidth - w) / 2);
    const top = Math.max(0, window.screenY + (window.outerHeight - h) / 2);
    const popup = window.open(
      "/api/auth/google?mode=popup",
      "shpe-google-signin",
      `popup=yes,width=${w},height=${h},left=${Math.round(left)},top=${Math.round(top)}`,
    );
    // Popup blocked → fall back to a full-page redirect.
    if (!popup) {
      location.assign("/api/auth/google");
      return;
    }
    popup.focus();
  });
</script>
