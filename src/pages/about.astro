---
import Base from "@/layouts/Base.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Icon from "@/components/Icon.astro";

import siteData from "@/data/site.json";

// PLACEHOLDER — chapter stats. Update with real numbers when known.
const chapterStats = [
  { value: "50+", label: "Active members" },
  { value: "12",  label: "National conventions attended" },
  { value: "1,000+", label: "Volunteer hours since 2020" },
];

const eventCategories = [
  {
    label: "Professional",
    description: "Resume reviews, company visits, recruiter sessions.",
    photo: "/assets/events/capital-one-workshop.jpg",
    filterCat: "Professional",
  },
  {
    label: "Cultural",
    description: "Cafecitos and conversations on Latin American topics.",
    photo: "/assets/events/navidad-en-familia.jpg",
    filterCat: "Cultural",
  },
  {
    label: "Social",
    description: "Familia-bonding events, game nights, field days.",
    photo: "/assets/events/indoor-field-day.jpg",
    filterCat: "Social",
  },
  {
    label: "Study Nights",
    description: "Peer tutoring across STEM courses.",
    photo: "/assets/events/resume-review-ge.png",
    filterCat: "Study Night",
  },
  {
    label: "Volunteering",
    description: "Service across Greater Boston.",
    photo: "/assets/volunteering/museum-of-science-1.jpeg",
    filterCat: "Volunteering",
  },
];
---

<Base title="About">

  <!-- ① Hero — navy with EST. 1974 watermark -->
  <header class="relative w-full bg-deep py-24 md:py-32 px-6 overflow-hidden">
    <div class="max-w-[1200px] mx-auto relative z-10">
      <span class="eyebrow text-cream/70 mb-4 block">ABOUT</span>
      <h1 class="display text-5xl md:text-6xl lg:text-7xl text-cream max-w-3xl leading-tight">
        A <em class="font-serif italic font-normal lowercase tracking-normal text-accent">familia</em> of engineers.
      </h1>
      <p class="mt-8 text-cream/80 max-w-xl text-lg">
        Since 1974, BU SHPE has built a home in STEM for Hispanic students at Boston University — engineers, designers, scientists, mentors, allies.
      </p>
    </div>

    <!-- Decorative 1974 watermark -->
    <div class="absolute right-0 bottom-0 opacity-10 pointer-events-none select-none hidden md:block">
      <span class="display text-[200px] lg:text-[280px] leading-none text-cream translate-y-1/4 inline-block">1974</span>
    </div>
  </header>

  <!-- ② Mission pull-quote -->
  <section id="mission" class="reveal scroll-mt-24 mx-auto max-w-[1200px] px-6 py-24 md:py-32">
    <div class="max-w-4xl">
      <p class="eyebrow text-ink-muted mb-8">OUR MISSION</p>
      <blockquote class="font-serif italic text-3xl md:text-5xl lg:text-6xl leading-[1.15] text-ink">
        <span class="text-accent text-5xl md:text-7xl leading-none align-top mr-1">&ldquo;</span>We empower the Hispanic community through STEM &mdash; by <em class="not-italic font-sans font-medium text-accent">gathering</em>, <em class="not-italic font-sans font-medium text-accent">mentoring</em>, and showing up for each other and for the next generation of engineers.<span class="text-accent text-5xl md:text-7xl leading-none align-bottom ml-1">&rdquo;</span>
      </blockquote>
      <p class="mt-10 font-cond uppercase tracking-[0.18em] text-sm text-ink-muted">&mdash; BU SHPE Executive Board</p>
    </div>
  </section>

  <!-- ③ Core values pull-quote -->
  <section class="reveal border-t border-rule/20 bg-surface py-24">
    <div class="mx-auto max-w-[1200px] px-6">
      <div class="max-w-3xl mx-auto text-center">
        <p class="pullquote">
          Familia&ensp;<span class="text-rule not-italic font-sans text-2xl leading-none align-middle">·</span>&ensp;Service&ensp;<span class="text-rule not-italic font-sans text-2xl leading-none align-middle">·</span>&ensp;Education&ensp;<span class="text-rule not-italic font-sans text-2xl leading-none align-middle">·</span>&ensp;Resilience
        </p>
      </div>
    </div>
  </section>

  <!-- ④ Chapter by the numbers — stats strip -->
  <section id="history" class="reveal scroll-mt-24 mx-auto max-w-[1200px] px-6 py-24 md:py-32">
    <div class="max-w-3xl mb-16">
      <SectionHeading
        eyebrow="BY THE NUMBERS"
        title="What 50 years of familia adds up to."
      />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-y-12 md:gap-y-0 border-t border-rule/40 pt-12 md:pt-16">
      {chapterStats.map((stat, i) => (
        <div
          class:list={[
            "flex flex-col gap-3",
            i > 0 && "md:border-l md:border-rule/40 md:pl-12",
          ]}
        >
          <span class="display text-6xl md:text-7xl lg:text-8xl leading-none text-accent tabular-nums">
            {stat.value}
          </span>
          <span class="eyebrow text-ink-muted max-w-[14ch]">{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ⑤ What we do — photo cards -->
  <section class="reveal border-t border-rule/20 bg-surface py-24 md:py-32">
    <div class="mx-auto max-w-[1200px] px-6">
      <SectionHeading
        eyebrow="WHAT WE DO"
        title="Five kinds of gatherings."
      />

      <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-5">
        {eventCategories.map((cat) => (
          <a
            href={`/events/all?cat=${encodeURIComponent(cat.filterCat)}`}
            class="group relative block aspect-[3/4] overflow-hidden bg-surface-soft rounded-md"
          >
            <img
              src={cat.photo}
              alt={cat.label}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/30 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-5">
              <span class="block font-cond uppercase tracking-[0.14em] text-xs font-bold text-cream/80 mb-2">
                {cat.label}
              </span>
              <p class="text-sm leading-snug text-cream">{cat.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑥ Constitution + Faculty Advisor -->
  <section class="reveal mx-auto max-w-[1200px] px-6 py-24">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2">

      <!-- Left: Constitution -->
      <div id="constitution" class="scroll-mt-24 flex flex-col gap-4">
        <p class="eyebrow">GOVERNANCE</p>
        <h3 class="display text-4xl md:text-5xl">Read our Constitution</h3>
        <p class="text-sm leading-relaxed text-ink-muted max-w-md">
          Our chapter operates under a written constitution that outlines our structure, values, and operating procedures.
        </p>
        <a
          href={siteData.constitutionUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent underline underline-offset-4 hover:text-accent/80 transition-colors"
        >
          Download the chapter constitution (PDF)
        </a>
      </div>

      <!-- Right: Faculty Advisor -->
      <div id="advisor" class="scroll-mt-24 flex flex-col gap-4">
        <p class="eyebrow">ADVISOR</p>
        <h3 class="display text-4xl md:text-5xl">Faculty Advisor</h3>
        <p class="text-sm leading-relaxed text-ink-muted max-w-md">
          BU SHPE is guided by <strong class="font-medium text-ink">Enrique Gutierrez-Wing, Ph.D.</strong>, who provides academic oversight and institutional support for our chapter. His mentorship bridges the student experience with the broader goals of SHPE's national mission.
        </p>
        <a
          href={`mailto:${siteData.facultyAdvisorEmail}`}
          class="text-accent underline underline-offset-4 hover:text-accent/80 transition-colors"
        >
          {siteData.facultyAdvisorEmail}
        </a>
      </div>

    </div>
  </section>

  <!-- ⑦ Join CTA band -->
  <section class="reveal grain bg-cream text-ink py-24">
    <div class="relative z-10 mx-auto max-w-[1200px] px-6 text-center">
      <h2 class="display text-5xl text-ink md:text-6xl lg:text-7xl">
        Become part of the familia.
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-ink-muted">
        Whether you're a first-year student or a senior with one semester left, there's always a seat at our table.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/join"
          class="group inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 font-sans text-xs font-semibold uppercase tracking-[0.12em] text-white shadow-sm transition hover:-translate-y-px hover:shadow-md"
        >
          Join SHPE
          <Icon name="arrow-forward" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
        </a>
        <a
          href={siteData.donateUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 font-sans text-base font-medium text-ink hover:text-accent transition-colors"
        >
          <span class="border-b border-current pb-0.5">Donate</span>
          <Icon name="arrow-forward" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
        </a>
      </div>
    </div>
  </section>

</Base>
