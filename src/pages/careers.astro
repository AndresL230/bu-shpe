---
/**
 * /careers — "Where we work". Dossier showcase of the companies BU SHPE
 * members and alumni have gone on to, grouped by industry. Content comes
 * from src/data/employers.json (also feeds the home + /join marquees).
 */
import Base from "@/layouts/Base.astro";
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import CtaBand from "@/components/CtaBand.astro";
import employersData from "@/data/employers.json";
import { logoSrc, faviconSrc } from "@/lib/logos";
import type { EmployerGroup } from "@/types";

const groups = employersData as EmployerGroup[];
const companyCount = groups.reduce((n, g) => n + g.companies.length, 0);
---
<Base
  title="Where We Work"
  description="Where BU SHPE members and alumni work — aerospace, technology, energy and biotech companies shaping the future of engineering."
>
  <!-- HERO -->
  <header class="relative w-full overflow-hidden bg-deep blueprint-deep px-6 py-24 md:py-32">
    <div class="relative z-10 mx-auto max-w-[1200px]">
      <p class="mb-5 font-mono text-sm uppercase tracking-[0.18em] text-cream/60">About · Careers</p>
      <h1 class="display max-w-3xl text-5xl leading-[1.02] text-cream md:text-7xl">
        Where SHPE takes <em class="font-serif font-normal lowercase italic tracking-normal text-accent">us</em>.
      </h1>
      <p class="mt-7 max-w-xl text-lg text-cream/80">
        BU SHPE members and alumni have gone on to internships and careers at companies shaping the future of engineering, technology, and science.
      </p>
      <div class="mt-9 flex flex-wrap gap-x-10 gap-y-3 font-mono text-xs uppercase tracking-[0.14em] text-cream/60">
        <span>{companyCount} companies</span>
        <span>{groups.length} industries</span>
        <span>Internships · Co-ops · Full-time</span>
      </div>
    </div>
  </header>

  <!-- INDUSTRY GROUPS -->
  {groups.map((group, gi) => (
    <section class:list={["mx-auto max-w-[1200px] px-6", gi === 0 ? "pt-20 md:pt-28" : "pt-16 md:pt-20", gi === groups.length - 1 && "pb-20 md:pb-28"]}>
      <SectionIndex index={String(gi + 1).padStart(2, "0")} label={group.industry} />
      <div class="mt-8 grid grid-cols-2 border-l border-t border-outline-soft sm:grid-cols-3 lg:grid-cols-4">
        {group.companies.map((company) => (
          <div class="group flex min-h-[9.5rem] sm:min-h-0 sm:aspect-[4/3] flex-col items-center justify-center gap-3 sm:gap-4 border-b border-r border-outline-soft bg-bg p-4 sm:p-6 text-center transition-colors hover:bg-surface-soft">
            <img
              src={logoSrc(company)}
              data-fallback={company.logo ? undefined : faviconSrc(company.domain)}
              alt={company.name}
              loading="lazy"
              referrerpolicy="no-referrer"
              class="careers-logo mix-blend-multiply max-h-14 w-auto max-w-[70%] object-contain transition-transform duration-300 group-hover:scale-105"
            />
            <span class="careers-name font-mono text-[0.68rem] uppercase tracking-[0.08em] text-ink-muted">{company.name}</span>
          </div>
        ))}
      </div>
    </section>
  ))}

  <CtaBand
    eyebrow="YOUR NEXT STEP"
    heading={`Start your path with the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">familia</em>.`}
    body="Resume reviews, career-fair prep, and national conferences. This is how members get from the classroom to the companies above."
    primaryCta={{ label: "Join SHPE", href: "/join" }}
    secondaryCta={{ label: "Career fair prep", href: "/conferences/prep" }}
  />
</Base>

<script>
  // Logo fallback: unavatar → favicon → hide the image (the name label stays).
  document.querySelectorAll<HTMLImageElement>("img.careers-logo").forEach((img) => {
    const fail = () => {
      const fb = img.dataset.fallback;
      if (fb) {
        delete img.dataset.fallback;
        img.src = fb;
      } else {
        img.style.display = "none";
        img.nextElementSibling?.classList.add("display", "text-xl", "text-ink");
      }
    };
    img.addEventListener("error", fail);
    if (img.complete && img.naturalWidth === 0) fail();
  });
</script>
