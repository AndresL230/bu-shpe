---
/**
 * /careers — "Where we work". Dossier showcase of the companies BU SHPE
 * members and alumni have gone on to, grouped by industry. Content comes
 * from src/data/employers.json (also feeds the home + /join marquees).
 */
import Base from "@/layouts/Base.astro";
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import CtaBand from "@/components/CtaBand.astro";
import employersData from "@/data/employers.json";
import EmployerCell from "@/components/EmployerCell.astro";
import type { EmployerGroup } from "@/types";

const groups = employersData as EmployerGroup[];
const companyCount = groups.reduce((n, g) => n + g.companies.length, 0);
---
<Base
  title="Where We Work"
  description="Where BU SHPE members and alumni work — aerospace, technology, energy and biotech companies shaping the future of engineering."
>
  <!-- HERO -->
  <header class="relative w-full overflow-hidden bg-deep blueprint-deep px-6 py-16 md:py-32">
    <div class="relative z-10 mx-auto max-w-[1200px]">
      <p class="mb-5 font-mono text-xs uppercase tracking-[0.14em] text-cream/60 md:text-sm md:tracking-[0.18em]">About · Careers</p>
      <h1 class="display max-w-3xl text-5xl leading-[1.02] text-cream md:text-7xl max-md:text-balance">
        Where SHPE takes <em class="font-serif font-normal lowercase italic tracking-normal text-accent">us</em>.
      </h1>
      <p class="mt-7 max-w-xl text-lg text-cream/80">
        BU SHPE members and alumni have gone on to internships and careers at companies shaping the future of engineering, technology, and science.
      </p>
      <!-- Phones: two-column fact grid (long facts take a full row); md+: one wrapping line. -->
      <div class="mt-8 md:mt-9 grid grid-cols-2 gap-x-6 gap-y-2.5 md:flex md:flex-wrap md:gap-x-10 md:gap-y-3 font-mono text-xs uppercase tracking-[0.14em] text-cream/60">
        <span>{companyCount} companies</span>
        <span>{groups.length} industries</span>
        <span class="max-md:col-span-2">Internships · Co-ops · Full-time</span>
      </div>
    </div>
  </header>

  <!-- INDUSTRY GROUPS -->
  {groups.map((group, gi) => (
    <section class:list={["mx-auto max-w-[1200px] px-6", gi === 0 ? "pt-16 md:pt-28" : "pt-12 md:pt-20", gi === groups.length - 1 && "pb-16 md:pb-28"]}>
      <SectionIndex index={String(gi + 1).padStart(2, "0")} label={group.industry} />
      <div class="mt-6 md:mt-8 grid grid-cols-2 border-l border-t border-outline-soft sm:grid-cols-3 lg:grid-cols-4">
        {group.companies.map((company) => <EmployerCell company={company} variant="careers" />)}
      </div>
    </section>
  ))}

  <CtaBand
    eyebrow="YOUR NEXT STEP"
    heading={`Start your path with the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">familia</em>.`}
    body="Resume reviews, career-fair prep, and national conferences. This is how members get from the classroom to the companies above."
    primaryCta={{ label: "Join SHPE", href: "/join" }}
    secondaryCta={{ label: "Career fair prep", href: "/conferences/prep" }}
  />
</Base>

