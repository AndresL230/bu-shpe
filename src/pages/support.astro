---
import Base from "@/layouts/Base.astro";
import SupportHero from "@/components/SupportHero.astro";
import EmployersSection from "@/components/EmployersSection.astro";
import CtaBand from "@/components/CtaBand.astro";
import siteData from "@/data/site.json";
---

<Base
  title="Support"
  description="The companies, alumni, faculty, and friends who invest in Hispanic engineers at Boston University — and where SHPE takes its members."
>
  <SupportHero />
  <EmployersSection />

  <CtaBand
    eyebrow="GET IN TOUCH"
    heading="Be part of the <em class='font-serif italic font-normal lowercase tracking-normal text-accent'>familia</em>."
    body="Sponsors, alumni, faculty, friends — every kind of support moves this chapter forward. Tell us how you'd like to show up."
    primaryCta={{ label: "Email the chapter", href: `mailto:${siteData.contactEmail}` }}
    secondaryCta={{ label: "Follow on Instagram", href: siteData.socials.instagram }}
  />
</Base>
