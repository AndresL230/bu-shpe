---
import Base from "@/layouts/Base.astro";
import CtaBand from "@/components/CtaBand.astro";
import Reveal from "@/components/Reveal.astro";
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import ConventionBadge from "@/components/conferences/ConventionBadge.astro";
import Countdown from "@/components/conferences/Countdown.astro";
import KeyDatesTimeline from "@/components/conferences/KeyDatesTimeline.astro";
import TripManifest from "@/components/conferences/TripManifest.astro";
import StatCountUp from "@/components/conferences/StatCountUp.astro";
import Icon from "@/components/Icon.astro";

import siteData from "@/data/site.json";
import conventionData from "@/data/conventions.json";
import type { Convention } from "@/types";
import { formatDateRange } from "@/lib/conferences";

const c = conventionData as Convention;
const dateRange = formatDateRange(c.startDate, c.endDate);
// Same rule as KeyDatesTimeline: every key date over → show one "Completed"
// tag on the section header (Countdown's script refreshes it in the browser).
const tz = c.countdownTarget.match(/(Z|[+-]\d{2}:\d{2})$/)?.[1] ?? "Z";
const keyDatesComplete = c.keyDates.every((kd) => Date.now() > new Date(`${kd.date}T23:59:59${tz}`).getTime());
---
<Base title="Conferences" description="BU SHPE sends a delegation to the SHPE National Convention each year. Indianapolis, Oct 28–31 2026.">

  <!-- HERO -->
  <header class="relative w-full bg-deep blueprint-deep py-16 md:py-28 px-6 overflow-hidden">
    <div class="max-w-[1152px] mx-auto relative z-10 grid grid-cols-1 md:grid-cols-12 gap-10 items-end">
      <div class="md:col-span-8">
        <p class="font-mono text-cream/60 text-xs tracking-[0.14em] md:text-sm md:tracking-[0.18em] uppercase mb-5">{c.name}<span class="hidden md:inline">&nbsp;·</span> <span class="block md:inline">{c.city}</span></p>
        <h1 class="display text-5xl md:text-7xl text-cream leading-[1.02] max-w-3xl">
          STEM for the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">bold</em>.
        </h1>
        <p class="mt-7 text-cream/80 max-w-xl text-lg">
          The largest gathering of Hispanic STEM students and professionals in the country. BU SHPE travels as a delegation — career fair, competitions, and familia. {dateRange}, {c.venue}.
        </p>
        <div class="mt-8"><ConventionBadge /></div>
      </div>
      <div class="md:col-span-4 flex md:justify-end">
        <Countdown />
      </div>
    </div>
  </header>

  <!-- 01 — SCALE (count-up stats) -->
  <section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28">
    <SectionIndex index="01" label="The Convention" />
    <div class="mt-10 grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3 sm:gap-10">
      {c.scaleStats.map((s, i) => <div class:list={[i === 0 && "col-span-2 sm:col-span-1"]}><StatCountUp value={s.value} label={s.label} accent={i === 0} /></div>)}
    </div>
    <p class="mt-8 max-w-3xl text-ink-muted">
      {/* SOURCE: 2025 Philadelphia figures (12,000 attendees / 150+ companies), Newswire 2025-09. */}
      A four-day national convention spanning a STEM career fair, technical competitions, leadership workshops, and a graduate-school and professional track.
    </p>
  </section>

  <div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

  <!-- 02 — KEY DATES -->
  <section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-12">
    <div class="md:col-span-5">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <SectionIndex index="02" label="Key Dates" />
        <span data-keydates-tag hidden={!keyDatesComplete} class="font-mono text-[0.68rem] leading-none uppercase tracking-[0.14em] text-ink border border-ink/25 px-2 py-1 -my-1">Completed</span>
      </div>
      <p class="mt-5 text-ink-muted max-w-sm">The road to Indianapolis. Registration deadlines follow SHPE's standard tiers — watch the mailing list for the chapter's locked travel calendar.</p>
    </div>
    <div class="md:col-span-7 md:col-start-6">
      <Reveal><KeyDatesTimeline /></Reveal>
    </div>
  </section>

  <div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

  <!-- 03 — TRAVEL (trip manifest) -->
  <section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-12">
    <div class="md:col-span-5">
      <SectionIndex index="03" label="Travel" />
      <h2 class="display text-3xl md:text-4xl text-ink mt-5 text-balance md:text-wrap">Coordinated, subsidized, group travel.</h2>
      <p class="mt-4 text-ink-muted max-w-md">We fly as a delegation. BU SHPE coordinates flights, a hotel block at the convention center, and ground transport for registered members.</p>
    </div>
    <div class="md:col-span-7"><Reveal><TripManifest /></Reveal></div>
  </section>

  <div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

  <!-- 04 — COST & FUNDING -->
  <section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28">
    <SectionIndex index="04" label="Cost & Funding" />
    <!-- Phones: boxed stack. md+: open hairline rows, label col + detail col. -->
    <div class="mt-10 grid grid-cols-1 gap-px bg-outline-soft border border-outline-soft md:gap-0 md:bg-transparent md:border-x-0 md:border-b-0">
      {c.costFunding.map((cf) => (
        <div class="bg-bg p-5 md:px-0 md:py-8 md:grid md:grid-cols-12 md:gap-12 md:border-b md:border-outline-soft md:last:border-b-0">
          <p class="font-mono text-sm text-accent tracking-wide uppercase mb-3 md:mb-0 md:col-span-5 md:pt-0.5">{cf.heading}</p>
          <p class="text-ink md:col-span-7 md:max-w-2xl">{cf.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

  <!-- 05 — ELIGIBILITY + FAQ -->
  <section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-16 md:gap-12">
    <div class="md:col-span-5">
      <SectionIndex index="05" label="Eligibility" />
      <ul class="mt-6 space-y-3">
        {c.eligibility.map((e) => (
          <li class="flex gap-3 text-ink">
            <span class="font-mono text-accent" aria-hidden="true">›</span><span>{e}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="md:col-span-7 border-t border-outline-soft pt-16 md:border-t-0 md:pt-0">
      <SectionIndex index="06" label="FAQ" />
      <div class="mt-6 divide-y divide-outline-soft border-t border-outline-soft">
        {c.faq.map((f) => (
          <details class="group md:py-4">
            <summary class="display text-xl text-ink cursor-pointer list-none py-4 md:py-0 flex justify-between items-center gap-4 md:gap-0 text-balance md:text-wrap [&::-webkit-details-marker]:hidden">
              {f.q}<span class="shrink-0 md:shrink font-mono text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="-mt-1 pb-4 md:mt-3 md:pb-0 text-ink-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- SPOKES NAV -->
  <section class="max-w-[1200px] mx-auto px-6 pb-16 md:pb-28">
    <!-- Phones: boxed pair. md+: open, hairline-ruled band. -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-px bg-outline-soft border border-outline-soft md:gap-12 md:bg-transparent md:border-x-0">
      {[
        { href: "/conferences/prep", idx: "→", label: "Career fair prep", desc: "Bootcamp, recruiters, what to bring." },
        { href: "/conferences/record", idx: "→", label: "The record", desc: "Year-by-year delegations + competition tracks." },
      ].map((s, i) => (
        <a href={s.href} class:list={["bg-bg p-5 md:px-0 md:py-8 group hover:bg-surface-soft md:hover:bg-transparent transition-colors", i === 0 ? "md:col-span-5" : "md:col-span-7"]}>
          <p class="display text-2xl text-ink group-hover:text-accent transition-colors md:inline-flex md:items-center md:gap-3">{s.label} <span aria-hidden="true" class="md:hidden">→</span><Icon name="arrow-forward" class="hidden md:block w-5 h-5 transition-transform group-hover:translate-x-1" /></p>
          <p class="mt-2 text-ink-muted text-sm text-balance md:text-wrap">{s.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <CtaBand
    heading="Ready to represent BU?"
    body="Join our delegation and take the next step. Interest forms open ahead of the national convention."
    primaryCta={{ label: "Register interest", href: "/join" }}
    secondaryCta={{ label: "Email leadership", href: `mailto:${siteData.contactEmail}` }}
  />

</Base>
