---
import Base from "@/layouts/Base.astro";
import CorporateSection from "@/components/CorporateSection.astro";
import ContactModal from "@/components/ContactModal.astro";
import Icon from "@/components/Icon.astro";
import siteData from "@/data/site.json";

// Shared input styling (matches MailingListForm.astro).
const fieldClass =
  "w-full rounded-lg border border-rule/40 bg-white px-4 py-3 text-ink placeholder:text-ink-muted/60 focus:border-accent focus:outline-none";
const labelClass = "flex flex-col gap-1.5 text-sm font-medium text-ink";

---

<Base
  title="Corporate Partners"
  description="Partner with BU SHPE to reach Hispanic engineers, scientists, and technologists at one of the nation's top engineering schools."
>
  <header class="grain relative isolate overflow-hidden bg-deep px-6 py-20 md:py-28">
    <div class="mx-auto max-w-[1200px]">
      <span class="mb-5 block h-[3px] w-12 bg-accent"></span>
      <p class="eyebrow text-cream/70">CORPORATE PARTNERSHIP</p>
      <h1 class="display mt-6 text-5xl leading-tight text-cream md:text-6xl lg:text-7xl">
        <em class="font-serif italic font-normal lowercase tracking-normal text-accent">Partner</em> with BU SHPE.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-cream/80">
        Connect your team to Hispanic engineers, scientists, and technologists at one of the nation's top engineering schools, before they reach the job market.
      </p>

      <!-- CTAs inline, flowing from the subtitle -->
      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a href={siteData.sponsorshipPacketUrl} target="_blank" rel="noopener" class="group inline-flex items-center justify-center gap-2 rounded-full bg-accent px-7 py-3.5 font-sans text-xs font-semibold uppercase tracking-[0.12em] text-white shadow-sm transition hover:-translate-y-px hover:shadow-md">
          Download the Sponsorship Packet
          <Icon name="arrow-forward" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
        </a>
        <button type="button" data-open-modal="corporate" class="group inline-flex items-center justify-center gap-2 rounded-full border border-cream/30 px-7 py-3.5 font-sans text-xs font-semibold uppercase tracking-[0.12em] text-cream transition hover:-translate-y-px hover:border-cream hover:bg-cream hover:text-ink">
          Become a Partner
          <Icon name="person-add" class="h-4 w-4" />
        </button>
      </div>

      <p class="mt-5 text-sm text-cream/50">
        Prefer email? <a href={`mailto:${siteData.contactEmail}?subject=Sponsorship%20Inquiry`} class="text-cream/80 underline underline-offset-2 hover:text-cream">{siteData.contactEmail}</a>
      </p>
    </div>
  </header>

  <CorporateSection />

  <!-- Corporate contact modal (opened by [data-open-modal="corporate"]) -->
  <ContactModal id="corporate" title="Become a Partner">
    <label class={labelClass}>
      <span>Company name</span>
      <input type="text" name="Company Name" required class={fieldClass} placeholder="Acme Engineering" />
    </label>
    <label class={labelClass}>
      <span>Contact name</span>
      <input type="text" name="Contact Name" required class={fieldClass} placeholder="Jordan Rivera" />
    </label>
    <label class={labelClass}>
      <span>Email</span>
      <input type="email" name="Email" required class={fieldClass} placeholder="you@company.com" />
    </label>
    <label class={labelClass}>
      <span>Your role</span>
      <select name="Role" class={fieldClass}>
        <option value="Recruiter">Recruiter</option>
        <option value="Engineering Manager">Engineering Manager</option>
        <option value="Diversity & Inclusion Lead">Diversity &amp; Inclusion Lead</option>
        <option value="Other">Other</option>
      </select>
    </label>
    <fieldset class="flex flex-col gap-2.5">
      <legend class="mb-1 text-sm font-medium text-ink">I'm interested in</legend>
      {[
        "Sponsorship Tier Info",
        "Host a Workshop",
        "Attend an Event",
        "Convention Recruiting",
        "General Inquiry",
      ].map((opt) => (
        <label class="flex items-center gap-2.5 text-sm font-normal text-ink-muted">
          <input type="checkbox" name="Interest" value={opt} class="h-4 w-4 accent-accent" />
          {opt}
        </label>
      ))}
    </fieldset>
    <label class={labelClass}>
      <span>Message <span class="font-normal text-ink-muted">(optional)</span></span>
      <textarea name="Message" rows="3" class={fieldClass} placeholder="Tell us what you're hoping to do with BU SHPE."></textarea>
    </label>
  </ContactModal>

  <!-- Trigger: [data-open-modal="x"] opens #modal-x -->
  <script is:inline>
    document.querySelectorAll("[data-open-modal]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-open-modal");
        const dlg = document.getElementById("modal-" + id);
        if (dlg && typeof dlg.showModal === "function") dlg.showModal();
      });
    });
  </script>
</Base>
