---
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeading from "@/components/SectionHeading.astro";

import volunteeringData from "@/data/volunteering.json";
import siteData from "@/data/site.json";
---

<Base title="Volunteering" description="BU SHPE shows up for Greater Boston — at museums, food banks, and on the street with meals.">

  <!-- ① Tall Hero -->
  <PageHero
    eyebrow="VOLUNTEERING"
    headline="Service is part of the SHPE familia."
    headlineAccent="Service"
    subtitle="We show up for Greater Boston — at museums, food banks, and on the street with meals."
    size="tall"
    meta="VOLUNTEERING / GREATER BOSTON"
  />

  <!-- ② Intro pull-quote -->
  <section class="mx-auto max-w-3xl px-6 py-24 text-center reveal">
    <p class="pullquote">
      "Pay it forward. Build community. Show up for Greater Boston."
    </p>
  </section>

  <!-- ③ Program list -->
  <section class="mx-auto max-w-[1200px] px-6 py-12 reveal">
    {volunteeringData.map((program, index) => (
      <article class="grid grid-cols-1 md:grid-cols-12 gap-10 items-center py-20 border-t border-rule/20 first:border-t-0">

        {/* Image side — md:col-span-7, alternates left/right */}
        <div
          class:list={[
            "md:col-span-7",
            index % 2 === 0 ? "md:order-1" : "md:order-2",
          ]}
        >
          {program.photos.length >= 2 ? (
            /* Two photos: stacked on mobile, overlapping on md+ */
            <div class="relative pb-8 md:pb-10">
              <div class="rounded-lg overflow-hidden shadow-[var(--shadow-card)] photo-warm">
                <img
                  src={program.photos[0]}
                  alt={`${program.name} — photo 1`}
                  class="w-full h-full object-cover aspect-[4/3]"
                  loading="lazy"
                />
              </div>
              <div class="md:absolute md:bottom-[-2rem] md:right-[-1rem] mt-3 md:mt-0 w-1/2 rounded-lg overflow-hidden shadow-[var(--shadow-card)] photo-warm border-4 border-bg">
                <img
                  src={program.photos[1]}
                  alt={`${program.name} — photo 2`}
                  class="w-full h-full object-cover aspect-[4/3]"
                  loading="lazy"
                />
              </div>
            </div>
          ) : program.photos.length === 1 ? (
            /* Single photo */
            <div class="rounded-lg overflow-hidden shadow-[var(--shadow-card)] photo-warm">
              <img
                src={program.photos[0]}
                alt={`${program.name}`}
                class="w-full h-full object-cover aspect-[4/3]"
                loading="lazy"
              />
            </div>
          ) : (
            /* No photos — editorial deep-navy card */
            <div class="aspect-[4/3] rounded-lg overflow-hidden">
              <div class="grain bg-deep text-cream rounded-lg p-12 h-full flex flex-col justify-center">
                <p class="pullquote text-cream text-left leading-snug">
                  "{program.description.split(".")[0]}."
                </p>
              </div>
            </div>
          )}
        </div>

        {/* Text side — md:col-span-5, opposite order */}
        <div
          class:list={[
            "md:col-span-5 flex flex-col gap-5",
            index % 2 === 0 ? "md:order-2" : "md:order-1",
            /* Extra bottom padding on programs with the overlapping photo so text isn't clipped */
            program.photos.length >= 2 ? "pb-10 md:pb-0" : "",
          ]}
        >
          <p class="eyebrow">VOLUNTEERING</p>
          <h2 class="display text-3xl md:text-4xl">{program.name}</h2>
          <p class="text-sm leading-relaxed text-ink-muted">{program.description}</p>
        </div>

      </article>
    ))}
  </section>

  <!-- ④ Get involved CTA -->
  <section class="mx-auto max-w-3xl px-6 py-24 text-center reveal">
    <div class="flex justify-center">
      <SectionHeading
        align="center"
        eyebrow="GET INVOLVED"
        title="Have a partner in mind?"
      />
    </div>
    <p class="mt-8 text-lg leading-relaxed text-ink-muted">
      Tell us where you'd like to serve next.
    </p>
    <div class="mt-10">
      <a
        href={`mailto:${siteData.contactEmail}?subject=Volunteer%20Idea`}
        class="inline-flex items-center rounded-full bg-accent text-white px-6 py-3 font-sans text-sm font-medium transition hover:-translate-y-0.5 hover:shadow-lg"
      >
        Send us your idea →
      </a>
    </div>
  </section>

</Base>
