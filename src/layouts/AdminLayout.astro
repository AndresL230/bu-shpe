---
/**
 * Shell for every signed-in /admin/* page.
 * Navy masthead (DKBG logo is legal here) + mono section index on the left +
 * paper-white work area. Pages pass `section` to highlight the index entry and
 * `title` / `eyebrow` for the page header. Middleware guarantees Astro.locals.admin.
 */
import "@/styles/global.css";
import "@/styles/admin.css";

interface Props {
  title: string;
  eyebrow?: string;
  section: "dashboard" | "events" | "subscribers" | "campaigns" | "admins";
  /** Optional accent word rendered in Playfair italic after the title. */
  accent?: string;
}

const { title, eyebrow, section, accent } = Astro.props;
const admin = Astro.locals.admin;

const nav: { key: Props["section"]; href: string; label: string; index: string; ownerOnly?: boolean }[] = [
  { key: "dashboard",   href: "/admin/dashboard",   label: "Overview",     index: "00" },
  { key: "events",      href: "/admin/events",      label: "Events",       index: "01" },
  { key: "subscribers", href: "/admin/subscribers", label: "Mailing list", index: "02" },
  { key: "campaigns",   href: "/admin/campaigns",   label: "Campaigns",    index: "03" },
  { key: "admins",      href: "/admin/admins",      label: "Admins",       index: "04", ownerOnly: true },
];
const visibleNav = nav.filter((n) => !n.ownerOnly || admin?.role === "owner");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — BU SHPE Admin</title>
    <slot name="head" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&family=Playfair+Display:ital,wght@1,400;1,500&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body class="min-h-dvh bg-bg text-ink antialiased">
    <!-- Masthead -->
    <header class="bg-deep text-cream">
      <div class="mx-auto flex max-w-[1400px] items-center justify-between gap-4 px-4 py-3 sm:gap-6 sm:px-6 sm:py-4">
        <a href="/admin/dashboard" class="flex shrink-0 items-center gap-5">
          <img
            src="/assets/logos/SHPE_logo_horiz_Boston-University_DKBG.png"
            alt="SHPE Boston University"
            class="h-8 w-auto sm:h-9"
          />
          <span class="hidden border-l border-cream/25 pl-5 mono-label text-cream/80 sm:inline">
            Admin // Control room
          </span>
        </a>
        <div class="flex items-center gap-3 sm:gap-4">
          <a href="/" class="mono-label whitespace-nowrap py-2 text-cream/70 hover:text-accent" target="_blank" rel="noopener">
            <span class="hidden sm:inline">View site</span><span class="sm:hidden">Site</span> ↗
          </a>
          {admin && (
            <div class="flex items-center gap-3 border-l border-cream/25 pl-3 sm:pl-4">
              {admin.picture && (
                <img src={admin.picture} alt="" class="h-7 w-7 rounded-full" referrerpolicy="no-referrer" />
              )}
              <span class="hidden text-sm text-cream/90 md:inline">{admin.name ?? admin.email}</span>
              <form method="post" action="/api/auth/logout">
                <button type="submit" class="mono-label whitespace-nowrap py-2 text-cream/70 hover:text-accent">Sign out</button>
              </form>
            </div>
          )}
        </div>
      </div>
    </header>

    <div class="mx-auto grid max-w-[1400px] grid-cols-[minmax(0,1fr)] gap-6 px-4 py-6 sm:px-6 lg:grid-cols-[200px_minmax(0,1fr)] lg:gap-10 lg:py-10">
      <!-- Section index: a swipeable tab row on phones, a sticky rail on desktop -->
      <nav aria-label="Admin sections" class="min-w-0 lg:sticky lg:top-10 lg:self-start">
        <p class="mono-label mb-4 hidden lg:block">Index</p>
        <ul class="adm-tabs -mx-4 flex gap-1 overflow-x-auto border-b border-hairline px-4 sm:-mx-6 sm:px-6 lg:mx-0 lg:block lg:overflow-visible lg:border-b-0 lg:border-l lg:px-0">
          {visibleNav.map((n) => {
            const active = n.key === section;
            return (
              <li>
                <a
                  href={n.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "-mb-px flex items-baseline gap-2 whitespace-nowrap border-b-2 px-3 py-3 text-sm transition-colors lg:mb-0 lg:-ml-px lg:gap-3 lg:border-b-0 lg:border-l-2 lg:py-2",
                    active
                      ? "border-accent font-semibold text-ink"
                      : "border-transparent text-ink-muted hover:text-ink hover:lg:border-rule",
                  ]}
                >
                  <span class="font-mono text-[0.68rem] text-ink-muted">{n.index}</span>
                  {n.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <!-- Work area -->
      <main id="main" class="min-w-0">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4 border-b border-ink pb-5 lg:mb-10 lg:gap-6 lg:pb-6">
          <div class="min-w-0">
            {eyebrow && <p class="mono-label mb-2">{eyebrow}</p>}
            <h1 class="display break-words text-3xl text-ink sm:text-4xl md:text-5xl">
              {title}
              {accent && (
                <em class="font-serif font-normal lowercase italic tracking-normal text-accent"> {accent}</em>
              )}
            </h1>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <slot name="actions" />
          </div>
        </div>
        <slot />
      </main>
    </div>
  </body>
</html>
