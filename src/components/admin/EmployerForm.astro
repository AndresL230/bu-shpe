---
/**
 * Create/edit form for one employer ("Where SHPE takes us"). Plain multipart
 * POST; the API route validates and redirects back with ?ok= / ?error=.
 */
import type { EmployerRecord } from "@/lib/server/content";

interface Props {
  action: string;
  employer?: EmployerRecord;
  /** Existing industries, offered as suggestions. */
  industries: string[];
  submitLabel: string;
  /** Compact layout for the sidebar "add" panel. */
  compact?: boolean;
}

const { action, employer, industries, submitLabel, compact = false } = Astro.props;
const uid = employer ? `e${employer.id}` : "new";
const accept = "image/jpeg,image/png,image/webp,image/avif";
const domainHint = "Without a logo, the site fetches one using this domain.";
---
<form method="post" action={action} enctype="multipart/form-data" class:list={["grid gap-5", !compact && "lg:grid-cols-[1fr_280px] lg:gap-8"]}>
  <input type="hidden" name="action" value={employer ? "update" : "add"} />
  <div class:list={["grid content-start gap-5", !compact && "adm-panel lg:self-start"]}>
    {compact && <p class="mono-label">Add a company</p>}
    <div>
      <label class="adm-label" for={`${uid}-industry`}>Industry</label>
      <input id={`${uid}-industry`} name="industry" class="adm-input" required maxlength="80" value={employer?.industry ?? ""} list={`${uid}-industries`} placeholder="Pick or type a new one" autocomplete="off" />
      <datalist id={`${uid}-industries`}>{industries.map((i) => <option value={i} />)}</datalist>
      {!compact && <p class="adm-hint">Moving a company to another industry puts it at the end of that list.</p>}
    </div>
    <div class:list={["grid gap-5", !compact && "md:grid-cols-2"]}>
      <div>
        <label class="adm-label" for={`${uid}-name`}>Company</label>
        <input id={`${uid}-name`} name="name" class="adm-input" required maxlength="120" value={employer?.name ?? ""} autocomplete="off" />
      </div>
      <div>
        <label class="adm-label" for={`${uid}-domain`}>Domain</label>
        <input id={`${uid}-domain`} name="domain" class="adm-input font-mono" maxlength="200" value={employer?.domain ?? ""} placeholder="example.com" autocomplete="off" inputmode="url" />
        <p class="adm-hint">{domainHint}</p>
      </div>
    </div>

    {compact && (
      <>
        <div>
          <label class="adm-label" for={`${uid}-logo-file`}>Logo</label>
          <input id={`${uid}-logo-file`} type="file" name="logo_file" accept={accept} class="adm-file" />
        </div>
        <div>
          <label class="adm-label" for={`${uid}-logo-path`}>Or existing path</label>
          <input id={`${uid}-logo-path`} name="logo_path" class="adm-input font-mono text-xs" placeholder="/assets/employers/…" autocomplete="off" />
          <p class="adm-hint">Optional. Leave both empty to use the domain.</p>
        </div>
        <button type="submit" class="btn-dossier">{submitLabel}</button>
      </>
    )}
  </div>

  {!compact && (
    <div class="grid content-start gap-6">
      <div class="adm-panel grid gap-4">
        <p class="adm-label mb-0">Logo</p>
        <figure class="flex aspect-[3/2] w-full items-center justify-center border border-hairline bg-surface p-5">
          <img src={employer?.logo || undefined} alt="" class:list={["max-h-full max-w-full object-contain", !employer?.logo && "hidden"]} data-logo-preview />
          <span class:list={["mono-label text-center", employer?.logo && "hidden"]} data-logo-empty>
            {employer?.domain ? <>From domain<span class="mt-1 block normal-case tracking-normal">{employer.domain}</span></> : "No logo"}
          </span>
        </figure>
        <div>
          <label class="adm-label" for={`${uid}-logo-file`}>Upload new</label>
          <input id={`${uid}-logo-file`} type="file" name="logo_file" accept={accept} class="adm-file" data-logo-input />
          <p class="adm-hint">PNG, JPEG, WebP or AVIF, up to 8 MB. Transparent or white backgrounds look best.</p>
        </div>
        <div>
          <label class="adm-label" for={`${uid}-logo-path`}>Or keep / use path</label>
          <input id={`${uid}-logo-path`} name="logo_path" class="adm-input font-mono text-xs" value={employer?.logo ?? ""} placeholder="/assets/employers/…" autocomplete="off" />
          <p class="adm-hint">An upload replaces this. Empty = fetched by domain.</p>
        </div>
      </div>
      <div class="adm-panel grid gap-4">
        <button type="submit" class="btn-dossier w-full">{submitLabel}</button>
        {employer?.logo && <button type="submit" form={`${uid}-rmlogo`} class="adm-link adm-link--danger justify-self-start">Remove logo</button>}
      </div>
    </div>
  )}
</form>
{employer?.logo && (
  <form id={`${uid}-rmlogo`} method="post" action={action} class="hidden"><input type="hidden" name="action" value="remove_logo" /></form>
)}

<script>
  const input = document.querySelector<HTMLInputElement>("[data-logo-input]");
  const preview = document.querySelector<HTMLImageElement>("[data-logo-preview]");
  const empty = document.querySelector<HTMLElement>("[data-logo-empty]");
  let objectUrl: string | null = null;
  input?.addEventListener("change", () => {
    const file = input.files?.[0];
    if (!file || !preview) return;
    if (objectUrl) URL.revokeObjectURL(objectUrl);
    objectUrl = URL.createObjectURL(file);
    preview.src = objectUrl;
    preview.classList.remove("hidden");
    empty?.classList.add("hidden");
  });
</script>
