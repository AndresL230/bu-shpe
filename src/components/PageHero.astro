---
interface CTA {
  href: string;
  label: string;
  variant?: "primary" | "outline";
}

interface Props {
  eyebrow: string;
  headline: string;
  /** Substring within headline to render as italic+accent. Optional. */
  headlineAccent?: string;
  subtitle?: string;
  ctas?: CTA[];
  /** Bottom-row eyebrow text (left side). */
  meta?: string;
  /** Bottom-row right-side text (uppercase tracked). */
  metaRight?: string;
  /** Hero scale. tall = ~72dvh, compact = ~52dvh. */
  size?: "compact" | "tall";
}

const {
  eyebrow,
  headline,
  headlineAccent,
  subtitle,
  ctas = [],
  meta,
  metaRight,
  size = "tall",
} = Astro.props;

const sizeClass = size === "tall" ? "min-h-[72dvh]" : "min-h-[52dvh]";

const parts = headlineAccent && headline.includes(headlineAccent)
  ? (() => {
      const idx = headline.indexOf(headlineAccent);
      return {
        before: headline.slice(0, idx),
        accent: headlineAccent,
        after: headline.slice(idx + headlineAccent.length),
      };
    })()
  : null;
---
<section class:list={["grain relative isolate bg-cream", sizeClass]}>
  <div class="mx-auto flex h-full max-w-[1200px] flex-col justify-between px-6 pb-12 pt-16 md:pb-16 md:pt-24">

    <header class="flex flex-col gap-4">
      <span class="block h-[3px] w-12 bg-accent"></span>
      <p class="eyebrow text-ink-muted">{eyebrow}</p>
    </header>

    <div class="mt-12 max-w-4xl">
      <h1 class="display text-ink text-[clamp(2.5rem,7vw,6rem)]">
        {parts
          ? <Fragment>{parts.before}<em class="italic text-accent">{parts.accent}</em>{parts.after}</Fragment>
          : headline
        }
      </h1>
      {subtitle && (
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-ink-muted md:text-xl">
          {subtitle}
        </p>
      )}
      {ctas.length > 0 && (
        <div class="mt-10 flex flex-wrap items-center gap-4">
          {ctas.map(cta => (
            <a
              href={cta.href}
              class:list={[
                "inline-flex items-center rounded-full px-8 py-3.5 text-sm font-medium transition",
                cta.variant === "outline"
                  ? "border border-ink/30 text-ink hover:border-ink hover:bg-ink hover:text-cream"
                  : "bg-accent text-white hover:-translate-y-0.5 hover:shadow-lg",
              ]}
            >{cta.label}</a>
          ))}
        </div>
      )}
    </div>

    {(meta || metaRight) && (
      <footer class="mt-16 flex flex-col items-start justify-between gap-3 border-t border-ink/15 pt-6 text-xs text-ink-muted md:flex-row md:items-center">
        {meta && <p class="eyebrow text-ink-muted/80">{meta}</p>}
        {metaRight && (
          <p class="font-cond uppercase tracking-[0.18em] text-ink-muted/70">
            {metaRight}
          </p>
        )}
      </footer>
    )}
  </div>
</section>
