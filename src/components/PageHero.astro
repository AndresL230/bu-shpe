---
interface CTA {
  href: string;
  label: string;
  variant?: "primary" | "outline";
}

interface Props {
  eyebrow: string;
  headline: string;
  /** Substring within headline to render as italic+accent. Optional. */
  headlineAccent?: string;
  subtitle?: string;
  ctas?: CTA[];
  /** Bottom-row eyebrow text (left side). */
  meta?: string;
  /** Bottom-row right-side text (uppercase tracked). */
  metaRight?: string;
}

const {
  eyebrow,
  headline,
  headlineAccent,
  subtitle,
  ctas = [],
  meta,
  metaRight,
} = Astro.props;

const parts = headlineAccent && headline.includes(headlineAccent)
  ? (() => {
      const idx = headline.indexOf(headlineAccent);
      return {
        before: headline.slice(0, idx),
        accent: headlineAccent,
        after: headline.slice(idx + headlineAccent.length),
      };
    })()
  : null;
---
<section class="grain relative isolate bg-deep py-24 md:py-32 px-6">
  <div class="mx-auto max-w-[1200px]">

    <header class="flex flex-col gap-4">
      <span class="block h-[3px] w-12 bg-accent"></span>
      <p class="eyebrow text-cream/70">{eyebrow}</p>
    </header>

    <div class="mt-8 max-w-3xl">
      <h1 class="display text-cream text-5xl md:text-6xl lg:text-7xl leading-tight">
        {parts
          ? <Fragment>{parts.before}<em class="font-serif italic font-normal lowercase tracking-normal text-accent">{parts.accent}</em>{parts.after}</Fragment>
          : headline
        }
      </h1>
      {subtitle && (
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-cream/80">
          {subtitle}
        </p>
      )}
      {ctas.length > 0 && (
        <div class="mt-10 flex flex-wrap items-center gap-4">
          {ctas.map(cta => (
            <a
              href={cta.href}
              class:list={[
                "inline-flex items-center rounded-full px-8 py-3.5 font-sans text-sm font-medium transition",
                cta.variant === "outline"
                  ? "border border-cream/30 text-cream hover:border-cream hover:bg-cream hover:text-ink"
                  : "bg-accent text-white hover:-translate-y-0.5 hover:shadow-lg",
              ]}
            >{cta.label}</a>
          ))}
        </div>
      )}
    </div>

    {(meta || metaRight) && (
      <footer class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-cream/30 pt-6 text-xs text-cream/70 md:flex-row md:items-center">
        {meta && <p class="eyebrow text-cream/70">{meta}</p>}
        {metaRight && (
          <p class="font-cond uppercase tracking-[0.18em] text-cream/70">
            {metaRight}
          </p>
        )}
      </footer>
    )}
  </div>
</section>
