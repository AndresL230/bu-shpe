---
import PhotoViewer from "@/components/PhotoViewer.astro";

interface Props { photos: { src: string; alt: string; group?: string }[] }
const { photos } = Astro.props;
---
<div
  class="grid grid-cols-2 gap-2 sm:gap-3 lg:grid-cols-3"
  id="gallery-grid"
  data-viewer-group
>
  {photos.map((p, i) => (
    <button
      type="button"
      class="group block aspect-[4/3] w-full overflow-hidden rounded-[var(--radius-card)] bg-surface-soft focus:outline-none focus:ring-2 focus:ring-accent"
      data-gallery-index={i}
      data-category={p.group}
      data-viewer-src={p.src}
      data-viewer-alt={p.alt}
    >
      <img
        src={p.src} alt={p.alt} loading="lazy" decoding="async" data-fade
        class="h-full w-full object-cover duration-500 group-hover:scale-[1.03] [transition:opacity_0.4s_ease,transform_0.5s_ease]"
      />
    </button>
  ))}
</div>

<PhotoViewer />
