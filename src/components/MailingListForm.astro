---
import siteData from "@/data/site.json";
import Icon from "@/components/Icon.astro";
---
<form
  method="post"
  action="/api/subscribe"
  class="relative grid grid-cols-2 gap-3 lg:grid-cols-[1fr_1fr_2fr_auto]"
>
  <!-- Honeypot: hidden from people and assistive tech; bots that fill it are dropped silently. -->
  <div aria-hidden="true" class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden">
    <label for="ml-company">Company</label>
    <input id="ml-company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="relative">
    <label for="ml-firstname" class="sr-only">First name</label>
    <input
      id="ml-firstname"
      name="first_name" autocomplete="given-name" required maxlength="80"
      placeholder="First name"
      class="w-full rounded-[var(--radius-card)] border border-rule/40 bg-white px-4 py-3 text-ink placeholder:text-ink-muted/60 focus:border-accent focus:outline-none"
    />
  </div>
  <div class="relative">
    <label for="ml-lastname" class="sr-only">Last name</label>
    <input
      id="ml-lastname"
      name="last_name" autocomplete="family-name" required maxlength="80"
      placeholder="Last name"
      class="w-full rounded-[var(--radius-card)] border border-rule/40 bg-white px-4 py-3 text-ink placeholder:text-ink-muted/60 focus:border-accent focus:outline-none"
    />
  </div>
  <div class="relative col-span-2 lg:col-span-1">
    <label for="ml-email" class="sr-only">Email address</label>
    <input
      id="ml-email"
      type="email" name="email" autocomplete="email" required maxlength="254"
      placeholder="you@bu.edu"
      class="w-full rounded-[var(--radius-card)] border border-rule/40 bg-white px-4 py-3 text-ink placeholder:text-ink-muted/60 focus:border-accent focus:outline-none"
    />
  </div>
  <button
    type="submit"
    class="group col-span-2 inline-flex items-center justify-center gap-2 btn-dossier lg:col-span-1 lg:justify-start"
  >
    Sign Up
    <Icon name="arrow-forward" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
  </button>
</form>
<p class="mt-3 text-xs text-ink-muted">
  Chapter news and event invites, straight to your inbox. Unsubscribe anytime. Prefer Instagram? <a href={siteData.socials.instagram} class="text-link underline">DM us @shpe.bostonu</a>.
</p>
