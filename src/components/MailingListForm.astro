---
import siteData from "@/data/site.json";
import Icon from "@/components/Icon.astro";
---
<form
  method="post"
  action={`mailto:${siteData.contactEmail}?subject=Mailing%20List%20Signup`}
  enctype="text/plain"
  class="grid gap-3 md:grid-cols-[1fr_1fr_2fr_auto]"
>
  <div class="relative">
    <label for="ml-firstname" class="sr-only">First name</label>
    <input
      id="ml-firstname"
      name="First Name" required
      placeholder="First name"
      class="w-full rounded-lg border border-rule/40 bg-white px-4 py-3 text-ink placeholder:text-ink-muted/60 focus:border-accent focus:outline-none"
    />
  </div>
  <div class="relative">
    <label for="ml-lastname" class="sr-only">Last name</label>
    <input
      id="ml-lastname"
      name="Last Name" required
      placeholder="Last name"
      class="w-full rounded-lg border border-rule/40 bg-white px-4 py-3 text-ink placeholder:text-ink-muted/60 focus:border-accent focus:outline-none"
    />
  </div>
  <div class="relative">
    <label for="ml-email" class="sr-only">Email address</label>
    <input
      id="ml-email"
      type="email" name="Email" required
      placeholder="you@bu.edu"
      class="w-full rounded-lg border border-rule/40 bg-white px-4 py-3 text-ink placeholder:text-ink-muted/60 focus:border-accent focus:outline-none"
    />
  </div>
  <button
    type="submit"
    class="group inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 font-sans text-xs font-semibold uppercase tracking-[0.12em] text-white shadow-sm transition hover:-translate-y-px hover:shadow-md"
  >
    Sign Up
    <Icon name="arrow-forward" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
  </button>
</form>
<p class="mt-3 text-xs text-ink-muted">
  Opens your email client. Prefer Instagram? <a href={siteData.socials.instagram} class="text-link underline">DM us @shpe.bostonu</a>.
</p>
