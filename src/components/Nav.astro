---
import siteData from "@/data/site.json";
import Icon from "@/components/Icon.astro";

type SubLink = { href: string; label: string };
type NavLink = { href: string; label: string; submenu?: SubLink[] };

const links: NavLink[] = [
  {
    href: "/about",
    label: "About",
    submenu: [
      { href: "/about",                          label: "all of about" },
      { href: "/about/national",                 label: "shpe nationals" },
      { href: "/about/board",                    label: "e-board" },
      { href: "/about/governance",               label: "governance" },
    ],
  },
  {
    href: "/events",
    label: "Events",
    submenu: [
      { href: "/events/all",                    label: "all events" },
      { href: "/events/all?cat=Professional",   label: "workshops" },
      { href: "/events/all?cat=Conference",     label: "info sessions" },
      { href: "/events/all?cat=Social",         label: "socials" },
    ],
  },
  {
    href: "/conferences",
    label: "Conferences",
    submenu: [
      { href: "/conferences",        label: "all conferences" },
      { href: "/conferences/prep",   label: "career fair prep" },
      { href: "/conferences/record", label: "the record" },
    ],
  },
  { href: "/volunteering",  label: "Volunteering" },
  {
    href: "/gallery",
    label: "Gallery",
    submenu: [
      { href: "/gallery",             label: "all photos" },
      { href: "/gallery?cat=Events",  label: "events" },
    ],
  },
  {
    href: "/support",
    label: "Support",
    submenu: [
      { href: "/support/corporate",  label: "corporate partners" },
      { href: "/support/individual", label: "individual giving" },
    ],
  },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header
  class="fixed inset-x-0 top-0 z-40 bg-deep border-b border-cream/10"
  id="site-nav"
>
  <!-- Mobile + tablet (<lg): hamburger -->
  <div class="lg:hidden flex items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="flex items-center" aria-label={`${siteData.name} home`}>
      <img
        src="/assets/logos/SHPE_logo_horiz_Boston-University_DKBG.png"
        alt={siteData.name}
        width="3266" height="647"
        class="block h-7 w-auto"
      />
    </a>
    <details class="relative">
      <summary
        class="grid h-11 w-11 cursor-pointer place-items-center rounded-[var(--radius-card)] border border-cream/40 text-cream list-none [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </summary>
      <div class="fixed inset-0 top-[72px] z-30 grid place-items-center bg-bg/98 backdrop-blur">
        <nav aria-label="Mobile" class="px-8 text-center">
          <ul class="flex flex-col gap-6">
            {links.map(({ href, label }) => (
              <li>
                <a href={href} class="display text-3xl text-ink hover:text-accent">{label}</a>
              </li>
            ))}
            <li>
              <a
                href="/join"
                class="group mt-4 inline-flex items-center gap-2 btn-dossier"
              >
                Join SHPE
                <Icon name="arrow-forward" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </details>
  </div>

  <!-- lg+: 2-column grid (logo + Join), with nav centered in the viewport -->
  <div class="relative hidden lg:grid lg:grid-cols-2 lg:items-center py-4">
    <div class="flex items-center justify-center px-6 md:px-12 lg:px-16 xl:px-24">
      <div class="max-w-[672px] w-full">
        <a href="/" class="inline-flex items-center" aria-label={`${siteData.name} home`}>
          <img
            src="/assets/logos/SHPE_logo_horiz_Boston-University_DKBG.png"
            alt={siteData.name}
            width="3266" height="647"
            class="block h-8 w-auto"
          />
        </a>
      </div>
    </div>
    <nav
      aria-label="Primary"
      class="pointer-events-none absolute inset-y-0 left-1/2 -translate-x-1/2 flex items-center"
    >
      <ul class="pointer-events-auto flex items-center gap-7 xl:gap-10">
        {links.map(({ href, label, submenu }) => {
          const hasSubmenu = !!submenu;
          return (
            <li class:list={[hasSubmenu && "has-subnav relative"]}>
              <a
                href={href}
                aria-current={currentPath === href ? "page" : undefined}
                aria-haspopup={hasSubmenu ? "true" : undefined}
                class:list={[
                  "nav-link lowercase font-sans text-base font-medium tracking-normal transition-colors",
                  currentPath === href ? "text-cream" : "text-cream/85 hover:text-cream"
                ]}
              >{label}</a>
              {submenu && (
                <div class="dropdown-wrap">
                  <div class="dropdown">
                    {submenu.map((item) => (
                      <a href={item.href} class="dropdown-link">
                        <span class="dropdown-label">{item.label}</span>
                        <span class="dropdown-arrow" aria-hidden="true">→</span>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </nav>
    <div class="flex items-center justify-end px-6 md:px-12 lg:px-16 xl:px-24">
      <a
        href="/join"
        class="group inline-flex items-center gap-2 btn-dossier whitespace-nowrap hover:bg-accent-deep hover:text-white"
      >
        Join SHPE
        <Icon name="arrow-forward" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
      </a>
    </div>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
    padding-bottom: 4px;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.25s ease;
  }
  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  /* ---------- Index dropdown panel (light, page-palette) ---------- */
  /* The wrapper sits at the parent <li>'s bottom edge; its padding-top is an
     invisible hover-bridge that fills the navbar's bottom padding so the
     visible panel lands flush under the navbar and the hover never breaks
     when the cursor crosses the gap from trigger into panel. */
  .dropdown-wrap {
    position: absolute;
    top: 100%;
    left: -16px;                  /* offset the item padding so text lines up with the trigger */
    padding-top: 27px;            /* hover bridge — lands the panel top flush at the navbar's bottom edge */
    z-index: 50;
    opacity: 0;
    visibility: hidden;
    /* ~150ms grace on close: visibility holds through the fade so moving from
       the trigger into the panel doesn't dismiss it; re-entering hover (or
       focus) restores it instantly. */
    transition: opacity 0.15s ease, visibility 0.15s ease;
  }
  .has-subnav:hover .dropdown-wrap,
  .has-subnav:focus-within .dropdown-wrap {
    opacity: 1;
    visibility: visible;
  }
  .dropdown {
    width: 244px;
    padding: 6px 0;
    background: var(--color-surface);                 /* white, on the warm page */
    border: 0.5px solid var(--color-hairline);        /* hairline all around */
    border-radius: 0 0 var(--radius-card) var(--radius-card);  /* square top, dossier radius at bottom */
    box-shadow: 0 16px 28px -20px rgba(0, 31, 91, 0.22);
  }
  .dropdown-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 16px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .dropdown-label {
    font-family: var(--font-sans);      /* match the navbar links (Inter) */
    font-size: 16px;
    font-weight: 500;
    line-height: 1.1;
    color: var(--color-ink);            /* navy */
    transition: color 0.15s ease;
  }
  .dropdown-arrow {
    color: var(--color-arrow-mute);     /* muted by default */
    font-size: 15px;
    line-height: 1;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .dropdown-link:hover,
  .dropdown-link:focus-visible {
    background-color: var(--color-tint-warm);   /* warm wash */
  }
  .dropdown-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;                       /* keep the ring inside the panel */
    border-radius: 2px;
  }
  .dropdown-link:hover .dropdown-label,
  .dropdown-link:focus-visible .dropdown-label,
  .dropdown-link:hover .dropdown-arrow,
  .dropdown-link:focus-visible .dropdown-arrow {
    color: var(--color-accent);                 /* label + arrow → orange */
  }
  .dropdown-link:hover .dropdown-arrow,
  .dropdown-link:focus-visible .dropdown-arrow {
    transform: translateX(2px);                 /* nudge right */
  }
</style>

<!-- Push content below fixed nav -->
<div class="h-[72px]" aria-hidden="true"></div>
