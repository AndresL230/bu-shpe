---
import siteData from "@/data/site.json";

const quickLinks = [
  { href: "/about", label: "About" },
  { href: "/about/board", label: "E-Board" },
  { href: "/events", label: "Events" },
  { href: "/conferences", label: "Conferences" },
  { href: "/volunteering", label: "Volunteering" },
  { href: "/gallery", label: "Gallery" },
  { href: "/support", label: "Support" },
  { href: "/join", label: "Join Us" },
];
---
<footer class="bg-deep text-cream">
  <div class="mx-auto grid max-w-[1200px] gap-10 px-6 py-14 md:gap-12 md:py-16 md:grid-cols-3">
    <div>
      <img
        src="/assets/logos/SHPE_logo_horiz_Boston-University_DKBG.png"
        alt={siteData.name}
        width="220" height="48"
        class="h-12 w-auto"
      />
      <p class="mt-6 max-w-sm text-sm leading-relaxed text-cream/80">
        {siteData.mission}
      </p>
      <a
        href={siteData.socials.shpe}
        class="eyebrow mt-4 md:mt-6 inline-block py-2.5 md:py-0 text-cream/70! hover:text-accent!"
        rel="noopener"
      >Part of SHPE National →</a>
    </div>

    <div>
      <p class="eyebrow text-cream/70!">Explore</p>
      <ul class="mt-2 grid grid-cols-2 gap-x-6 md:mt-4 md:block md:space-y-2">
        {quickLinks.map(l => (
          <li><a href={l.href} class="inline-block py-2.5 md:py-0 text-cream hover:text-accent transition-colors">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="eyebrow text-cream/70!">Contact</p>
      <ul class="mt-2 md:mt-4 md:space-y-2 text-cream">
        <li><a href={`mailto:${siteData.contactEmail}`} class="inline-block py-2.5 md:py-0 hover:text-accent">{siteData.contactEmail}</a></li>
        <li class="text-cream/70 text-sm">Faculty Advisor: <a href={`mailto:${siteData.facultyAdvisorEmail}`} class="inline-block py-2.5 md:py-0 hover:text-accent">{siteData.facultyAdvisorEmail}</a></li>
      </ul>

      <p class="eyebrow mt-8 text-cream/70!">Follow</p>
      <ul class="mt-2 md:mt-4 flex flex-wrap gap-x-6 md:gap-4">
        <li><a href={siteData.socials.instagram} aria-label="Instagram" class="inline-block py-2.5 md:py-0 hover:text-accent" rel="noopener">Instagram</a></li>
        <li><a href={siteData.socials.linkedin} aria-label="LinkedIn" class="inline-block py-2.5 md:py-0 hover:text-accent" rel="noopener">LinkedIn</a></li>
        <li><a href={siteData.socials.facebook} aria-label="Facebook" class="inline-block py-2.5 md:py-0 hover:text-accent" rel="noopener">Facebook</a></li>
      </ul>

      <a
        href={siteData.donateUrl}
        rel="noopener"
        class="mt-8 inline-flex min-h-11 md:min-h-0 items-center rounded-[var(--radius-card)] border border-accent px-5 py-2.5 font-mono text-sm font-semibold uppercase tracking-[0.1em] text-accent transition hover:bg-accent hover:text-white"
      >Donate to BU SHPE</a>
    </div>
  </div>

  <div class="border-t border-cream/10">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-2 px-6 py-6 text-xs text-cream/60 md:flex-row md:items-center md:justify-between">
      <p>© {new Date().getFullYear()} SHPE-BostonU. Designed con familia.</p>
      <p class="flex flex-wrap gap-x-5 gap-y-1">
        <a href="/privacy" class="py-2.5 md:py-0 hover:text-accent">Privacy</a>
        <a href="/terms" class="py-2.5 md:py-0 hover:text-accent">Terms</a>
        <span class="py-2.5 md:py-0">{siteData.region} · Boston University</span>
      </p>
    </div>
  </div>
</footer>
