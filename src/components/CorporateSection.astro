---
import SponsorGrid from "@/components/SponsorGrid.astro";
import Icon from "@/components/Icon.astro";
import type { Sponsor } from "@/types";
import supportData from "@/data/support.json";
import sponsorsData from "@/data/sponsors.json";
import siteData from "@/data/site.json";

const sponsors = sponsorsData as Sponsor[];
const corporate = sponsors.filter((s) => !s.name.startsWith("BU "));

const valuePitches = [
  {
    title: "Hispanic STEM talent at a top engineering school",
    description:
      "More than 100 students take part each year, studying mechanical, electrical, biomedical, and computer engineering at one of the nation's top programs.",
  },
  {
    title: "Visibility on campus and at Convention",
    description:
      "Workshops, panels, and career fairs across 20+ events a year, plus the largest Hispanic STEM conference in the country.",
  },
  {
    title: "A direct line to organized students",
    description:
      "Meet motivated students directly through the chapter, not the résumé pile. 7+ partners already recruit here.",
  },
];

const partnerBenefits = supportData.partnerBenefits as string[];

// Supported-events mosaic — differently sized image tiles filling one rectangle.
const eventCollage = [
  { src: "/assets/events/leadershpe-live-2023.jpg", alt: "LeaderSHPE Live 2023", cls: "col-span-2 row-span-2" },
  { src: "/assets/events/national-convention-2022.jpg", alt: "SHPE National Convention", cls: "col-span-4 row-span-1" },
  { src: "/assets/events/capital-one-workshop.jpg", alt: "Money Matters Workshop with Capital One", cls: "col-span-2 row-span-1" },
  { src: "/assets/events/boston-scientific-visit.jpg", alt: "Boston Scientific company visit", cls: "col-span-2 row-span-1" },
];

// Tri-color asymmetric bento for the five benefits.
const benefitTiles = [
  { wrap: "bg-deep sm:col-span-3 min-h-[220px] md:min-h-[260px]", text: "text-cream text-2xl md:text-3xl", num: "text-cream/10" },
  { wrap: "bg-accent sm:col-span-3 min-h-[220px] md:min-h-[260px]", text: "text-white text-2xl md:text-3xl", num: "text-white/15" },
  { wrap: "bg-cream sm:col-span-2 min-h-[190px]", text: "text-ink text-xl md:text-2xl", num: "text-accent/20" },
  { wrap: "bg-surface-soft sm:col-span-2 min-h-[190px]", text: "text-ink text-xl md:text-2xl", num: "text-ink/10" },
  { wrap: "bg-accent/10 sm:col-span-2 min-h-[190px]", text: "text-ink text-xl md:text-2xl", num: "text-accent/25" },
];
---

<!-- Why partner — equal typographic triptych -->
<section class="reveal py-20 md:py-28">
  <div class="mx-auto max-w-[1200px] px-6">
    <p class="eyebrow text-accent">WHY PARTNER</p>
    <h2 class="display mt-4 max-w-2xl text-3xl leading-[1.05] text-ink md:text-4xl">
      Where companies meet <em class="font-serif italic font-normal lowercase tracking-normal text-accent">engineers</em>.
    </h2>

    <div class="mt-14 grid grid-cols-1 gap-y-12 sm:grid-cols-3 sm:gap-y-0 sm:divide-x sm:divide-rule/40">
      {valuePitches.map((pitch, i) => (
        <div class="sm:px-8 sm:first:pl-0 sm:last:pr-0">
          <span
            aria-hidden="true"
            class="block font-display text-7xl leading-none tabular-nums text-transparent [-webkit-text-stroke:2px_var(--color-accent)] md:text-8xl"
          >0{i + 1}</span>
          <h3 class="display mt-6 text-2xl leading-tight text-ink md:text-3xl">{pitch.title}</h3>
          <p class="mt-3 leading-relaxed text-ink-muted">{pitch.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- What's included — tri-color asymmetric bento -->
<section class="reveal border-t border-rule/40 py-20 md:py-28">
  <div class="mx-auto max-w-[1200px] px-6">
    <p class="eyebrow text-accent">WHAT'S INCLUDED</p>
    <h2 class="display mt-4 text-3xl leading-[1.05] text-ink md:text-4xl">
      What partnership includes.
    </h2>

    <div class="mt-12 grid gap-3 sm:grid-cols-6">
      {partnerBenefits.map((b, i) => {
        const s = benefitTiles[i];
        return (
          <article
            class:list={[
              "group relative isolate flex flex-col justify-end overflow-hidden rounded-[var(--radius-card)] p-8 md:p-9",
              s.wrap,
            ]}
          >
            <span
              aria-hidden="true"
              class:list={[
                "pointer-events-none absolute -bottom-8 -right-2 select-none font-cond text-[7rem] leading-none tabular-nums transition-transform duration-500 group-hover:-translate-y-1 md:text-[8rem]",
                s.num,
              ]}
            >0{i + 1}</span>
            <p class:list={["display relative z-10 leading-tight", s.text]}>{b}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>

<!-- Get started — pairs the impact line (why) with the two ways to start (how) -->
<section class="reveal border-t border-rule/40">
  <div class="mx-auto grid max-w-[1200px] grid-cols-1 gap-12 px-6 py-16 md:grid-cols-12 md:items-center md:gap-16 md:py-20">
    <div class="md:col-span-6">
      <p class="eyebrow text-accent">GET STARTED</p>
      <p class="pullquote mt-5 text-ink">
        Support here turns into convention trips, workshops, and <em class="text-accent">first jobs</em>.
      </p>
    </div>

    <div class="md:col-span-6 md:border-l md:border-rule/40 md:pl-16">
      <h3 class="display text-2xl leading-tight text-ink md:text-3xl">
        Two ways to start the conversation.
      </h3>
      <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a href={siteData.sponsorshipPacketUrl} target="_blank" rel="noopener" class="group inline-flex items-center justify-center gap-2 btn-dossier">
          Download the Sponsorship Packet
          <Icon name="arrow-forward" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
        </a>
        <button type="button" data-open-modal="corporate" class="group inline-flex items-center justify-center gap-2 btn-dossier-ghost">
          Become a Partner
          <Icon name="person-add" class="h-4 w-4" />
        </button>
      </div>
      <p class="mt-6 text-sm text-ink-muted">
        Prefer email? <a href={`mailto:${siteData.contactEmail}?subject=Sponsorship%20Inquiry`} class="text-ink underline underline-offset-2 hover:text-accent">{siteData.contactEmail}</a>
      </p>
    </div>
  </div>
</section>

<!-- Supported events — overlapping photo collage, introduced by the pullquote above -->
<section class="reveal pb-16 md:pb-20">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="grid aspect-[3/1] w-full grid-cols-6 grid-rows-2 gap-3">
      {eventCollage.map((p) => (
        <figure
          class:list={[
            "group photo-warm overflow-hidden rounded-[var(--radius-card)]",
            p.cls,
          ]}
        >
          <img src={p.src} alt={p.alt} loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- Current partners — colophon -->
<section class="reveal border-t border-rule/40">
  <div class="mx-auto max-w-[1200px] px-6 py-20 md:py-28">
    <p class="eyebrow text-accent">OUR PARTNERS</p>
    <h2 class="display mt-4 text-3xl leading-[1.05] text-ink md:text-4xl">
      Thank you to our partners.
    </h2>
    <p class="mt-4 max-w-2xl font-serif text-lg italic text-ink-muted">
      With continued support from the BU College of Engineering and the Student Activities Office.
    </p>
    <div class="mt-12">
      <SponsorGrid sponsors={corporate} />
    </div>
  </div>
</section>
