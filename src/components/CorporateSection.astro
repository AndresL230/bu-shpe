---
import SponsorGrid from "@/components/SponsorGrid.astro";
import type { Sponsor } from "@/types";
import supportData from "@/data/support.json";
import sponsorsData from "@/data/sponsors.json";

const sponsors = sponsorsData as Sponsor[];

const valuePitches = [
  {
    title: "Access to Hispanic STEM talent at a top engineering school",
    description: "Our members study mechanical, electrical, biomedical, and computer engineering at one of the nation's top programs.",
  },
  {
    title: "Visibility at chapter events and the SHPE National Convention",
    description: "Put your brand in front of students at workshops, panels, career fairs, and the largest Hispanic STEM conference in the country.",
  },
  {
    title: "A direct recruiting pipeline to motivated, organized students",
    description: "Skip the resume pile. Meet motivated, organized students who are ready to work.",
  },
];

const partnerBenefits = supportData.partnerBenefits as string[];
---

<!-- Why partner — asymmetric, numbered list -->
<section class="reveal py-20 md:py-28">
  <div class="mx-auto grid max-w-[1200px] grid-cols-1 gap-10 px-6 md:grid-cols-12 md:gap-16">
    <div class="md:col-span-5">
      <p class="eyebrow text-accent">WHY PARTNER</p>
      <h2 class="display mt-4 text-3xl leading-[1.05] text-ink md:text-4xl">
        Meet your next engineers <em class="font-serif italic font-normal lowercase tracking-normal text-accent">first</em>.
      </h2>
    </div>
    <ul class="flex flex-col divide-y divide-rule/25 md:col-span-7 md:pt-1">
      {valuePitches.map((pitch, i) => (
        <li class="grid grid-cols-[auto_1fr] gap-x-5 gap-y-1 py-8 first:pt-0">
          <span class="font-cond text-base tracking-widest text-accent tabular-nums">0{i + 1}</span>
          <div>
            <h3 class="display text-2xl leading-tight text-ink">{pitch.title}</h3>
            <p class="mt-2 leading-relaxed text-ink-muted">{pitch.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- What partners get -->
<section class="reveal border-t border-outline-soft/50">
  <div class="mx-auto grid max-w-[1200px] grid-cols-1 gap-10 px-6 py-20 md:grid-cols-12 md:gap-16 md:py-28">
    <div class="md:col-span-4">
      <p class="eyebrow text-accent">WHAT PARTNERS GET</p>
      <h2 class="display mt-4 text-3xl leading-[1.05] text-ink md:text-4xl">
        Everything your partnership includes.
      </h2>
    </div>
    <ul class="grid gap-x-10 gap-y-5 md:col-span-8 md:pt-1 sm:grid-cols-2">
      {partnerBenefits.map((b) => (
        <li class="flex items-start gap-3">
          <span class="mt-1.5 shrink-0 text-xs font-bold leading-none text-accent" aria-hidden="true">✓</span>
          <span class="leading-relaxed text-ink-muted">{b}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Current partners -->
<section class="reveal border-t border-outline-soft/50">
  <div class="mx-auto max-w-[1200px] px-6 py-20 md:py-28">
    <h2 class="display mb-12 text-3xl leading-[1.05] text-ink md:text-4xl">
      Thank you to our partners.
    </h2>
    <SponsorGrid sponsors={sponsors} />
  </div>
</section>
