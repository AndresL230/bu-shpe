---
import Icon from "@/components/Icon.astro";

interface Props {
  id: string;
  title: string;
  formspreeId?: string;
}

const { id, title, formspreeId = "PLACEHOLDER" } = Astro.props;

const mailtoHref = `mailto:shpe@bu.edu?subject=${encodeURIComponent("BU SHPE Support — " + title)}`;
---

<dialog
  id={`modal-${id}`}
  aria-modal="true"
  aria-labelledby={`modal-${id}-title`}
  class="m-auto p-0 bg-transparent backdrop:bg-deep/80 open:flex open:items-center open:justify-center"
>
  <!-- Inner card — child of dialog so backdrop-click (e.target === dlg) works -->
  <div class="relative w-[92vw] max-w-lg max-h-[90dvh] overflow-y-auto rounded-[var(--radius-card)] bg-surface p-8 shadow-[var(--shadow-card-hover)]">

    <!-- Close button -->
    <button
      type="button"
      data-close
      aria-label="Close"
      class="absolute right-4 top-4 grid h-9 w-9 place-items-center rounded-full text-ink-muted transition hover:text-ink hover:bg-surface-soft focus:outline-none focus:ring-2 focus:ring-accent"
    >
      <span aria-hidden="true" class="text-xl leading-none">×</span>
    </button>

    <!-- Form section -->
    <div data-form-wrap>
      <h2
        id={`modal-${id}-title`}
        class="display text-3xl text-ink"
      >{title}</h2>

      <form id={`form-${id}`} novalidate class="mt-6 flex flex-col gap-4">
        <input type="hidden" name="_subject" value={`BU SHPE Support — ${title}`} />
        <input type="hidden" name="form" value={id} />

        <!-- Parent page injects fields here -->
        <slot />

        <div class="pt-2">
          <button
            type="submit"
            class="group inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 font-sans text-xs font-semibold uppercase tracking-[0.12em] text-white shadow-sm transition hover:-translate-y-px hover:shadow-md"
          >
            Send message
            <Icon name="arrow-forward" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
          </button>
        </div>
      </form>

      <p class="mt-5 text-sm text-ink-muted">
        Prefer email?{" "}
        <a href={mailtoHref} class="text-link underline">shpe@bu.edu</a>
      </p>
    </div>

    <!-- Success state (hidden until form submits successfully) -->
    <div data-success hidden class="flex flex-col gap-4 py-4">
      <p class="display text-3xl text-ink">Thanks! We'll be in touch.</p>
      <p class="text-ink-muted">We'll follow up at the email you provided.</p>
      <button
        type="button"
        data-close
        class="group inline-flex w-fit items-center gap-2 rounded-full bg-accent px-7 py-3.5 font-sans text-xs font-semibold uppercase tracking-[0.12em] text-white shadow-sm transition hover:-translate-y-px hover:shadow-md"
      >
        Close
      </button>
    </div>

    <!-- Error state (hidden until fetch fails) -->
    <div data-error hidden class="flex flex-col gap-4 py-4">
      <p class="text-ink font-semibold">Something went wrong sending the form.</p>
      <p class="text-sm text-ink-muted">
        Please try emailing us directly at{" "}
        <a href={mailtoHref} class="text-link underline">shpe@bu.edu</a>.
      </p>
      <button
        type="button"
        data-close
        class="group inline-flex w-fit items-center gap-2 rounded-full border border-rule px-7 py-3 font-sans text-xs font-semibold uppercase tracking-[0.12em] text-ink shadow-sm transition hover:-translate-y-px hover:shadow-md"
      >
        Close
      </button>
    </div>

  </div>
</dialog>

<script is:inline define:vars={{ id, formspreeId }}>
  (function () {
    const dlg = document.getElementById('modal-' + id);
    if (!dlg) return;

    const form = document.getElementById('form-' + id);
    const formWrap = dlg.querySelector('[data-form-wrap]');
    const successEl = dlg.querySelector('[data-success]');
    const errorEl = dlg.querySelector('[data-error]');

    // All [data-close] elements close the dialog
    dlg.querySelectorAll('[data-close]').forEach(function (btn) {
      btn.addEventListener('click', function () { dlg.close(); });
    });

    // Backdrop click (click lands on the <dialog> element itself, not the inner card)
    dlg.addEventListener('click', function (e) {
      if (e.target === dlg) dlg.close();
    });

    // Reset state when dialog is closed
    dlg.addEventListener('close', function () {
      if (formWrap) formWrap.hidden = false;
      if (successEl) successEl.hidden = true;
      if (errorEl) errorEl.hidden = true;
      if (form) form.reset();
    });

    // Form submission via Formspree
    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();

        // Let browser validate required fields first
        if (!form.reportValidity()) return;

        try {
          const res = await fetch('https://formspree.io/f/' + formspreeId, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });

          if (res.ok) {
            if (formWrap) formWrap.hidden = true;
            if (successEl) successEl.hidden = false;
          } else {
            throw new Error('server error');
          }
        } catch (_) {
          if (formWrap) formWrap.hidden = true;
          if (errorEl) errorEl.hidden = false;
        }
      });
    }
  })();
</script>

<style>
  dialog {
    opacity: 0;
    transform: translateY(8px) scale(0.98);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      overlay 0.2s allow-discrete,
      display 0.2s allow-discrete;
  }

  dialog[open] {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    dialog[open] {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }

  dialog::backdrop {
    opacity: 0;
    transition:
      opacity 0.2s ease,
      overlay 0.2s allow-discrete,
      display 0.2s allow-discrete;
  }

  dialog[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    dialog[open]::backdrop {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    dialog,
    dialog::backdrop {
      transition: none;
    }
  }
</style>
