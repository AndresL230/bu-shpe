---
import PageHero from "@/components/PageHero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Icon from "@/components/Icon.astro";

import nationalData from "@/data/national.json";
import type { NationalData } from "@/types";

const national = nationalData as NationalData;
---

<PageHero
  eyebrow="SHPE NATIONALS"
  headline="Where the network began."
  headlineAccent="network"
  subtitle="Founded in Los Angeles in 1974, the Society of Hispanic Professional Engineers grew from one city department into a national familia of professional and student chapters."
  meta={`EST. ${national.founded} — ${national.foundedCity.toUpperCase()}`}
  metaRight="SHPE.ORG"
/>

<!-- ① History -->
<section class="mx-auto max-w-[1200px] px-6 py-24 md:py-32">
  <a href="/about" class="group inline-flex items-center gap-2 font-sans text-sm font-medium text-ink-muted hover:text-ink transition-colors mb-12">
    <Icon name="arrow-forward" class="w-4 h-4 rotate-180 transition-transform group-hover:-translate-x-1" />
    <span class="border-b border-transparent group-hover:border-current pb-0.5">Back to about</span>
  </a>

  <div class="grid grid-cols-1 gap-12 md:grid-cols-2 md:gap-16">
    <SectionHeading
      eyebrow="HISTORY"
      title="Role models, by design."
    />
    <div class="flex flex-col gap-6 leading-relaxed text-ink-muted">
      {national.history.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<!-- ② Mission + vision pull-quote -->
<section class="reveal border-t border-rule/20 bg-surface py-24">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="mx-auto flex max-w-3xl flex-col gap-8 text-center">
      <p class="eyebrow text-ink-muted">THE MISSION</p>
      <p class="pullquote">“{national.mission}”</p>
      <p class="mx-auto max-w-2xl text-ink-muted">
        <span class="font-medium text-ink">The vision:</span> {national.vision}
      </p>
    </div>
  </div>
</section>

<!-- ③ Five pillars -->
<section class="reveal mx-auto max-w-[1200px] px-6 py-24 md:py-32">
  <SectionHeading
    eyebrow="FIVE PILLARS"
    title="What SHPE is built on."
    lede="Every program the chapter runs maps back to one of five national pillars."
  />

  <ol class="mt-16 grid grid-cols-1 gap-x-10 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
    {national.pillars.map((pillar, i) => (
      <li class="flex flex-col gap-3 border-t border-rule/40 pt-6">
        <span class="display text-4xl leading-none text-accent tabular-nums">{String(i + 1).padStart(2, "0")}</span>
        <h3 class="display text-2xl text-ink">{pillar.name}</h3>
        <p class="text-sm leading-relaxed text-ink-muted">{pillar.description}</p>
      </li>
    ))}
  </ol>
</section>

<!-- ④ Why join nationals — navy band -->
<section class="reveal bg-deep py-24 md:py-32">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-5">
        <p class="eyebrow text-cream/70">WHY JOIN NATIONALS</p>
        <h2 class="display mt-4 text-4xl text-cream md:text-5xl">
          National membership, <em class="font-serif italic font-normal lowercase tracking-normal text-accent">ten dollars</em> a year.
        </h2>
        <p class="mt-6 max-w-md text-cream/80">
          National membership is separate from the BU chapter — and for {national.membership.studentDues} {national.membership.duesNote}, it unlocks the national layer of SHPE.
        </p>
        <a
          href={national.membership.joinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group mt-10 inline-flex items-center gap-2 btn-dossier"
        >
          Join SHPE Nationals
          <Icon name="arrow-forward" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
        </a>
        <p class="mt-5 text-sm text-cream/60">
          Looking for the BU chapter instead? <a href="/join" class="text-cream underline underline-offset-4 hover:text-accent transition-colors">Start here.</a>
        </p>
      </div>
      <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 md:col-span-7">
        {national.membership.benefits.map((benefit) => (
          <div class="flex flex-col gap-2 border-t border-cream/20 pt-5">
            <h3 class="font-cond text-sm font-semibold uppercase tracking-[0.14em] text-cream">{benefit.name}</h3>
            <p class="text-sm leading-relaxed text-cream/70">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
