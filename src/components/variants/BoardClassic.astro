---
import OrangeTick from "@/components/OrangeTick.astro";
import CtaBand from "@/components/CtaBand.astro";
import Reveal from "@/components/Reveal.astro";
import type { BoardMember } from "@/types";
import boardData from "@/data/board.json";
import siteData from "@/data/site.json";

const allMembers = boardData as BoardMember[];
const officers = allMembers.filter((m) => m.role !== "Faculty Advisor");
const advisor = allMembers.find((m) => m.role === "Faculty Advisor");

const visionItems = [
  "Fostering a sense of community for Hispanic engineers on campus.",
  "Providing direct pipelines to industry-leading Fortune 500 companies.",
  "Ensuring academic support through peer tutoring and study banks.",
];
---

<!-- 1. Hero — 60/40 -->
<section class="bg-deep">
  <div
    class="max-w-[1200px] mx-auto px-6 py-24 md:py-32 flex flex-col md:flex-row items-end justify-between gap-12"
  >
    <div class="md:w-3/5">
      <OrangeTick />
      <h1 class="display text-5xl md:text-6xl text-cream leading-none">
        Meet the <em
          class="font-serif italic font-normal lowercase tracking-normal text-accent"
          >board</em
        >.
      </h1>
      <p class="text-cream/80 mt-8 max-w-xl text-lg">
        Driving the mission of Hispanic excellence in engineering at Boston
        University. Our leadership focuses on professional development,
        community impact, and academic success.
      </p>
    </div>
    <div class="md:w-2/5 md:max-w-xs">
      <div class="border border-cream/30 p-6">
        <p class="eyebrow text-accent mb-2">Elected Term</p>
        <p class="display text-4xl md:text-5xl text-cream">
          {siteData.currentBoardTerm}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- 2. Board grid section -->
<section class="max-w-[1200px] mx-auto px-6 py-24 md:py-32">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
    {officers.map((member) => (
      <article class="flex flex-col md:flex-row gap-8 group">
        <div class="md:w-1/2 aspect-[4/5] overflow-hidden border border-outline-soft relative">
          <img
            src={member.photo}
            alt={member.name}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
        </div>
        <div class="md:w-1/2 flex flex-col justify-center">
          <span class="eyebrow text-accent mb-2">{member.role}</span>
          <h3 class="display text-3xl md:text-4xl text-ink mb-4">{member.name}</h3>
          <p class="font-serif italic text-ink-muted mb-6">"{member.bio}"</p>
          <div class="border-l-2 border-deep pl-4">
            <span class="eyebrow text-ink block">{member.major}</span>
            <span class="text-sm text-ink-muted">
              {member.year} · {member.hometown}
            </span>
          </div>
        </div>
      </article>
    ))}
  </div>

  {advisor && (
    <div class="mt-16 pt-16 border-t border-rule">
      <p class="eyebrow text-ink-muted mb-8">Faculty advisor</p>
      <article class="flex flex-col md:flex-row gap-8 group">
        <div class="md:w-1/2 aspect-[4/5] overflow-hidden border border-outline-soft relative">
          <img
            src={advisor.photo}
            alt={advisor.name}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
        </div>
        <div class="md:w-1/2 flex flex-col justify-center">
          <span class="eyebrow text-accent mb-2">{advisor.role}</span>
          <h3 class="display text-3xl md:text-4xl text-ink mb-4">{advisor.name}</h3>
          <p class="font-serif italic text-ink-muted mb-6">"{advisor.bio}"</p>
          <div class="border-l-2 border-deep pl-4">
            <span class="eyebrow text-ink block">{advisor.major}</span>
            <span class="text-sm text-ink-muted">
              {advisor.year} · {advisor.hometown}
            </span>
          </div>
        </div>
      </article>
    </div>
  )}
</section>

<!-- 3. Vision block — 40/60 asymmetric -->
<section class="bg-surface-soft border-t border-outline-soft py-24 md:py-32">
  <Reveal>
    <div
      class="max-w-[1200px] mx-auto px-6 flex flex-col md:flex-row gap-16 items-center"
    >
      <div class="md:w-2/5 order-2 md:order-1">
        <h2 class="display text-4xl md:text-5xl text-ink mb-6">
          Our vision.
        </h2>
        <p class="text-ink-muted mb-8 text-lg">
          The board is more than just leadership — it is a collaborative
          engine. We meet weekly to discuss member engagement, corporate
          sponsorships, and the implementation of our "SHPE Familia" core
          values.
        </p>
        <ul class="space-y-4">
          {
            visionItems.map((text) => (
              <li class="flex items-start gap-4">
                <span class="w-3 h-3 bg-deep mt-2 shrink-0" />
                <span class="text-ink">{text}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="md:w-3/5 order-1 md:order-2">
        <div class="aspect-[16/9] relative bg-deep overflow-hidden">
          <img
            src="/assets/events/leadershpe-live-2023.jpg"
            alt="BU SHPE at LeaderSHPE Live 2023"
            class="w-full h-full object-cover"
          />
          <div
            class="absolute inset-0 border-[16px] md:border-[24px] border-bg pointer-events-none"
          >
          </div>
        </div>
      </div>
    </div>
  </Reveal>
</section>

<!-- 4. CTA band -->
<CtaBand
  heading="Lead with us."
  body="Interested in joining the extended board or leading a specific committee? We are always looking for passionate members to help organize events and manage outreach."
  primaryCta={{ label: "Apply for Committee", href: "/join" }}
  secondaryCta={{ label: "Our Constitution", href: siteData.constitutionUrl }}
/>
