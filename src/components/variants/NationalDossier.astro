---
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";

import nationalData from "@/data/national.json";
import type { NationalData } from "@/types";

const national = nationalData as NationalData;
---

<!-- HERO -->
<header class="relative w-full bg-deep blueprint-deep py-16 md:py-28 px-6 overflow-hidden">
  <div class="max-w-[1152px] mx-auto relative z-10">
    <p class="font-mono text-cream/60 text-xs tracking-[0.14em] md:text-sm md:tracking-[0.18em] uppercase mb-5 text-balance">About · SHPE Nationals</p>
    <h1 class="display text-5xl md:text-7xl text-cream leading-[1.02] max-w-3xl">
      Where the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">network</em> began.
    </h1>
    <p class="mt-7 text-cream/80 max-w-xl text-lg">
      Founded in Los Angeles in 1974, the Society of Hispanic Professional Engineers grew from one city department into a national familia of professional and student chapters.
    </p>
    <!-- Phones: stacked fact rows (every fact here is too long to pair up); md+: one wrapping line. -->
    <div class="mt-8 md:mt-9 grid grid-cols-1 gap-x-6 gap-y-2.5 md:flex md:flex-wrap md:gap-x-10 md:gap-y-3 font-mono text-xs tracking-[0.14em] uppercase text-cream/60">
      <span>Est. {national.founded}</span>
      <span>{national.foundedCity}</span>
      <span>Chapters nationwide</span>
    </div>
  </div>
</header>

<!-- 01 — ORIGINS -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
  <div class="md:col-span-5">
    <a href="/about" class="group inline-flex items-center gap-2 font-mono text-sm text-ink-muted hover:text-ink transition-colors min-h-11 -mt-3 mb-5 md:min-h-0 md:mt-0 md:mb-8 tracking-wide uppercase">
      <span aria-hidden="true" class="transition-transform group-hover:-translate-x-1">←</span>
      <span class="border-b border-transparent group-hover:border-current pb-0.5">Back to about</span>
    </a>
    <SectionIndex label="Origins" accent="scarlet" />
    <h2 class="display text-3xl md:text-4xl text-ink mt-5">Role models, by design.</h2>
    <p class="mt-4 text-ink-muted max-w-md">
      A network built deliberately, chapter by chapter, since 1974.
    </p>
  </div>
  <div class="md:col-span-7 flex flex-col gap-6 leading-relaxed text-ink">
    {national.history.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 02 — MISSION & VISION -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28">
  <SectionIndex label="Mission & Vision" />
  <div class="mt-8 sm:mt-10 grid grid-cols-1 md:grid-cols-2 gap-px bg-outline-soft border-t sm:border border-outline-soft md:border-x-0 md:border-b-0">
    <div class="bg-bg py-5 sm:p-7 md:pl-0 md:pr-10 md:pt-8 md:pb-0">
      <p class="font-mono text-sm text-accent tracking-wide uppercase mb-3">Mission</p>
      <p class="text-ink">“{national.mission}”</p>
    </div>
    <div class="bg-bg py-5 sm:p-7 md:pl-10 md:pr-0 md:pt-8 md:pb-0">
      <p class="font-mono text-sm text-accent tracking-wide uppercase mb-3">Vision</p>
      <p class="text-ink">{national.vision}</p>
    </div>
  </div>
</section>

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 03 — FIVE PILLARS -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28">
  <SectionIndex label="Five Pillars" />
  <h2 class="display text-3xl md:text-4xl text-ink mt-5 max-w-2xl">What SHPE is built on.</h2>
  <p class="mt-4 text-ink-muted max-w-md">
    Every program the chapter runs maps back to one of five national pillars.
  </p>

  <div class="mt-8 sm:mt-10 grid grid-cols-1 gap-px bg-outline-soft border-t sm:border border-outline-soft md:border-x-0">
    {national.pillars.map((pillar, i) => (
      <div class="bg-bg py-5 sm:p-7 md:px-0 md:py-6 md:grid md:grid-cols-12 md:gap-x-12 md:items-baseline">
        <div class="flex flex-row-reverse items-baseline justify-between gap-4 mb-2 sm:block sm:mb-0 md:col-span-5">
          <p class="font-mono text-xs text-ink-muted shrink-0 sm:mb-4 md:hidden">{String(i + 1).padStart(2, "0")}</p>
          <h3 class="display text-xl text-ink hidden md:block">{pillar.name}</h3>
          <p class="font-mono text-sm text-accent tracking-wide uppercase sm:mb-3 md:hidden">{pillar.name}</p>
        </div>
        <p class="text-ink text-sm leading-relaxed md:col-span-7 md:text-base">{pillar.description}</p>
      </div>
    ))}
  </div>
</section>

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 04 — MEMBERSHIP -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
  <div class="md:col-span-5 md:sticky md:top-28 md:self-start">
    <SectionIndex label="Why join nationals" />
    <h2 class="display text-3xl md:text-4xl text-ink mt-5">
      {national.membership.studentDues} a year, national reach.
    </h2>
    <p class="mt-4 text-ink-muted max-w-md">
      National membership is separate from the BU chapter — {national.membership.studentDues} {national.membership.duesNote} unlocks the national layer of SHPE.
    </p>
    <a
      href={national.membership.joinUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group mt-5 md:mt-8 min-h-11 md:min-h-0 inline-flex items-center gap-2 font-mono text-sm uppercase tracking-wide text-accent hover:text-accent/80 md:font-sans md:text-base md:font-medium md:normal-case md:tracking-normal md:text-ink md:hover:text-accent transition-colors"
    >
      <span class="border-b border-current pb-0.5">Join SHPE Nationals</span>
      <span aria-hidden="true" class="md:hidden">→</span>
      <Icon name="arrow-forward" class="hidden md:block w-4 h-4 transition-transform group-hover:translate-x-1" />
    </a>
  </div>
  <div class="md:col-span-7 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 gap-px bg-outline-soft border-t sm:border border-outline-soft md:border-x-0 md:self-start">
    {national.membership.benefits.map((benefit) => (
      <div class="bg-bg py-5 sm:p-7 md:px-0 md:py-5 md:grid md:grid-cols-[11rem_1fr] md:gap-x-8 md:items-baseline">
        <p class="font-mono text-sm text-accent tracking-wide uppercase mb-3 md:mb-0">{benefit.name}</p>
        <p class="text-ink text-sm leading-relaxed">{benefit.description}</p>
      </div>
    ))}
  </div>
</section>

<!-- CTA -->
<CtaBand
  heading={`Join the national <em class="font-serif italic font-normal lowercase tracking-normal text-accent">familia</em>.`}
  body="The BU chapter is your home base — national membership plugs it into chapters, conventions, and careers across the country."
  primaryCta={{ label: "Join SHPE Nationals", href: national.membership.joinUrl }}
  secondaryCta={{ label: "Back to about", href: "/about" }}
/>
