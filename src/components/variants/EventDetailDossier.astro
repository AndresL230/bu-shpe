---
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import CtaBand from "@/components/CtaBand.astro";
import Gallery from "@/components/Gallery.astro";

import siteData from "@/data/site.json";

import type { EventItem } from "@/types";
import { formatEventStamp } from "@/lib/events";

interface Props {
  event: EventItem;
  displayDate: string;
  upcoming: boolean;
  /** Extra photos beyond the cover (event_photos table). */
  photos?: { url: string }[];
}

const { event, upcoming, photos = [] } = Astro.props as Props;
const roll = photos.map((p, i) => ({ src: p.url, alt: `${event.title}, photo ${i + 2}` }));

const copy = event.body ?? event.description;
const paragraphs = copy.split(/\n\n+/).map((p) => p.trim()).filter(Boolean);

// Titles come from the database as written, so the headline renders them
// plain — no italic accent word (that lowercased proper nouns and words).
const statusLabel = upcoming ? "Upcoming event" : "Past event";
// Same stamp as the event cards ("15 OCT 2026"), so the date doesn't lose
// precision between the card and its page.
const metaLine = [formatEventStamp(event.date), event.location, event.category].filter(Boolean);
---

<!-- HERO -->
<header class="relative w-full bg-deep blueprint-deep py-16 md:py-28 px-6 overflow-hidden">
  <div class="max-w-[1152px] mx-auto relative z-10">
    <p class="font-mono text-cream/60 text-xs tracking-[0.14em] md:text-sm md:tracking-[0.18em] uppercase mb-5 text-balance">
      {statusLabel}
    </p>
    <h1 class="display text-5xl md:text-7xl text-cream leading-[1.02] max-w-3xl">{event.title}</h1>
    <!-- Date · location · category live on the Brief row just below. -->
    <!-- Phones: without a body the Brief repeats this description verbatim, so show it once -->
    <p class:list={["mt-6 text-cream/80 max-w-xl text-lg", !event.body && "hidden md:block"]}>{event.description}</p>
  </div>
</header>

<!-- 01 — BRIEF : full-width header + bounded two-column body (image beside copy) -->
<section class="py-16 md:py-24">
  <div class="max-w-[1200px] mx-auto px-6">

    <!-- Header — full container width -->
    <a
      href="/events"
      class="group inline-flex items-center gap-2 font-mono text-xs tracking-[0.12em] uppercase text-ink-muted hover:text-ink transition-colors min-h-11 -mt-3 mb-7 md:min-h-0 md:mt-0 md:mb-10"
    >
      <span aria-hidden="true" class="transition-transform group-hover:-translate-x-1">←</span>
      <span class="border-b border-transparent max-md:border-current group-hover:border-current pb-0.5">Back to the calendar</span>
    </a>

    <!-- The hero headline sits just above, so the title isn't repeated here.
         md+: one ruled row, label left, date · location · category right. -->
    <div class:list={["md:flex md:items-baseline md:justify-between md:gap-8 md:border-b md:border-outline-soft md:pb-4", (event.photo || event.body) && "md:mb-10"]}>
      <div class="md:hidden"><SectionIndex index="01" label="Brief" /></div>
      <div class="hidden md:block"><SectionIndex label="Brief" /></div>

      <!-- Phones: one item per line, no separators, so nothing orphans -->
      <p class="font-mono text-sm tracking-[0.12em] uppercase mt-4 mb-8 max-sm:flex max-sm:flex-col max-sm:gap-y-1 md:my-0 md:text-right">
        {metaLine.map((part, i) => (
          <span class={i === 0 ? "text-accent" : "text-ink-muted"}>
            {i > 0 && <span class="text-ink-muted max-sm:hidden"> · </span>}{part}
          </span>
        ))}
      </p>
    </div>

    <!-- Two-column body grid: figure left, body right (mirrors classic) -->
    <div class={`grid grid-cols-1 ${event.photo ? "lg:grid-cols-[1.4fr_1fr]" : ""} gap-10 lg:gap-14 items-center lg:items-start`}>

      {event.photo && (
        <!-- Image framing: tweak aspect ratio + object-position per event if needed -->
        <figure class="aspect-[3/2] overflow-hidden border border-outline-soft photo-warm">
          <img
            src={event.photo}
            alt={event.title}
            class="h-full w-full object-cover object-[50%_40%]"
          />
        </figure>
      )}

      <!-- md+: with no body and no photo, this would only repeat the hero description -->
      <div class:list={[!event.photo && "max-w-2xl", !event.photo && !event.body && "md:hidden"]}>
        {paragraphs.map((p) => (
          <p class="text-lg text-ink-muted leading-relaxed mb-6 last:mb-0">{p}</p>
        ))}
      </div>

    </div>

  </div>
</section>

{roll.length > 0 && (
  <!-- 02 — PHOTO ROLL : extra photos from the event, lightbox via Gallery -->
  <section class="max-w-[1200px] mx-auto px-6 pb-16 md:pb-28">
    <div class="flex items-end justify-between gap-6 mb-8">
      <div class="md:hidden"><SectionIndex index="02" label="Photo Roll" /></div>
      <div class="hidden md:block"><SectionIndex label="Photo Roll" /></div>
      <p class="font-mono text-xs uppercase tracking-[0.14em] text-ink-muted">{roll.length + (event.photo ? 1 : 0)} frames</p>
    </div>
    <Gallery photos={roll} />
  </section>
)}

<!-- CTA -->
<CtaBand
  heading={`Don't miss the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">next one</em>.`}
  body="The mailing list is how members hear about workshops, mixers, and conference travel."
  primaryCta={{ label: "Join the mailing list", href: "/join" }}
  secondaryCta={{ label: "Follow on Instagram", href: siteData.socials.instagram }}
/>
