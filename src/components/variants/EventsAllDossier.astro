---
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import CtaBand from "@/components/CtaBand.astro";

import siteData from "@/data/site.json";
import eventsRaw from "@/data/events.json";

import type { EventItem } from "@/types";
import { eventSlug } from "@/lib/events";

const events = eventsRaw as EventItem[];

const today = new Date().toISOString().slice(0, 7);

const categories = [...new Set(events.map((e) => e.category))];

const upcoming = events
  .filter((e) => e.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date));

const past = events
  .filter((e) => e.date < today)
  .sort((a, b) => b.date.localeCompare(a.date));

const totalCount = events.length;

const monthNames = [
  "JAN", "FEB", "MAR", "APR", "MAY", "JUN",
  "JUL", "AUG", "SEP", "OCT", "NOV", "DEC",
];

function formatDate(iso: string): string {
  const [y, m, d] = iso.split("-");
  const monthIdx = parseInt(m, 10) - 1;
  const month = monthNames[monthIdx] ?? "—";
  if (d) return `${d} ${month}`;
  return `${month} ${y.slice(2)}`;
}

const chipBase = "inline-flex items-center font-mono text-xs uppercase tracking-[0.14em] px-4 py-2 border transition-colors";
const chipInactive = "border-outline-soft text-ink-muted hover:border-ink hover:text-ink";
---

<!-- HERO -->
<header class="relative w-full bg-deep blueprint-deep py-24 md:py-32 px-6 overflow-hidden">
  <div class="max-w-[1200px] mx-auto relative z-10">
    <p class="font-mono text-cream/60 text-sm tracking-[0.18em] uppercase mb-5">Chapter Calendar · {totalCount} on record</p>
    <h1 class="display text-5xl md:text-7xl text-cream leading-[1.02] max-w-3xl">
      The whole <em class="font-serif italic font-normal lowercase tracking-normal text-accent">season</em>.
    </h1>
    <p class="mt-7 text-cream/80 max-w-xl text-lg">
      The full chapter calendar — every workshop, mixer, and trip. {totalCount} {totalCount === 1 ? "event" : "events"} on record.
    </p>
  </div>
</header>

<!-- CONTENT: filter + upcoming + past -->
<section id="all-events-content-d" class="max-w-[1200px] mx-auto px-6 py-20 md:py-28">

  <!-- Top row: back link + mono filter chips -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-12">
    <a
      href="/events"
      class="group inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-ink-muted hover:text-ink transition-colors self-start"
    >
      <span aria-hidden="true">←</span>
      <span class="border-b border-current pb-0.5">Back to events</span>
    </a>
    <div class="flex flex-wrap gap-2 items-center md:justify-end">
      <span class="font-mono text-xs uppercase tracking-[0.14em] text-ink-muted mr-2">Filter</span>

      <a
        data-chip-d
        data-chip-value=""
        href="/events/all"
        class:list={[chipBase, chipInactive]}
      >
        All
      </a>

      {categories.map((cat) => (
        <a
          data-chip-d
          data-chip-value={cat}
          href={`/events/all?cat=${encodeURIComponent(cat)}`}
          class:list={[chipBase, chipInactive]}
        >
          {cat}
        </a>
      ))}
    </div>
  </div>

  <!-- Empty state (JS toggles visibility) -->
  <p data-empty-state-d hidden class="text-ink-muted italic text-center py-16">No events match this filter.</p>

  {/* Upcoming */}
  {upcoming.length > 0 && (
    <div data-section-d="upcoming" class="mb-20 md:mb-28">
      <div class="flex items-center justify-between mb-10 border-b border-outline-soft pb-6">
        <div>
          <SectionIndex label="Upcoming" />
          <h2 class="display text-3xl md:text-4xl text-ink mt-5">On the calendar.</h2>
        </div>
        <p class="font-mono text-sm text-ink-muted tracking-wide uppercase" data-count-d>{upcoming.length} {upcoming.length === 1 ? "event" : "events"}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-outline-soft border border-outline-soft">
        {upcoming.map((event) => (
          <a data-event-d data-category={event.category} href={`/events/${eventSlug(event.title)}`} class="group flex flex-col bg-bg p-6">
            <div class="aspect-[4/3] overflow-hidden bg-surface-soft mb-5">
              {event.photo && (
                <img
                  src={event.photo}
                  alt={event.title}
                  class="w-full h-full object-cover transition group-hover:scale-[1.02]"
                  loading="lazy"
                />
              )}
            </div>
            <div class="flex items-baseline gap-3 mb-3">
              <span class="font-mono text-sm text-accent tracking-wide uppercase tabular-nums">{formatDate(event.date)}</span>
              <span class="font-mono text-xs text-ink-muted tracking-[0.12em] uppercase">{event.category}</span>
            </div>
            <h3 class="display text-xl md:text-2xl text-ink mb-2 leading-tight group-hover:text-accent transition-colors">{event.title}</h3>
            <p class="text-sm text-ink-muted leading-relaxed">{event.description}</p>
          </a>
        ))}
      </div>
    </div>
  )}

  {/* Past */}
  {past.length > 0 && (
    <div data-section-d="past">
      <div class="flex items-center justify-between mb-10 border-b border-outline-soft pb-6">
        <div>
          <SectionIndex label="Past" />
          <h2 class="display text-3xl md:text-4xl text-ink mt-5">The record.</h2>
        </div>
        <p class="font-mono text-sm text-ink-muted tracking-wide uppercase" data-count-d>{past.length} {past.length === 1 ? "event" : "events"}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-outline-soft border border-outline-soft">
        {past.map((event) => (
          <a data-event-d data-category={event.category} href={`/events/${eventSlug(event.title)}`} class="group flex flex-col bg-bg p-6">
            <div class="aspect-[4/3] overflow-hidden bg-surface-soft mb-5">
              {event.photo && (
                <img
                  src={event.photo}
                  alt={event.title}
                  class="w-full h-full object-cover transition group-hover:scale-[1.02]"
                  loading="lazy"
                />
              )}
            </div>
            <div class="flex items-baseline gap-3 mb-3">
              <span class="font-mono text-sm text-accent tracking-wide uppercase tabular-nums">{formatDate(event.date)}</span>
              <span class="font-mono text-xs text-ink-muted tracking-[0.12em] uppercase">{event.category}</span>
            </div>
            <h3 class="display text-xl md:text-2xl text-ink mb-2 leading-tight group-hover:text-accent transition-colors">{event.title}</h3>
            <p class="text-sm text-ink-muted leading-relaxed">{event.description}</p>
          </a>
        ))}
      </div>
    </div>
  )}

</section>

<!-- CTA -->
<CtaBand
  heading={`Don't miss the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">next one</em>.`}
  body="The mailing list is how members hear about workshops, mixers, and conference travel."
  primaryCta={{ label: "Join the mailing list", href: "/join" }}
  secondaryCta={{ label: "Follow on Instagram", href: siteData.socials.instagram }}
/>

<script is:inline>
  (function () {
    var root = document.getElementById("all-events-content-d");
    if (!root) return;

    var chips = root.querySelectorAll("[data-chip-d]");
    var events = root.querySelectorAll("[data-event-d]");
    var sections = root.querySelectorAll("[data-section-d]");
    var emptyState = root.querySelector("[data-empty-state-d]");

    var inactiveClasses = ["border-outline-soft", "text-ink-muted", "hover:border-ink", "hover:text-ink"];
    var activeClasses = ["bg-ink", "text-cream", "border-ink"];

    function setActive(value) {
      chips.forEach(function (chip) {
        var chipValue = chip.getAttribute("data-chip-value") || "";
        if (chipValue === value) {
          inactiveClasses.forEach(function (c) { chip.classList.remove(c); });
          activeClasses.forEach(function (c) { chip.classList.add(c); });
          chip.setAttribute("aria-current", "true");
        } else {
          activeClasses.forEach(function (c) { chip.classList.remove(c); });
          inactiveClasses.forEach(function (c) { chip.classList.add(c); });
          chip.removeAttribute("aria-current");
        }
      });
    }

    function applyFilter(cat) {
      cat = cat || "";
      setActive(cat);
      events.forEach(function (el) {
        var matches = !cat || el.getAttribute("data-category") === cat;
        el.hidden = !matches;
      });
      sections.forEach(function (section) {
        var visible = Array.prototype.filter.call(
          section.querySelectorAll("[data-event-d]"),
          function (el) { return !el.hidden; }
        );
        section.hidden = visible.length === 0;
        var countEl = section.querySelector("[data-count-d]");
        if (countEl) {
          countEl.textContent = visible.length + " " + (visible.length === 1 ? "event" : "events");
        }
      });
      if (emptyState) {
        var anyVisible = Array.prototype.some.call(events, function (el) { return !el.hidden; });
        emptyState.hidden = anyVisible;
      }
    }

    var params = new URLSearchParams(location.search);
    applyFilter(params.get("cat"));

    chips.forEach(function (chip) {
      chip.addEventListener("click", function (e) {
        e.preventDefault();
        var value = chip.getAttribute("data-chip-value") || "";
        var url = value
          ? location.pathname + "?cat=" + encodeURIComponent(value)
          : location.pathname;
        history.pushState({}, "", url);
        applyFilter(value);
      });
    });

    window.addEventListener("popstate", function () {
      var p = new URLSearchParams(location.search);
      applyFilter(p.get("cat"));
    });
  })();
</script>
