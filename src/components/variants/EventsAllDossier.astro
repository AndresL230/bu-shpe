---
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import CtaBand from "@/components/CtaBand.astro";

import siteData from "@/data/site.json";

import EventPhotoFallback from "@/components/EventPhotoFallback.astro";
import type { EventRecord } from "@/lib/server/events";
import { academicYear, formatEventStamp } from "@/lib/events";

interface Props {
  events: EventRecord[];
}

const { events } = Astro.props;

const today = new Date().toISOString().slice(0, 7);

const categories = [...new Set(events.map((e) => e.category))];

const upcoming = events
  .filter((e) => e.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date));

const past = events
  .filter((e) => e.date < today)
  .sort((a, b) => b.date.localeCompare(a.date));

const totalCount = events.length;

// Past events, grouped by academic year (Aug–Jul), newest year first. Only the
// most recent year starts open — the current one whenever it has events.
// `past` is already newest-first, so groups and their rows come out in order.
const pastByYear: { label: string; events: EventRecord[] }[] = [];
for (const e of past) {
  const { label } = academicYear(e.date);
  const last = pastByYear.at(-1);
  if (last?.label === label) last.events.push(e);
  else pastByYear.push({ label, events: [e] });
}

// Backfilled events carry a generated placeholder summary
// ("From the chapter attendance records · Fall 2024."); rows skip it.
const FILLER_SUMMARY = /^From the chapter (attendance records|photo archive) · /;
const summaryOf = (e: EventRecord) => (FILLER_SUMMARY.test(e.description) ? "" : e.description);

const chipBase = "snap-start inline-flex shrink-0 items-center whitespace-nowrap font-mono text-xs uppercase tracking-[0.14em] px-4 py-2 min-h-11 md:min-h-0 border transition-colors";
const chipInactive = "border-outline-soft text-ink-muted hover:border-ink hover:text-ink";
---

<!-- HERO -->
<header class="relative w-full bg-deep blueprint-deep py-16 md:py-32 px-6 overflow-hidden">
  <div class="max-w-[1200px] mx-auto relative z-10">
    <p class="font-mono text-cream/60 text-xs tracking-[0.14em] md:text-sm md:tracking-[0.18em] uppercase mb-5 text-balance">Chapter Calendar · {totalCount} on record</p>
    <h1 class="display text-5xl md:text-7xl text-cream leading-[1.02] max-w-3xl">
      The whole <em class="font-serif italic font-normal lowercase tracking-normal text-accent">season</em>.
    </h1>
    <p class="mt-7 text-cream/80 max-w-xl text-lg">
      The full chapter calendar — every workshop, mixer, and trip. {totalCount} {totalCount === 1 ? "event" : "events"} on record.
    </p>
  </div>
</header>

<!-- CONTENT: filter + upcoming + past -->
<section id="all-events-content-d" class="max-w-[1200px] mx-auto px-6 py-16 md:py-28">

  <!-- Top row: back link + mono filter chips -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-10 md:mb-12">
    <a
      href="/events"
      class="group inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-ink-muted hover:text-ink transition-colors self-start min-h-11 -my-3"
    >
      <span aria-hidden="true">←</span>
      <span class="border-b border-current pb-0.5">Back to events</span>
    </a>
    <!-- Phones: one row that scrolls sideways (the clipped next chip is the cue); md+: wraps, right-aligned -->
    <div class="flex flex-wrap gap-2 items-center md:justify-end max-md:flex-nowrap max-md:overflow-x-auto max-md:-mx-6 max-md:px-6 max-md:snap-x max-md:scroll-px-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <span class="hidden md:inline shrink-0 font-mono text-xs uppercase tracking-[0.14em] text-ink-muted mr-2">Filter</span>

      <a
        data-chip-d
        data-chip-value=""
        href="/events/all"
        class:list={[chipBase, chipInactive]}
      >
        All
      </a>

      {categories.map((cat) => (
        <a
          data-chip-d
          data-chip-value={cat}
          href={`/events/all?cat=${encodeURIComponent(cat)}`}
          class:list={[chipBase, chipInactive]}
        >
          {cat}
        </a>
      ))}
    </div>
  </div>

  <!-- Empty state (JS toggles visibility) -->
  <p data-empty-state-d hidden class="text-ink-muted italic text-center py-16">No events match this filter.</p>

  {/* Upcoming */}
  {upcoming.length > 0 && (
    <div data-section-d="upcoming" class="mb-16 md:mb-28">
      <div class="flex items-end justify-between gap-4 mb-8 border-b border-outline-soft pb-6 md:mb-10 md:items-center">
        <div>
          <SectionIndex label="Upcoming" />
          <h2 class="display text-3xl md:text-4xl text-ink mt-5">On the calendar.</h2>
        </div>
        <p class="font-mono text-sm text-ink-muted tracking-wide uppercase" data-count-d>{upcoming.length} {upcoming.length === 1 ? "event" : "events"}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-outline-soft border-y border-outline-soft sm:border">
        {upcoming.map((event) => (
          <a data-event-d data-category={event.category} href={`/events/${event.slug}`} class="group flex flex-row gap-4 bg-bg py-4 sm:flex-col sm:gap-0 sm:p-6">
            {/* Phones: no thumbnail slot for photo-less events — the fallback only repeats the category */}
            <div class:list={["w-20 shrink-0 self-start aspect-square overflow-hidden bg-surface-soft sm:w-auto sm:self-auto sm:aspect-[4/3] sm:mb-5", !event.photo && "hidden sm:block"]}>
              {event.photo ? (
                <img
                  src={event.photo}
                  alt={event.title}
                  class="w-full h-full object-cover transition group-hover:scale-[1.02]"
                  loading="lazy"
                />
              ) : (
                <EventPhotoFallback label={event.category} tone="dossier" />
              )}
            </div>
            <div class="min-w-0">
              <div class="flex flex-wrap items-baseline gap-x-3 mb-1 sm:mb-3">
                <span class="font-mono text-sm text-accent tracking-wide uppercase tabular-nums">{formatEventStamp(event.date)}</span>
                <span class="font-mono text-xs text-ink-muted tracking-[0.12em] uppercase">{event.category}</span>
              </div>
              <h3 class="display text-xl md:text-2xl text-ink leading-tight group-hover:text-accent transition-colors">{event.title}</h3>
              {summaryOf(event) && <p class="mt-2 text-sm text-ink-muted leading-relaxed line-clamp-2 sm:line-clamp-none">{summaryOf(event)}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  )}

  {/* Past — one collapsible group per academic year */}
  {past.length > 0 && (
    <div data-section-d="past">
      <div class="flex items-end justify-between gap-4 border-b border-outline-soft pb-6 md:items-center">
        <div>
          <SectionIndex label="Past" />
          <h2 class="display text-3xl md:text-4xl text-ink mt-5">The record.</h2>
        </div>
        <p class="font-mono text-sm text-ink-muted tracking-wide uppercase" data-count-d>{past.length} {past.length === 1 ? "event" : "events"}</p>
      </div>

      {pastByYear.map((group, gi) => (
        <details data-group-d open={gi === 0} class="group/ay border-b border-outline-soft">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 md:py-6 [&::-webkit-details-marker]:hidden">
            <span class="display text-2xl md:text-4xl text-ink leading-none transition-colors group-hover/ay:text-accent">{group.label}</span>
            <span class="flex items-center gap-4 font-mono text-xs md:text-sm uppercase tracking-[0.14em] text-ink-muted">
              <span data-group-count-d>{group.events.length} {group.events.length === 1 ? "event" : "events"}</span>
              <span aria-hidden="true" class="w-4 text-center text-lg leading-none text-accent transition-transform group-open/ay:rotate-45">+</span>
            </span>
          </summary>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-outline-soft border-t border-outline-soft sm:border sm:mb-10 md:mb-12">
            {group.events.map((event) => (
              <a data-event-d data-category={event.category} href={`/events/${event.slug}`} class="group flex flex-row gap-4 bg-bg py-4 sm:flex-col sm:gap-0 sm:p-6">
                {/* Phones: no thumbnail slot for photo-less events — the fallback only repeats the category */}
                <div class:list={["w-20 shrink-0 self-start aspect-square overflow-hidden bg-surface-soft sm:w-auto sm:self-auto sm:aspect-[4/3] sm:mb-5", !event.photo && "hidden sm:block"]}>
                  {event.photo ? (
                    <img
                      src={event.photo}
                      alt={event.title}
                      class="w-full h-full object-cover transition group-hover:scale-[1.02]"
                      loading="lazy"
                    />
                  ) : (
                    <EventPhotoFallback label={event.category} tone="dossier" />
                  )}
                </div>
                <div class="min-w-0">
                  <div class="flex flex-wrap items-baseline gap-x-3 mb-1 sm:mb-3">
                    <span class="font-mono text-sm text-accent tracking-wide uppercase tabular-nums">{formatEventStamp(event.date)}</span>
                    <span class="font-mono text-xs text-ink-muted tracking-[0.12em] uppercase">{event.category}</span>
                  </div>
                  <h3 class="display text-xl md:text-2xl text-ink leading-tight group-hover:text-accent transition-colors">{event.title}</h3>
                  {summaryOf(event) && <p class="mt-2 text-sm text-ink-muted leading-relaxed line-clamp-2 sm:line-clamp-none">{summaryOf(event)}</p>}
                </div>
              </a>
            ))}
          </div>
        </details>
      ))}
    </div>
  )}

</section>

<!-- CTA -->
<CtaBand
  heading={`Don't miss the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">next one</em>.`}
  body="The mailing list is how members hear about workshops, mixers, and conference travel."
  primaryCta={{ label: "Join the mailing list", href: "/join" }}
  secondaryCta={{ label: "Follow on Instagram", href: siteData.socials.instagram }}
/>

<script is:inline>
  (function () {
    var root = document.getElementById("all-events-content-d");
    if (!root) return;

    var chips = root.querySelectorAll("[data-chip-d]");
    var events = root.querySelectorAll("[data-event-d]");
    var sections = root.querySelectorAll("[data-section-d]");
    var groups = root.querySelectorAll("[data-group-d]");
    var emptyState = root.querySelector("[data-empty-state-d]");

    var inactiveClasses = ["border-outline-soft", "text-ink-muted", "hover:border-ink", "hover:text-ink"];
    var activeClasses = ["bg-ink", "text-cream", "border-ink"];

    function setActive(value) {
      chips.forEach(function (chip) {
        var chipValue = chip.getAttribute("data-chip-value") || "";
        if (chipValue === value) {
          inactiveClasses.forEach(function (c) { chip.classList.remove(c); });
          activeClasses.forEach(function (c) { chip.classList.add(c); });
          chip.setAttribute("aria-current", "true");
        } else {
          activeClasses.forEach(function (c) { chip.classList.remove(c); });
          inactiveClasses.forEach(function (c) { chip.classList.add(c); });
          chip.removeAttribute("aria-current");
        }
      });
    }

    function applyFilter(cat) {
      cat = cat || "";
      setActive(cat);
      events.forEach(function (el) {
        var matches = !cat || el.getAttribute("data-category") === cat;
        el.hidden = !matches;
      });
      sections.forEach(function (section) {
        var visible = Array.prototype.filter.call(
          section.querySelectorAll("[data-event-d]"),
          function (el) { return !el.hidden; }
        );
        section.hidden = visible.length === 0;
        var countEl = section.querySelector("[data-count-d]");
        if (countEl) {
          countEl.textContent = visible.length + " " + (visible.length === 1 ? "event" : "events");
        }
      });
      var firstVisibleGroup = null;
      var anyGroupOpen = false;
      groups.forEach(function (group) {
        var n = Array.prototype.filter.call(
          group.querySelectorAll("[data-event-d]"),
          function (el) { return !el.hidden; }
        ).length;
        group.hidden = n === 0;
        var countEl = group.querySelector("[data-group-count-d]");
        if (countEl) countEl.textContent = n + " " + (n === 1 ? "event" : "events");
        if (n > 0) {
          if (!firstVisibleGroup) firstVisibleGroup = group;
          if (group.open) anyGroupOpen = true;
        }
      });
      // A filter shouldn't leave every matching year collapsed.
      if (firstVisibleGroup && !anyGroupOpen) firstVisibleGroup.open = true;
      if (emptyState) {
        var anyVisible = Array.prototype.some.call(events, function (el) { return !el.hidden; });
        emptyState.hidden = anyVisible;
      }
    }

    var params = new URLSearchParams(location.search);
    applyFilter(params.get("cat"));

    chips.forEach(function (chip) {
      chip.addEventListener("click", function (e) {
        e.preventDefault();
        var value = chip.getAttribute("data-chip-value") || "";
        var url = value
          ? location.pathname + "?cat=" + encodeURIComponent(value)
          : location.pathname;
        history.pushState({}, "", url);
        applyFilter(value);
      });
    });

    window.addEventListener("popstate", function () {
      var p = new URLSearchParams(location.search);
      applyFilter(p.get("cat"));
    });
  })();
</script>
