---
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import Icon from "@/components/Icon.astro";
import CtaBand from "@/components/CtaBand.astro";

import siteData from "@/data/site.json";

import EventPhotoFallback from "@/components/EventPhotoFallback.astro";
import type { EventRecord } from "@/lib/server/events";
import { formatEventStamp } from "@/lib/events";

interface Props {
  events: EventRecord[];
}

const { events } = Astro.props;

const today = new Date().toISOString().slice(0, 7); // yyyy-mm
const currentYear = new Date().getFullYear();

const upcoming = events
  .filter((e) => e.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date));

const past = events
  .filter((e) => e.date < today)
  .sort((a, b) => b.date.localeCompare(a.date));

const monthNames = [
  "JAN", "FEB", "MAR", "APR", "MAY", "JUN",
  "JUL", "AUG", "SEP", "OCT", "NOV", "DEC",
];

// Oversized date for the "Next Up" feature: big month over a day·year sub-line.
function bigDate(iso: string): { month: string; sub: string } {
  const [y, m, d] = iso.split("-");
  const month = monthNames[parseInt(m, 10) - 1] ?? "—";
  return { month, sub: d ? `${parseInt(d, 10)} · ${y}` : y };
}

const nextUp = upcoming[0];
const restUpcoming = upcoming.slice(1);

// Archive mosaic: the 6 most-recent past events that have a photo, tiled
// asymmetrically. A photo-less tile reads as a broken image, so those only top
// the mosaic up (with the typographic fallback) when fewer than 6 have photos.
// md+: a 3-col grid, big 2×2 lead then five singles — a clean 3×3 rectangle in
// which every tile shares one landscape aspect (no letterbox-thin wides).
// Phones (2-col): the first and last tiles run full width (single height, so a
// landscape photo isn't cropped to a portrait), and the four between pair up.
const MOSAIC_SIZE = 6;
const withPhoto = past.filter((e) => e.photo);
const recordTiles = [...withPhoto, ...past.filter((e) => !e.photo)].slice(0, MOSAIC_SIZE);
const mosaicSpans = [
  "col-span-2 row-span-2 max-sm:row-span-1",
  "",
  "",
  "",
  "",
  "col-span-2 md:col-span-1",
];
// Group shots put people in the lower-middle of the frame; on the big lead tile
// the default centre crop keeps the ceiling and loses feet under the caption.
const mosaicFocus = ["md:object-[center_65%]", "", "", "", "", ""];
---

<!-- HERO -->
<header class="relative w-full bg-deep blueprint-deep py-16 md:py-28 px-6 overflow-hidden">
  <div class="max-w-[1152px] mx-auto relative z-10">
    <p class="font-mono text-cream/60 text-xs tracking-[0.14em] md:text-sm md:tracking-[0.18em] uppercase mb-5 text-balance">Chapter Calendar · {currentYear}</p>
    <h1 class="display text-5xl md:text-7xl text-cream leading-[1.02] max-w-3xl">
      Events &amp; <em class="font-serif italic font-normal lowercase tracking-normal text-accent">opportunities</em>.
    </h1>
    <p class="mt-7 text-cream/80 max-w-xl text-lg">
      From professional development workshops to community building socials, discover how BU SHPE empowers Hispanic STEM students to reach their full potential.
    </p>
  </div>

  <!-- Decorative year watermark -->
</header>

<!-- 01 — UPCOMING -->
<!-- md+ with nothing scheduled: the whole section collapses to one ruled strip -->
<section class:list={["max-w-[1200px] mx-auto px-6 py-16 md:py-28", !nextUp && "md:pt-16 md:pb-0"]}>
  <div class:list={["grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 md:items-end", !nextUp && "md:hidden"]}>
    <div class="md:col-span-8">
      <SectionIndex label="Upcoming" />
      <h2 class="display text-3xl md:text-4xl text-ink mt-5 max-w-2xl">What's on the docket.</h2>
      <p class="mt-4 text-ink-muted max-w-md">
        The next stops on the chapter's schedule, in chronological order. Subscribe and it syncs straight to your phone.
      </p>
    </div>
    <div class="md:col-span-4 md:text-right">
      <a
        href={siteData.calendarEmbedUrl}
        target="_blank"
        rel="noopener"
        class="group inline-flex items-center gap-2 font-mono text-sm text-accent tracking-wide uppercase hover:text-ink transition-colors min-h-11 -my-3 md:min-h-0 md:my-0 md:font-sans md:text-base md:font-medium md:normal-case md:tracking-normal md:text-ink md:hover:text-accent"
      >
        <span class="border-b border-current pb-0.5">Subscribe to calendar<span class="md:hidden"> →</span></span>
        <Icon name="arrow-forward" class="hidden md:block w-4 h-4 transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>

  {upcoming.length === 0 ? (
    <>
      <p class="mt-10 text-ink-muted italic md:hidden">Nothing scheduled right now — subscribe to the calendar for updates.</p>
      <div class="hidden md:flex md:items-baseline md:justify-between md:gap-8 border-y border-outline-soft py-6">
        <div class="flex items-baseline gap-6">
          <SectionIndex label="Upcoming" />
          <p class="text-ink-muted italic">Nothing scheduled right now — subscribe to the calendar for updates.</p>
        </div>
        <a
          href={siteData.calendarEmbedUrl}
          target="_blank"
          rel="noopener"
          class="group inline-flex shrink-0 items-center gap-2 font-sans text-base font-medium text-ink hover:text-accent transition-colors"
        >
          <span class="border-b border-current pb-0.5">Subscribe to calendar</span>
          <Icon name="arrow-forward" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
        </a>
      </div>
    </>
  ) : (
    <div class="mt-10 md:mt-12">
      <!-- Next Up — featured -->
      <a
        href={`/events/${nextUp.slug}`}
        class="group grid grid-cols-1 lg:grid-cols-12 border border-outline-soft bg-bg overflow-hidden"
      >
        <div class="lg:col-span-7 relative aspect-[16/9] lg:aspect-auto lg:min-h-[340px] overflow-hidden photo-warm bg-surface-soft">
          {nextUp.photo ? (
            <img
              src={nextUp.photo}
              alt={nextUp.title}
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="eager"
            />
          ) : (
            <EventPhotoFallback label={nextUp.category} tone="dossier" class="absolute inset-0" />
          )}
          <span class="mono-label absolute left-0 top-0 z-10 bg-accent px-3 py-1.5 text-white">
            Next Up
          </span>
        </div>
        <div class="lg:col-span-5 flex flex-col justify-between border-t border-outline-soft p-7 md:p-9 lg:border-l lg:border-t-0">
          <div>
            <p class="display text-5xl md:text-6xl leading-[0.9] text-ink">
              {bigDate(nextUp.date).month} <span class="text-ink-muted">{bigDate(nextUp.date).sub}</span>
            </p>
            <p class="mono-label mt-5 text-accent">{nextUp.category}</p>
            <h3 class="display text-3xl text-ink mt-3 leading-tight transition-colors group-hover:text-accent">{nextUp.title}</h3>
            <p class="mt-3 text-ink-muted leading-relaxed">{nextUp.description}</p>
          </div>
          <span class="mt-8 inline-flex items-center gap-2 font-mono text-sm tracking-wide uppercase text-accent md:font-sans md:text-base md:font-medium md:normal-case md:tracking-normal md:text-ink md:group-hover:text-accent md:transition-colors">
            <span class="border-b border-current pb-0.5">View details<span class="md:hidden"> →</span></span>
            <Icon name="arrow-forward" class="hidden md:block w-4 h-4 transition-transform group-hover:translate-x-1" />
          </span>
        </div>
      </a>

      <!-- The rest of upcoming — 2-up, seamed under the feature -->
      {restUpcoming.length > 0 && (
        <div class="grid grid-cols-1 border-x border-b border-outline-soft sm:grid-cols-2 sm:[&>*:nth-child(2)]:border-l sm:[&>*:nth-child(2)]:border-outline-soft">
          {restUpcoming.map((event) => (
            <a
              href={`/events/${event.slug}`}
              class="group flex items-stretch bg-bg transition-colors hover:bg-surface-soft"
            >
              {event.photo && (
                <div class="relative w-28 shrink-0 overflow-hidden photo-warm bg-surface-soft sm:w-48">
                  <img
                    src={event.photo}
                    alt={event.title}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="min-w-0 flex flex-col p-5 sm:p-7 md:p-8">
                <p class="font-mono text-sm tracking-wide uppercase text-accent">{formatEventStamp(event.date)}</p>
                <p class="mono-label mt-1">{event.category}</p>
                <h3 class="display text-2xl text-ink mt-3 leading-tight transition-colors group-hover:text-accent">{event.title}</h3>
                <p class="mt-2 text-sm text-ink-muted leading-relaxed line-clamp-2">{event.description}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  )}
</section>

<div class:list={["max-w-[1200px] mx-auto px-6", !nextUp && "md:hidden"]}><div class="border-t border-outline-soft"></div></div>

<!-- 02 — THE RECORD -->
<section class:list={["max-w-[1200px] mx-auto px-6 py-16 md:py-28", !nextUp && "md:pt-20"]}>
  <SectionIndex label="The Record" accent="scarlet" />
  <h2 class="display text-3xl md:text-4xl text-ink mt-5 max-w-2xl">Recently in the books.</h2>
  <p class="mt-4 text-ink-muted max-w-md">
    A look back at the chapter's most recent gatherings.
  </p>

  {past.length === 0 ? (
    <p class="mt-10 md:mt-12 text-ink-muted italic">The archive is just getting started.</p>
  ) : (
    <div class="mt-10 md:mt-12 grid grid-cols-2 auto-rows-[180px] max-sm:auto-rows-[200px] gap-px border border-outline-soft bg-outline-soft md:grid-cols-3 md:auto-rows-[240px]">
      {recordTiles.map((event, i) => (
        <a
          href={`/events/${event.slug}`}
          class:list={["group relative overflow-hidden bg-deep photo-warm", mosaicSpans[i]]}
        >
          {event.photo ? (
            <img
              src={event.photo}
              alt={event.title}
              class:list={["absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105", mosaicFocus[i]]}
              loading="lazy"
            />
          ) : (
            <EventPhotoFallback label={event.category} tone="dossier" class="absolute inset-0 bg-surface-soft" />
          )}
          <span class="mono-label absolute left-0 top-0 z-10 bg-deep px-3 py-1.5 text-cream">
            {formatEventStamp(event.date)}
          </span>
          <div class="absolute inset-x-0 bottom-0 z-10 bg-deep/85 px-3 py-2.5 sm:px-4 sm:py-3 md:right-auto md:max-w-[calc(100%-3rem)] md:bg-deep md:py-2">
            <p class="mono-label text-accent hidden sm:block">{event.category}</p>
            <h3 class="display text-base md:text-lg text-cream leading-tight sm:mt-0.5 line-clamp-2">{event.title}</h3>
          </div>
        </a>
      ))}
    </div>
  )}

  <div class="mt-10 md:mt-12">
    <a
      href="/events/all"
      class="group inline-flex items-center gap-2 font-mono text-sm text-accent tracking-wide uppercase hover:text-ink transition-colors min-h-11 -my-3 md:min-h-0 md:my-0 md:font-sans md:text-base md:font-medium md:normal-case md:tracking-normal md:text-ink md:hover:text-accent"
    >
      <span class="border-b border-current pb-0.5">See all events<span class="md:hidden"> →</span></span>
      <Icon name="arrow-forward" class="hidden md:block w-4 h-4 transition-transform group-hover:translate-x-1" />
    </a>
  </div>
</section>

<!-- CTA -->
<CtaBand
  heading={`Don't miss a <em class="font-serif italic font-normal lowercase tracking-normal text-accent">beat</em>.`}
  body="Get a heads-up about workshops, mixers, and conference travel. We email maybe twice a month."
  primaryCta={{ label: "Join the mailing list", href: "/join" }}
  secondaryCta={{ label: "Follow on Instagram", href: siteData.socials.instagram }}
/>
