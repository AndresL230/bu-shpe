---
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import StatCountUp from "@/components/conferences/StatCountUp.astro";
import CtaBand from "@/components/CtaBand.astro";
import EmployerCell from "@/components/EmployerCell.astro";
import Icon from "@/components/Icon.astro";
import supportData from "@/data/support.json";
import siteData from "@/data/site.json";
import type { EmployerGroup } from "@/types";

interface Props {
  /** "Where SHPE takes us" employers by industry (D1). */
  employerGroups: EmployerGroup[];
}

const stats = supportData.stats;
const groups = Astro.props.employerGroups;

interface PathRow {
  number: string;
  title: string;
  descriptor: string;
  href: string;
  cta: string;
}

const paths: PathRow[] = [
  {
    number: "01",
    title: "Corporate Partners",
    descriptor:
      "Sponsor the chapter and recruit top Hispanic STEM talent at our events and the SHPE National Convention.",
    href: "/support/corporate",
    cta: "Partner with us",
  },
  {
    number: "02",
    title: "Individual Giving",
    descriptor:
      "Alumni, parents, and friends: fund the trips, workshops, and experiences that move students forward.",
    href: "/support/individual",
    cta: "Give to the chapter",
  },
];

---

<!-- HERO -->
<header class="relative w-full bg-deep blueprint-deep py-16 md:py-28 px-6 overflow-hidden">
  <div class="max-w-[1152px] mx-auto relative z-10">
    <p class="font-mono text-cream/60 text-xs tracking-[0.14em] md:text-sm md:tracking-[0.18em] uppercase mb-5">Boston University<span class="max-md:hidden"> ·</span> <span class="whitespace-nowrap max-md:block">Backers &amp; Benefactors</span></p>
    <h1 class="display text-5xl md:text-7xl text-cream leading-[1.02] max-w-3xl max-md:text-balance">
      The people behind the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">mission</em>.
    </h1>
    <p class="mt-7 text-cream/80 max-w-xl text-lg">
      Every workshop, trip, and open door starts with someone choosing to invest in Hispanic engineers at Boston University.
    </p>
  </div>

  <!-- Decorative watermark -->
</header>

<!-- 01 — THE LEDGER -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28 grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12">
  <div class="lg:col-span-5">
    <SectionIndex label="The Ledger" />
    <h2 class="display text-3xl md:text-4xl text-ink mt-5">Support is how a chapter thrives.</h2>
    <p class="mt-4 text-ink-muted max-w-md">
      BU SHPE exists because people show up with funding, mentorship, open doors, and belief in what this community can become — alongside the BU College of Engineering and the Student Activities Office.
    </p>
  </div>
  <div class="lg:col-span-7 lg:pt-2">
    <div class="grid grid-cols-1 sm:grid-cols-3 border-t border-outline-soft sm:divide-x sm:divide-outline-soft max-sm:divide-y max-sm:divide-outline-soft">
      {stats.map((s) => (
        <div class="py-6 sm:px-7 sm:first:pl-0 max-sm:py-4 max-sm:[&>div]:flex max-sm:[&>div]:items-center max-sm:[&>div]:gap-5 max-sm:[&_[data-countup]]:w-24 max-sm:[&_[data-countup]]:shrink-0 max-sm:[&_.mono-label]:mt-0">
          <StatCountUp value={s.value} label={s.label} />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 02 — SUPPORT PATHS -->
<section class="max-w-[1200px] mx-auto px-6 pb-4 md:pb-0">
  <SectionIndex label="Support Paths" />
  <h2 class="display text-3xl md:text-4xl text-ink mt-5 max-w-2xl">Two ways to invest in the familia.</h2>

  <!-- Two cards: white on the off-white page, an accent bar on top -->
  <div class="mt-8 md:mt-12 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6">
    {paths.map((p) => (
      <a
        href={p.href}
        class="group relative flex flex-col bg-surface border border-outline-soft p-7 transition-colors hover:border-accent md:p-10"
      >
        <span class="absolute inset-x-0 top-0 h-[3px] bg-accent" aria-hidden="true"></span>
        <span class="font-mono text-sm tracking-wide text-accent">{p.number}</span>
        <h3 class="display mt-4 text-3xl leading-none text-ink transition-colors group-hover:text-accent md:mt-6 md:text-4xl">
          {p.title}
        </h3>
        <p class="mt-4 flex-grow leading-relaxed text-ink-muted md:max-w-md">{p.descriptor}</p>
        <span class="mt-8 inline-flex min-h-11 items-center gap-2 font-mono text-sm uppercase tracking-[0.12em] text-accent md:min-h-0">
          {p.cta}
          <Icon name="arrow-forward" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
        </span>
      </a>
    ))}
  </div>
</section>

<!-- 03 — WHERE SHPE TAKES US -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28">
  <SectionIndex label="Destinations" />
  <h2 class="display text-3xl md:text-4xl text-ink mt-5 max-w-2xl">Where SHPE takes us.</h2>
  <p class="mt-4 text-ink-muted max-w-2xl">
    BU SHPE members and alumni have gone on to work at companies shaping the future of engineering, technology, and science.
  </p>

  <div class="md:mt-12 md:border-t md:border-outline-soft">
  {groups.map((group) => (
    <div class="mt-10 md:mt-0 md:grid md:grid-cols-12 md:items-center md:gap-x-8 md:border-b md:border-outline-soft md:py-4">
      <p class="font-mono text-sm text-ink-muted tracking-wide uppercase mb-4 md:mb-0 md:col-span-3">{group.industry}</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 border-l border-t border-outline-soft md:col-span-9 md:grid-cols-5 md:border-0">
        {group.companies.map((company) => <EmployerCell company={company} variant="support" />)}
      </div>
    </div>
  ))}
  </div>
</section>

<!-- CTA -->
<CtaBand
  eyebrow="GET IN TOUCH"
  heading={`Be part of the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">familia</em>.`}
  body="From sponsors and alumni to faculty and friends, every kind of support moves this chapter forward. Tell us how you'd like to show up."
  primaryCta={{ label: "Email the chapter", href: `mailto:${siteData.contactEmail}` }}
  secondaryCta={{ label: "Follow on Instagram", href: siteData.socials.instagram }}
/>

