---
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import StatCountUp from "@/components/conferences/StatCountUp.astro";
import CtaBand from "@/components/CtaBand.astro";
import supportData from "@/data/support.json";
import siteData from "@/data/site.json";
import employersData from "@/data/employers.json";
import type { EmployerGroup } from "@/types";

const stats = supportData.stats;
const groups = employersData as EmployerGroup[];

interface PathRow {
  number: string;
  title: string;
  descriptor: string;
  href: string;
}

const paths: PathRow[] = [
  {
    number: "01",
    title: "Corporate Partners",
    descriptor:
      "Sponsor the chapter and recruit top Hispanic STEM talent at our events and the SHPE National Convention.",
    href: "/support/corporate",
  },
  {
    number: "02",
    title: "Individual Giving",
    descriptor:
      "Alumni, parents, and friends: fund the trips, workshops, and experiences that move students forward.",
    href: "/support/individual",
  },
];

// Same logo resolution strategy as EmployersSection, kept dossier-local so the
// fallback script below can scope itself to the .employer-logo-d class.
// (Don't write the literal script tag in this comment — vite's dep scanner
// does a raw-text scan and chokes on it.)
const logoSrc = (c: { domain?: string; logo?: string }) =>
  c.logo ?? (c.domain ? `https://unavatar.io/${c.domain}?fallback=false` : "");
const faviconSrc = (domain?: string) =>
  domain ? `https://www.google.com/s2/favicons?sz=128&domain=${domain}` : "";
---

<!-- HERO -->
<header class="relative w-full bg-deep blueprint-deep py-24 md:py-32 px-6 overflow-hidden">
  <div class="max-w-[1200px] mx-auto relative z-10">
    <p class="font-mono text-cream/60 text-sm tracking-[0.18em] uppercase mb-5">Boston University · Backers &amp; Benefactors</p>
    <h1 class="display text-5xl md:text-7xl text-cream leading-[1.02] max-w-3xl">
      The people behind the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">mission</em>.
    </h1>
    <p class="mt-7 text-cream/80 max-w-xl text-lg">
      Every workshop, trip, and open door starts with someone choosing to invest in Hispanic engineers at Boston University.
    </p>
  </div>

  <!-- Decorative watermark -->
  <div class="absolute right-0 bottom-0 opacity-10 pointer-events-none select-none hidden md:block">
    <span class="display text-[160px] lg:text-[220px] leading-none text-cream translate-y-1/4 inline-block">SHPE</span>
  </div>
</header>

<!-- 01 — THE LEDGER -->
<section class="max-w-[1200px] mx-auto px-6 py-20 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-12">
  <div class="md:col-span-5">
    <SectionIndex label="The Ledger" />
    <h2 class="display text-3xl md:text-4xl text-ink mt-5">Support is how a chapter thrives.</h2>
    <p class="mt-4 text-ink-muted max-w-md">
      BU SHPE exists because people show up with funding, mentorship, open doors, and belief in what this community can become — alongside the BU College of Engineering and the Student Activities Office.
    </p>
  </div>
  <div class="md:col-span-7 md:pt-2">
    <div class="grid grid-cols-1 sm:grid-cols-3 border-t border-outline-soft sm:divide-x sm:divide-outline-soft">
      {stats.map((s) => (
        <div class="py-6 sm:px-7 sm:first:pl-0">
          <StatCountUp value={s.value} label={s.label} />
        </div>
      ))}
    </div>
  </div>
</section>

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 02 — SUPPORT PATHS -->
<section class="max-w-[1200px] mx-auto px-6 py-20 md:py-28">
  <SectionIndex label="Support Paths" />
  <h2 class="display text-3xl md:text-4xl text-ink mt-5 max-w-2xl">Two ways to invest in the familia.</h2>

  <div class="mt-12 border-t border-outline-soft">
    {paths.map((p) => (
      <a
        href={p.href}
        class="group grid grid-cols-1 items-baseline gap-3 border-b border-outline-soft px-2 -mx-2 py-8 transition-colors hover:bg-surface-soft md:grid-cols-12 md:gap-8 md:py-10"
      >
        <span class="font-mono text-sm tracking-wide text-accent md:col-span-1">{p.number}</span>
        <h3 class="display text-3xl leading-none text-ink transition-colors group-hover:text-accent md:col-span-4 md:text-4xl">
          {p.title}
        </h3>
        <p class="leading-relaxed text-ink-muted md:col-span-6">{p.descriptor}</p>
        <span class="hidden text-accent md:col-span-1 md:flex md:justify-end" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</section>

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 03 — WHERE SHPE TAKES US -->
<section class="max-w-[1200px] mx-auto px-6 py-20 md:py-28">
  <SectionIndex label="Destinations" />
  <h2 class="display text-3xl md:text-4xl text-ink mt-5 max-w-2xl">Where SHPE takes us.</h2>
  <p class="mt-4 text-ink-muted max-w-2xl">
    BU SHPE members and alumni have gone on to work at companies shaping the future of engineering, technology, and science.
  </p>

  {groups.map((group) => (
    <div class="mt-12">
      <p class="font-mono text-sm text-ink-muted tracking-wide uppercase mb-5">{group.industry}</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-px bg-outline-soft border border-outline-soft">
        {group.companies.map((company) => (
          <div class="group flex aspect-[4/3] items-center justify-center bg-bg p-6 text-center transition-colors hover:bg-surface-soft">
            <img
              src={logoSrc(company)}
              data-fallback={faviconSrc(company.domain)}
              alt={company.name}
              loading="lazy"
              referrerpolicy="no-referrer"
              class="employer-logo-d max-h-16 w-auto max-w-[72%] object-contain transition-transform duration-300 group-hover:scale-105"
            />
            <span
              class="display text-base tracking-wide text-ink"
              style="display:none"
            >{company.name}</span>
          </div>
        ))}
      </div>
    </div>
  ))}
</section>

<!-- CTA -->
<CtaBand
  eyebrow="GET IN TOUCH"
  heading={`Be part of the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">familia</em>.`}
  body="From sponsors and alumni to faculty and friends, every kind of support moves this chapter forward. Tell us how you'd like to show up."
  primaryCta={{ label: "Email the chapter", href: `mailto:${siteData.contactEmail}` }}
  secondaryCta={{ label: "Follow on Instagram", href: siteData.socials.instagram }}
/>

<script is:inline>
  (function () {
    function fallback(img) {
      var fb = img.getAttribute("data-fallback");
      if (fb) {
        img.removeAttribute("data-fallback");
        img.src = fb;
      } else {
        img.style.display = "none";
        var label = img.nextElementSibling;
        if (label) label.style.display = "block";
      }
    }
    document.querySelectorAll("img.employer-logo-d").forEach(function (img) {
      img.addEventListener("error", function () { fallback(img); });
      if (img.complete && img.naturalWidth === 0) fallback(img);
    });
  })();
</script>
