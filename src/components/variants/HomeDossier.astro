---
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import CtaBand from "@/components/CtaBand.astro";
import SponsorGrid from "@/components/SponsorGrid.astro";

import { eventSlug } from "@/lib/events";

import siteData from "@/data/site.json";
import eventsRaw from "@/data/events.json";
import sponsorsRaw from "@/data/sponsors.json";

import type { EventItem, Sponsor } from "@/types";

const events = [...(eventsRaw as EventItem[])].sort((a, b) => b.date.localeCompare(a.date));
const recentEvents = events.slice(0, 3);

const sponsors = sponsorsRaw as Sponsor[];

const pillars = [
  {
    label: "Conferences",
    image: "/assets/conferences/national-convention-2023-slc.jpeg",
    imageAlt: "SHPE National Convention 2023 in Salt Lake City",
    body: "Every year, we take members to the SHPE National Convention — the largest Hispanic technical conference in the world. It's where résumés meet dream jobs.",
    points: ["Resume reviews", "Interview prep", "Career fairs"],
  },
  {
    label: "Volunteering",
    image: "/assets/volunteering/museum-of-science-1.jpeg",
    imageAlt: "BU SHPE volunteering at the Museum of Science",
    body: "Giving back is in our DNA. We mentor local high school students and run workshops to inspire the next generation to pursue careers in STEM.",
    points: ["K-12 outreach", "Local STEM fairs", "Chapter mentorship"],
  },
  {
    label: "Professional Development",
    image: "/assets/events/capital-one-workshop.jpg",
    imageAlt: "Capital One workshop",
    body: "From LinkedIn optimizations to technical workshops with industry partners, we ensure our members are ready for the workforce.",
    points: ["Corporate mixers", "Tech talks", "Soft-skills seminars"],
  },
];

const MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"] as const;

function formatEventDate(iso: string): string {
  // ISO is either "yyyy-mm" or "yyyy-mm-dd".
  const parts = iso.split("-");
  const year = parts[0];
  const monthIdx = Number(parts[1]) - 1;
  const month = MONTHS[monthIdx] ?? "";
  if (parts.length >= 3) {
    return `${parts[2].padStart(2, "0")} ${month}`;
  }
  const yy = year.slice(-2);
  return `${month} ${yy}`;
}
---

<!-- HERO — split: dossier text panel + campus photo -->
<header class="relative w-full bg-bg blueprint grid grid-cols-1 md:grid-cols-2 min-h-[calc(100vh-72px)] overflow-hidden">
  <!-- LEFT — text / CTA panel -->
  <div class="flex items-center px-6 md:px-12 lg:px-16 xl:px-24 py-16 md:py-12 relative z-10">
    <div class="max-w-[672px] w-full">
      <p class="font-mono text-ink-muted text-sm tracking-[0.18em] uppercase mb-5">Boston University · SHPE Region 4</p>
      <div class="w-8 h-[3px] bg-accent mb-6"></div>
      <h1 class="display text-5xl md:text-6xl lg:text-7xl text-ink leading-[1.02]">
        SHPE Boston University — building the next generation of Hispanic engineers, <em class="font-serif italic font-normal lowercase tracking-normal text-accent">together</em>.
      </h1>
      <p class="mt-7 text-ink-muted text-lg">¡Bienvenidos a la familia! {siteData.mission}</p>
      <div class="mt-9 flex flex-wrap items-center gap-6">
        <a
          href="/about"
          class="group inline-flex items-center gap-2 btn-dossier"
        >
          Explore Chapter
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/events"
          class="group inline-flex items-center gap-2 font-sans text-base font-medium text-ink transition-colors hover:text-accent"
        >
          <span class="border-b border-current pb-0.5">View Events</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>

  <!-- RIGHT — campus photo, dossier-framed -->
  <div class="relative flex flex-col px-6 pb-16 md:py-12 md:pr-12 lg:pr-16 xl:pr-24 md:pl-0">
    <div class="photo-warm relative w-full flex-1 min-h-[280px] overflow-hidden border border-outline-soft">
      <img
        src="/assets/campus/Boston-University-Center-For-Computing-Data-Sciences-Building-Located-Near-The-Charles-River-In-Boston-Massachusetts-USA.jpg"
        alt="The Charles River with BU's Center for Computing & Data Sciences and the Boston skyline"
        class="absolute inset-0 w-full h-full object-cover select-none"
        style="object-position: 65% center;"
        loading="eager"
        draggable="false"
      />
    </div>
  </div>
</header>

<!-- 01 — MISSION -->
<section class="max-w-[1200px] mx-auto px-6 py-20 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-12">
  <div class="md:col-span-5">
    <SectionIndex label="Mission" accent="scarlet" />
    <h2 class="display text-3xl md:text-4xl text-ink mt-5">Paving a pathway for Hispanic brilliance in STEM.</h2>
  </div>
  <div class="md:col-span-7">
    <p class="text-ink-muted text-lg max-w-2xl">{siteData.mission}</p>
    <p class="mt-6 text-ink-muted text-lg max-w-2xl">
      Our chapter at Boston University provides a home-away-from-home for engineers, designers, and scientists, offering a unique blend of professional mentorship and academic rigor.
    </p>
    <p class="pullquote text-ink mt-10 max-w-2xl">
      "Diversity is not just a metric; it is the catalyst for the innovation that will solve the next century's most pressing engineering challenges."
    </p>
    <p class="font-mono text-sm text-ink-muted tracking-wide uppercase mt-6">— BU SHPE Executive Board</p>
  </div>
</section>

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 02 — THE PILLARS -->
<section class="max-w-[1200px] mx-auto px-6 py-20 md:py-28">
  <SectionIndex label="The Pillars" />
  <h2 class="display text-3xl md:text-4xl text-ink mt-5 max-w-2xl">Three things we do, year in and year out.</h2>
  <p class="mt-4 text-ink-muted max-w-md">
    Conferences, service, and professional development — the load-bearing work of the chapter.
  </p>

  <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-px bg-outline-soft border border-outline-soft">
    {pillars.map((pillar) => (
      <div class="bg-bg p-7 flex flex-col">
        <div class="photo-warm relative aspect-[3/2] overflow-hidden bg-surface-soft mb-5 -mt-1">
          <img
            src={pillar.image}
            alt={pillar.imageAlt}
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <p class="font-mono text-sm text-accent tracking-wide uppercase mb-3">{pillar.label}</p>
        <p class="text-ink-muted text-sm flex-grow">{pillar.body}</p>
        <ul class="mt-5 space-y-1.5">
          {pillar.points.map((point) => (
            <li class="font-mono text-xs text-ink-muted tracking-wide uppercase flex items-center gap-2">
              <span class="inline-block h-1.5 w-1.5 bg-accent" aria-hidden="true"></span>
              {point}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 03 — RECENT EVENTS -->
<section class="max-w-[1200px] mx-auto px-6 py-20 md:py-28">
  <div class="flex items-end justify-between gap-6">
    <div>
      <SectionIndex label="Recent Events" />
      <h2 class="display text-3xl md:text-4xl text-ink mt-5">From the logbook.</h2>
    </div>
    <a
      href="/events"
      class="group inline-flex items-center gap-2 font-sans text-base font-medium text-ink hover:text-accent transition-colors shrink-0"
    >
      <span class="border-b border-current pb-0.5">View all</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-px bg-outline-soft border border-outline-soft">
    {recentEvents.map((event) => (
      <a href={`/events/${eventSlug(event.title)}`} class="block">
        <article class="bg-bg group p-8 flex flex-col h-full hover:bg-surface-soft transition-colors">
          <p class="font-mono text-sm text-accent tracking-wide uppercase">{event.category}</p>
          <div class="display text-5xl text-ink leading-[0.8] opacity-10 group-hover:opacity-20 transition my-6">
            {formatEventDate(event.date)}
          </div>
          <h3 class="display text-2xl text-ink mb-4 group-hover:text-accent transition">{event.title}</h3>
          <p class="text-ink-muted text-sm flex-grow mb-8">{event.description}</p>
          <div class="border-t border-outline-soft pt-4 flex justify-between items-center">
            <span class="font-mono uppercase tracking-wide text-xs text-ink-muted">{event.category}</span>
            <span class="text-accent" aria-hidden="true">→</span>
          </div>
        </article>
      </a>
    ))}
  </div>
</section>

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 04 — SPONSORS -->
<section class="max-w-[1200px] mx-auto px-6 py-20 md:py-28">
  <SectionIndex label="With Support From" />
  <h2 class="display text-3xl md:text-4xl text-ink mt-5 mb-10 max-w-2xl">The partners behind the work.</h2>
  <SponsorGrid sponsors={sponsors} />
</section>

<!-- CTA -->
<CtaBand
  heading={'Become part of the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">familia</em>.'}
  body="Whether you are a student, alum, or corporate partner, there is a place for you in our mission to change the face of engineering."
  primaryCta={{ label: "Join SHPE", href: "/join" }}
  secondaryCta={{ label: "Meet the board", href: "/about/board" }}
/>
