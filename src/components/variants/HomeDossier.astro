---
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import CtaBand from "@/components/CtaBand.astro";
import LogoMarquee from "@/components/LogoMarquee.astro";
import EmployerSpread from "@/components/EmployerSpread.astro";
import EventCard from "@/components/EventCard.astro";
import Icon from "@/components/Icon.astro";

import siteData from "@/data/site.json";
import type { EmployerGroup, Sponsor } from "@/types";
import type { EventRecord } from "@/lib/server/events";
import { eventSortKey, formatEventStamp } from "@/lib/events";

interface Props {
  events: EventRecord[];
  /** This SHPE year's partners & sponsors (D1, newest year). */
  partners: Sponsor[];
  /** "Where we work" employers by industry (D1). */
  employerGroups: EmployerGroup[];
}

const events = [...Astro.props.events].sort((a, b) => eventSortKey(b.date).localeCompare(eventSortKey(a.date)));
const recentEvents = events.slice(0, 3);

const sponsors = Astro.props.partners;

const pillars = [
  {
    label: "Conferences",
    image: "/assets/conferences/national-convention-2026-indianapolis.jpg",
    imageAlt: "BU SHPE members behind the FAMILIA sign at the 2026 SHPE National Convention in Indianapolis",
    body: "Every year, we take members to the SHPE National Convention — the largest Hispanic technical conference in the world. It's where résumés meet dream jobs.",
    points: ["Resume reviews", "Interview prep", "Career fairs"],
  },
  {
    label: "Volunteering",
    image: "/assets/volunteering/museum-of-science-1.jpeg",
    imageAlt: "BU SHPE volunteering at the Museum of Science",
    body: "Giving back is in our DNA. We mentor local high school students and run workshops to inspire the next generation to pursue careers in STEM.",
    points: ["K-12 outreach", "Local STEM fairs", "Chapter mentorship"],
  },
  {
    label: "Professional Development",
    image: "/assets/events/capital-one-workshop.jpg",
    imageAlt: "Capital One workshop",
    body: "From LinkedIn optimizations to technical workshops with industry partners, we ensure our members are ready for the workforce.",
    points: ["Corporate mixers", "Tech talks", "Soft-skills seminars"],
  },
];

---

<!-- HERO — split: dossier text panel + campus photo -->
<header class="relative w-full bg-bg blueprint overflow-hidden">
  <!-- md+: an 5:6 split of the window, photo-heavy; text starts and the photo ends on the shared container edges -->
  <div class="grid grid-cols-1 md:min-h-[calc(100vh-72px)] md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
  <!-- LEFT — text / CTA panel -->
  <div class="flex items-center px-6 md:pl-[max(1.5rem,calc((100vw-1152px)/2))] md:pr-12 pt-12 pb-10 md:py-12 relative z-10">
    <div class="max-w-[672px] w-full">
      <p class="font-mono text-ink-muted text-xs tracking-[0.14em] md:text-sm md:tracking-[0.18em] uppercase mb-5 text-balance">Boston University · SHPE Region 4</p>
      <div class="w-8 h-[3px] bg-accent mb-6"></div>
      <h1 class="display text-[2.5rem] sm:text-5xl md:text-5xl lg:text-6xl text-ink leading-[1.02]">
        SHPE Boston University — building the next generation of Hispanic engineers, <em class="font-serif italic font-normal lowercase tracking-normal text-accent">together</em>.
      </h1>
      <p class="mt-6 md:mt-7 text-ink-muted md:text-lg">¡Bienvenidos a la familia! {siteData.mission}</p>
      <div class="mt-8 md:mt-9 flex flex-wrap items-center gap-6">
        <a
          href="/about"
          class="group inline-flex items-center gap-2 btn-dossier max-sm:w-full max-sm:justify-center"
        >
          Explore Chapter
          <Icon name="arrow-forward" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
        </a>
        <a
          href="/events"
          class="group inline-flex min-h-11 items-center gap-2 font-sans text-base font-medium text-ink transition-colors hover:text-accent md:min-h-0"
        >
          <span class="border-b border-current pb-0.5">View Events</span>
          <Icon name="arrow-forward" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
        </a>
      </div>
    </div>
  </div>

  <!-- RIGHT — campus photo, dossier-framed -->
  <div class="relative flex flex-col px-6 pb-12 md:py-12 md:pl-0 md:pr-[max(1.5rem,calc((100vw-1152px)/2))]">
    <div class="photo-warm relative w-full aspect-[16/10] md:aspect-auto md:flex-1 md:min-h-[280px] overflow-hidden border border-outline-soft">
      <img
        src="/assets/campus/Boston-University-Center-For-Computing-Data-Sciences-Building-Located-Near-The-Charles-River-In-Boston-Massachusetts-USA.jpg"
        alt="The Charles River with BU's Center for Computing & Data Sciences and the Boston skyline"
        class="absolute inset-0 w-full h-full object-cover select-none"
        style="object-position: 65% center;"
        loading="eager"
        draggable="false"
      />
    </div>
  </div>
  </div>
</header>

<!-- PARTNER LOGO MARQUEE -->
<LogoMarquee items={sponsors} label="Partners & sponsors" href="/support" linkText="Support the chapter" />

<!-- 01 — MISSION -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12">
  <div class="md:col-span-5 md:sticky md:top-28 md:self-start">
    <SectionIndex label="Mission" accent="scarlet" />
    <h2 class="display text-3xl md:text-4xl text-ink mt-5">Paving a pathway for Hispanic brilliance in STEM.</h2>
  </div>
  <div class="md:col-span-7">
    <p class="text-ink-muted text-lg max-w-2xl">{siteData.mission}</p>
    <p class="mt-6 text-ink-muted text-lg max-w-2xl">
      Our chapter at Boston University provides a home-away-from-home for engineers, designers, and scientists, offering a unique blend of professional mentorship and academic rigor.
    </p>
    <p class="pullquote text-ink mt-10 max-w-2xl">
      “Diversity is not just a metric; it is the catalyst for the innovation that will solve the next century’s most pressing engineering challenges.”
    </p>
    <p class="font-mono text-sm text-ink-muted tracking-wide uppercase mt-6">— BU SHPE Executive Board</p>
  </div>
</section>

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 02 — THE PILLARS -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28">
  <SectionIndex label="The Pillars" />
  <h2 class="display text-3xl md:text-4xl text-ink mt-5 max-w-2xl">Three things we do, year in and year out.</h2>
  <p class="mt-4 text-ink-muted max-w-md">
    Conferences, service, and professional development — the load-bearing work of the chapter.
  </p>

  <div class="mt-10 -mx-6 px-6 flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-px-6 pb-2 md:mx-0 md:px-0 md:pb-0 md:overflow-visible md:grid md:grid-cols-3 md:gap-8 lg:gap-12">
    {pillars.map((pillar) => (
      <div class="bg-bg w-[82%] shrink-0 snap-start border border-outline-soft flex flex-col md:w-auto md:border-0">
        <div class="photo-warm relative aspect-[3/2] overflow-hidden bg-surface-soft md:mb-6">
          <img
            src={pillar.image}
            alt={pillar.imageAlt}
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="flex flex-col flex-grow p-5 md:p-0">
        <p class="font-mono text-sm text-accent tracking-wide uppercase mb-3">{pillar.label}</p>
        <p class="text-ink-muted text-sm flex-grow">{pillar.body}</p>
        <ul class="mt-5 space-y-1.5">
          {pillar.points.map((point) => (
            <li class="font-mono text-xs text-ink-muted tracking-wide uppercase flex items-center gap-2">
              <span class="inline-block h-1.5 w-1.5 bg-accent" aria-hidden="true"></span>
              {point}
            </li>
          ))}
        </ul>
        </div>
      </div>
    ))}
  </div>
  <p class="mt-4 font-mono text-xs uppercase tracking-[0.14em] text-ink-muted md:hidden" aria-hidden="true">Swipe →</p>
</section>

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 03 — RECENT EVENTS -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28">
  <div class="flex items-end justify-between gap-6">
    <div>
      <SectionIndex label="Recent Events" />
      <h2 class="display text-3xl md:text-4xl text-ink mt-5">From the logbook.</h2>
    </div>
    <a
      href="/events"
      class="group inline-flex min-h-11 items-center gap-2 font-sans text-base font-medium text-ink hover:text-accent transition-colors shrink-0 md:min-h-0"
    >
      <span class="border-b border-current pb-0.5">View all</span>
      <span class="md:hidden" aria-hidden="true">→</span>
      <Icon name="arrow-forward" class="hidden md:block w-4 h-4 transition-transform group-hover:translate-x-1" />
    </a>
  </div>

  <!-- Phones: text-only cards -->
  <div class="mt-10 grid grid-cols-1 gap-px bg-outline-soft border border-outline-soft md:hidden">
    {recentEvents.map((event) => (
      <a href={`/events/${event.slug}`} class="block">
        <article class="bg-bg group p-6 flex flex-col h-full hover:bg-surface-soft transition-colors">
          <p class="font-mono text-sm text-accent tracking-wide uppercase">{formatEventStamp(event.date)} · {event.category}</p>
          <h3 class="display text-2xl text-ink mt-3 mb-2 group-hover:text-accent transition">{event.title}</h3>
          <p class="text-ink-muted text-sm flex-grow line-clamp-2">{event.description}</p>
        </article>
      </a>
    ))}
  </div>

  <!-- md+: the same photo-on-top card as /events/all -->
  <div class="hidden md:grid mt-12 grid-cols-3 gap-px bg-outline-soft border border-outline-soft">
    {recentEvents.map((event) => (
      <EventCard event={event} />
    ))}
  </div>
</section>

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 04 — WHERE WE WORK -->
<EmployerSpread groups={Astro.props.employerGroups} />

<!-- CTA -->
<CtaBand
  heading={'Become part of the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">familia</em>.'}
  body="Whether you are a student, alum, or corporate partner, there is a place for you in our mission to change the face of engineering."
  primaryCta={{ label: "Join SHPE", href: "/join" }}
  secondaryCta={{ label: "Meet the board", href: "/about/board" }}
/>
