---
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import CtaBand from "@/components/CtaBand.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import MailingListForm from "@/components/MailingListForm.astro";
import LogoMarquee from "@/components/LogoMarquee.astro";
import Icon from "@/components/Icon.astro";
import siteData from "@/data/site.json";
import type { EmployerGroup } from "@/types";

interface Props {
  /** Where members work, by industry (D1) — feeds the logo marquee. */
  employerGroups: EmployerGroup[];
}

const steps = [
  {
    index: "01",
    label: "SUBSCRIBE",
    body: "Get on the mailing list so you hear about every meeting and event.",
  },
  {
    index: "02",
    label: "FOLLOW",
    body: "Follow @shpe.bostonu on Instagram for daily updates and stories.",
  },
  {
    index: "03",
    label: "SHOW UP",
    body: "Walk into the next event. You don't need to RSVP — bring a friend.",
  },
];
---

<!-- HERO -->
<header class="relative w-full bg-deep blueprint-deep py-16 md:py-28 px-6 overflow-hidden">
  <div class="max-w-[1152px] mx-auto relative z-10">
    <p class="font-mono text-cream/60 text-xs tracking-[0.14em] md:text-sm md:tracking-[0.18em] uppercase mb-5">Membership · No fee · No application</p>
    <h1 class="display text-5xl md:text-7xl text-cream leading-[1.02] max-w-3xl">
      Find your <em class="font-serif italic font-normal lowercase tracking-normal text-accent">familia</em>.
    </h1>
    <p class="mt-7 text-cream/80 max-w-xl text-lg">
      There's no membership fee. There's no application. Just say hi — subscribe, follow, and walk into the next event.
    </p>
    <!-- Phones: the form sits several screens down, so point at it from the hero -->
    <a
      href="#sign-up"
      class="group mt-6 inline-flex min-h-11 items-center gap-2 font-sans text-base font-medium text-cream hover:text-accent transition-colors md:hidden"
    >
      <span class="border-b border-current pb-0.5">Sign up</span>
      <Icon name="arrow-forward" class="w-4 h-4 rotate-90 transition-transform group-hover:translate-y-0.5" />
    </a>
  </div>
</header>

<!-- WHERE MEMBERS WORK — the payoff, shown before the ask -->
<!-- Phones: hidden so the hero leads straight into the steps + form -->
<div class="max-md:hidden">
  <LogoMarquee items={Astro.props.employerGroups.flatMap((g) => g.companies)} label="Where our members work" href="/careers" linkText="See where we work" />
</div>

<!-- 01 — INTAKE -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28">
  <SectionIndex index="01" label="Intake" />
  <h2 class="display text-3xl md:text-4xl text-ink mt-5 max-w-2xl">Three small steps.</h2>
  <p class="mt-4 text-ink-muted max-w-md">
    Joining the chapter is a short procedure — three moves and you're in the loop.
  </p>

  <!-- Phones: hairline ledger rows (inline mono number + label) instead of boxes -->
  <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-px bg-outline-soft border border-outline-soft md:gap-0 md:bg-transparent md:border-x-0 md:border-b-0 md:divide-x md:divide-outline-soft max-md:mt-8 max-md:gap-0 max-md:bg-transparent max-md:border-x-0 max-md:border-b-0 max-md:divide-y max-md:divide-outline-soft">
    {steps.map((step) => (
      <div class="bg-bg p-6 grid grid-cols-[auto_1fr] gap-x-5 gap-y-1.5 md:px-8 md:pt-8 md:pb-2 md:first:pl-0 md:last:pr-0 md:flex md:flex-col md:gap-3 md:bg-transparent max-md:items-baseline max-md:bg-transparent max-md:px-0 max-md:py-5">
        <span class="row-span-2 display text-5xl text-accent leading-none tabular-nums max-md:hidden">{step.index}</span>
        <span class="font-mono text-sm tracking-wide text-accent tabular-nums md:hidden">{step.index}</span>
        <p class="font-mono text-sm text-accent tracking-wide uppercase max-md:text-ink">{step.label}</p>
        <p class="text-sm leading-relaxed text-ink-muted max-md:col-start-2">{step.body}</p>
      </div>
    ))}
  </div>
</section>

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 02 — MAILING LIST -->
<section id="sign-up" class="max-w-[1200px] mx-auto px-6 py-16 md:py-28 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start lg:items-end scroll-mt-[72px]">
  <div class="lg:col-span-4">
    <SectionIndex index="02" label="Mailing List" />
    <h2 class="display text-3xl md:text-4xl text-ink mt-5">Get event invites in your inbox.</h2>
    <p class="mt-4 text-ink-muted max-w-md">
      One email per major event. We don't share your address.
    </p>
  </div>
  <div class="lg:col-span-8">
    <MailingListForm />
  </div>
</section>

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 03 — CHANNELS -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28 md:grid md:grid-cols-12 md:gap-x-12">
  <div class="md:col-span-5">
  <SectionIndex index="03" label="Channels" />
  <h2 class="display text-3xl md:text-4xl text-ink mt-5 max-w-2xl">Stay close to the familia.</h2>
  <p class="mt-4 text-ink-muted max-w-md">
    We post most updates on Instagram. LinkedIn is for jobs and conferences.
  </p>
  </div>

  <div class="md:col-span-7">
  <div class="mt-8 md:mt-0">
    <SocialLinks ledger />
  </div>

  <p class="mt-6 text-sm text-ink-muted">
    Curious about the national org? Visit{" "}
    <a
      href={siteData.socials.shpe}
      class="text-accent hover:underline underline-offset-4 transition max-md:inline-block max-md:py-3 max-md:-my-3"
      target="_blank"
      rel="noopener"
    >shpe.org</a>.
  </p>
  </div>
</section>

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 04 — CONTACT -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
  <div class="md:col-span-5">
    <SectionIndex index="04" label="Contact" />
    <h2 class="display text-3xl md:text-4xl text-ink mt-5">Have a question?</h2>
    <p class="mt-4 text-ink-muted max-w-md">
      Email us anytime — the board reads every message.
    </p>
  </div>
  <div class="md:col-span-7">
    <!-- Phones: hairline rows instead of boxes -->
    <div class="grid grid-cols-1 gap-px bg-outline-soft border border-outline-soft md:gap-0 md:bg-transparent md:border-x-0 md:divide-y md:divide-outline-soft max-md:gap-0 max-md:bg-transparent max-md:border-x-0 max-md:border-b-0 max-md:divide-y max-md:divide-outline-soft">
      <div class="bg-bg p-7 md:grid md:grid-cols-[11rem_1fr] md:items-baseline md:gap-x-8 md:bg-transparent md:px-0 md:py-6 max-md:bg-transparent max-md:px-0 max-md:py-5">
        <p class="font-mono text-sm text-accent tracking-wide uppercase mb-3 md:mb-0 max-md:mb-1.5">Chapter</p>
        <a
          href={`mailto:${siteData.contactEmail}`}
          class="font-mono text-ink hover:text-accent transition-colors break-all max-md:inline-block max-md:py-2.5 max-md:-my-2.5"
        >
          {siteData.contactEmail}
        </a>
      </div>
      <div class="bg-bg p-7 md:grid md:grid-cols-[11rem_1fr] md:items-baseline md:gap-x-8 md:bg-transparent md:px-0 md:py-6 max-md:bg-transparent max-md:px-0 max-md:py-5">
        <p class="font-mono text-sm text-ink-muted tracking-wide uppercase mb-3 md:mb-0 max-md:mb-1.5">Faculty Advisor</p>
        <a
          href={`mailto:${siteData.facultyAdvisorEmail}`}
          class="text-ink hover:text-accent transition-colors max-md:inline-block max-md:py-2.5 max-md:-my-2.5"
        >
          Enrique Gutierrez-Wing, Ph.D.
        </a>
      </div>
    </div>
  </div>
</section>

<!-- CTA / Donate closer -->
<CtaBand
  heading={`Support the next generation of <em class="font-serif italic font-normal lowercase tracking-normal text-accent">engineers</em>.`}
  body="There's no fee to join — but if you can, help keep the chapter's programs running for the students who come next."
  primaryCta={{ label: "Donate via BU Trusted", href: siteData.donateUrl }}
  secondaryCta={{ label: "Browse events", href: "/events" }}
/>
