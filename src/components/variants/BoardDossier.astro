---
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import CtaBand from "@/components/CtaBand.astro";
import type { BoardMember } from "@/types";
import siteData from "@/data/site.json";
import { PLACEHOLDER_PHOTO } from "@/lib/server/board";
import { formatShpeYear, termStartYear } from "@/lib/shpe-year";

interface Props {
  members: (BoardMember & { isAdvisor: boolean })[];
  /** Academic year shown, e.g. "2026–2027". */
  term: string;
  /** Every year on record, newest first. */
  terms: string[];
}
const { members: allMembers, term, terms } = Astro.props;
const officers = allMembers.filter((m) => !m.isAdvisor);
const advisor = allMembers.find((m) => m.isAdvisor);

// Terms are stored "2026–2027"; show them as the SHPE year, "26-27".
const termLabel = (t: string) => {
  const start = termStartYear(t);
  return start === null ? t : formatShpeYear(start);
};

/** "Class of 2028 · Miami, FL", skipping blanks and old "—"/"TBD" fillers. */
const details = (m: BoardMember) =>
  [m.year, m.hometown].filter((v) => v && v !== "—" && v !== "TBD").join(" · ");
const isLatest = term === terms[0];

// The seeded advisor row carries a placeholder bio ("Faculty Advisor to
// SHPE-BostonU. Contact: esgw@bu.edu.") — not a quote. Only real bios get the
// italic pull-quote; a placeholder surfaces its email as plain metadata.
const EMAIL = /[\w.+-]+@[\w-]+(\.[\w-]+)+/;
const isPlaceholderBio = (bio: string) => !bio.trim() || /contact:/i.test(bio) || EMAIL.test(bio);
const quoteBio = (m: BoardMember) => (isPlaceholderBio(m.bio) ? "" : m.bio);
const contactEmail = (m: BoardMember, fallback = "") => m.bio.match(EMAIL)?.[0] ?? fallback;
const advisorEmail = advisor ? contactEmail(advisor, siteData.facultyAdvisorEmail) : "";
const pastTerms = terms.filter((t) => t !== term);

// No real portrait (blank, the seeded placeholder silhouette, or an unfilled
// TBD seat): render a quiet initials monogram instead of the loud silhouette.
const hasPhoto = (m: BoardMember) => !!m.photo && m.photo !== PLACEHOLDER_PHOTO && m.name !== "TBD";
/** "Enrique Gutierrez-Wing, Ph.D." -> "EG"; "TBD" -> "". */
const initials = (m: BoardMember) => {
  if (m.name === "TBD") return "";
  const words = m.name.split(",")[0].trim().split(/\s+/).filter(Boolean);
  if (words.length === 0) return "";
  const first = words[0][0];
  const last = words.length > 1 ? words[words.length - 1][0] : "";
  return (first + last).toUpperCase();
};

// Last-row fillers so the hairline grid shows no gray holes:
// 2 columns at md (sm keeps its own behaviour), 5 at lg.
const fillMd = officers.length % 2;
const fillLg = (5 - (officers.length % 5)) % 5;

const visionItems = [
  "Fostering a sense of community for Hispanic engineers on campus.",
  "Providing direct pipelines to industry-leading Fortune 500 companies.",
  "Ensuring academic support through peer tutoring and study banks.",
];
---

<!-- HERO -->
<header class="relative w-full bg-deep blueprint-deep py-16 md:py-28 px-6 overflow-hidden">
  <div class="max-w-[1152px] mx-auto relative z-10">
    <p class="font-mono text-cream/60 text-xs tracking-[0.14em] md:text-sm md:tracking-[0.18em] uppercase mb-5 text-balance">
      Leadership · Term {termLabel(term)}
    </p>
    <h1 class="display text-5xl md:text-7xl text-cream leading-[1.02] max-w-3xl">
      Meet the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">board</em>.
    </h1>
    <p class="mt-7 text-cream/80 max-w-xl text-lg">
      Driving the mission of Hispanic excellence in engineering at Boston
      University. Our leadership focuses on professional development,
      community impact, and academic success.
    </p>
  </div>

  <!-- Decorative term watermark -->
</header>

<!-- 01 — ROSTER -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28">
  <SectionIndex label="Roster" />
  <h2 class="display text-3xl md:text-4xl text-ink mt-5 max-w-2xl">The officer corps.</h2>
  <p class="mt-4 text-ink-muted max-w-md">
    {isLatest
      ? "Elected each year to steer events, outreach, and finances — one seat per portfolio."
      : `The ${termLabel(term)} board. `}
    {!isLatest && <a href="/about/board" class="text-accent underline underline-offset-4 max-md:py-3.5">See the current board.</a>}
  </p>

  <div class="mt-8 sm:mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-px bg-outline-soft border-t sm:border border-outline-soft">
    {officers.map((member) => (
      <div class="bg-bg py-4 sm:p-7 lg:p-5 flex flex-row items-center gap-4 sm:items-stretch sm:flex-col sm:gap-0">
        <div class="w-16 shrink-0 sm:w-auto aspect-square sm:aspect-[4/5] bg-surface-soft overflow-hidden sm:mb-5 lg:mb-4">
          {hasPhoto(member) ? (
            <img src={member.photo} alt={member.name} class="w-full h-full object-cover" loading="lazy" />
          ) : (
            <div class="w-full h-full flex items-center justify-center" aria-hidden="true">
              <span class="display text-2xl sm:text-6xl lg:text-5xl text-ink-muted/70 tracking-normal">{initials(member)}</span>
            </div>
          )}
        </div>
        <div class="min-w-0 flex flex-1 flex-col">
          <p class="font-mono text-xs sm:text-sm lg:text-xs text-accent tracking-wide uppercase mb-1 sm:mb-3 lg:mb-2 lg:min-h-[2lh]">{member.role}</p>
          <h3 class="display text-2xl md:text-3xl lg:text-2xl text-ink">{member.name}</h3>
          {quoteBio(member) && <p class="font-serif italic text-ink-muted mt-2 sm:mt-3">"{quoteBio(member)}"</p>}
          {(member.major || details(member)) && (
            <div class="mt-auto pt-2 sm:pt-6">
              {member.major && <p class="font-mono text-xs text-ink tracking-wide uppercase">{member.major}</p>}
              {details(member) && <p class="font-mono text-xs text-ink-muted tracking-wide uppercase mt-1">{details(member)}</p>}
            </div>
          )}
        </div>
      </div>
    ))}
    {Array.from({ length: fillMd }, () => (
      <div class="hidden md:block lg:hidden bg-bg" aria-hidden="true"></div>
    ))}
    {Array.from({ length: fillLg }, () => (
      <div class="hidden lg:block bg-bg" aria-hidden="true"></div>
    ))}
  </div>
  {officers.length === 0 && (
    <p class="mt-10 font-mono text-sm uppercase tracking-[0.12em] text-ink-muted">Roster coming soon.</p>
  )}

  {pastTerms.length > 0 && (
    <nav aria-label="Past boards" class="mt-10 flex flex-wrap items-baseline gap-x-5 md:gap-y-2 font-mono text-xs uppercase tracking-[0.12em]">
      <span class="text-ink-muted">{isLatest ? "Past boards" : "Other years"}</span>
      {pastTerms.map((t) => (
        <a href={t === terms[0] ? "/about/board" : `/about/board?term=${encodeURIComponent(t)}`} class="min-h-11 inline-flex items-center md:min-h-0 text-link hover:text-accent">{termLabel(t)}</a>
      ))}
    </nav>
  )}
</section>

{advisor && (
  <>
    <div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

    <!-- 02 — FACULTY ADVISOR -->
    <section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
      <div class="md:col-span-5">
        <SectionIndex label="Faculty Advisor" />
        <h2 class="display text-3xl md:text-4xl text-ink mt-5">The chapter's anchor.</h2>
        <p class="mt-4 text-ink-muted max-w-md">
          Our faculty advisor bridges the chapter and the College of Engineering.
        </p>
      </div>
      <div class="md:col-span-7">
        <div class="bg-bg py-5 sm:p-7 border-t sm:border border-outline-soft md:border-0 md:p-0 flex flex-row gap-5 sm:gap-6 md:gap-8">
          <div class="w-24 sm:w-44 shrink-0 self-start sm:self-auto aspect-[4/5] bg-surface-soft overflow-hidden">
            {hasPhoto(advisor) ? (
              <img src={advisor.photo} alt={advisor.name} class="w-full h-full object-cover" loading="lazy" />
            ) : (
              <div class="w-full h-full flex items-center justify-center" aria-hidden="true">
                <span class="display text-4xl sm:text-6xl text-ink-muted/70 tracking-normal">{initials(advisor)}</span>
              </div>
            )}
          </div>
          <div class="min-w-0 flex flex-col">
            <p class="font-mono text-sm text-accent tracking-wide uppercase mb-3">{advisor.role}</p>
            <h3 class="display text-2xl md:text-3xl text-ink">{advisor.name}</h3>
            {quoteBio(advisor) && <p class="font-serif italic text-ink-muted mt-3">"{quoteBio(advisor)}"</p>}
            {!quoteBio(advisor) && advisorEmail && (
              <p class="mt-3 flex flex-wrap items-baseline gap-x-3">
                <span class="mono-label text-ink-muted">Contact</span>
                <a href={`mailto:${advisorEmail}`} class="text-accent underline underline-offset-4 hover:text-accent/80 transition-colors max-md:py-2.5 max-md:-my-2.5">{advisorEmail}</a>
              </p>
            )}
            {(advisor.major || details(advisor)) && (
              <div class="mt-4 pt-4 sm:mt-6 sm:pt-6 border-t border-outline-soft">
                {advisor.major && <p class="font-mono text-xs text-ink tracking-wide uppercase">{advisor.major}</p>}
                {details(advisor) && <p class="font-mono text-xs text-ink-muted tracking-wide uppercase mt-1">{details(advisor)}</p>}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  </>
)}

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 03 — VISION -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-x-12 md:gap-y-10">
  <div class="md:col-span-6 md:row-start-1">
    <SectionIndex label="Vision" accent="scarlet" />
    <h2 class="display text-3xl md:text-4xl text-ink mt-5">A collaborative engine.</h2>
    <p class="mt-4 text-ink-muted max-w-md">
      The board is more than just leadership. We meet weekly to discuss member
      engagement, corporate sponsorships, and the implementation of our
      "SHPE Familia" core values.
    </p>
  </div>
  <div class="aspect-[16/9] md:aspect-auto md:relative md:min-h-[22rem] md:col-start-7 md:col-span-6 md:row-start-1 md:row-span-2 overflow-hidden bg-deep">
    <img
      src="/assets/events/leadershpe-live-2023.jpg"
      alt="BU SHPE at LeaderSHPE Live 2023"
      class="w-full h-full object-cover md:absolute md:inset-0"
      loading="lazy"
    />
  </div>
  <div class="md:col-span-6 md:row-start-2">
    <div class="grid grid-cols-1 gap-px bg-outline-soft border-t sm:border border-outline-soft md:border-x-0">
      {visionItems.map((text, i) => (
        <div class="bg-bg py-5 sm:p-7 md:px-0 md:py-5 flex gap-5 items-start">
          <span class="font-mono text-sm text-accent tracking-wide shrink-0 pt-0.5 md:hidden">
            {String(i + 1).padStart(2, "0")}
          </span>
          <p class="text-ink">{text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<CtaBand
  heading={`Lead with <em class="font-serif italic font-normal lowercase tracking-normal text-accent">us</em>.`}
  body="Interested in joining the extended board or leading a specific committee? We are always looking for passionate members to help organize events and manage outreach."
  primaryCta={{ label: "Apply for Committee", href: "/join" }}
  secondaryCta={{ label: "Our Constitution", href: siteData.constitutionUrl }}
/>
