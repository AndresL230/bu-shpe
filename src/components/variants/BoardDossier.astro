---
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import CtaBand from "@/components/CtaBand.astro";
import type { BoardMember } from "@/types";
import siteData from "@/data/site.json";

interface Props {
  members: (BoardMember & { isAdvisor: boolean })[];
  /** Academic year shown, e.g. "2026–2027". */
  term: string;
  /** Every year on record, newest first. */
  terms: string[];
}
const { members: allMembers, term, terms } = Astro.props;
const officers = allMembers.filter((m) => !m.isAdvisor);
const advisor = allMembers.find((m) => m.isAdvisor);

// Short form of the term for the banner watermark, e.g. "2025–2026" -> "25–26"
const termShort = term.replace(/\d{4}/g, (y) => y.slice(-2));

/** "Class of 2028 · Miami, FL", skipping blanks and old "—"/"TBD" fillers. */
const details = (m: BoardMember) =>
  [m.year, m.hometown].filter((v) => v && v !== "—" && v !== "TBD").join(" · ");
const isLatest = term === terms[0];
const pastTerms = terms.filter((t) => t !== term);

const visionItems = [
  "Fostering a sense of community for Hispanic engineers on campus.",
  "Providing direct pipelines to industry-leading Fortune 500 companies.",
  "Ensuring academic support through peer tutoring and study banks.",
];
---

<!-- HERO -->
<header class="relative w-full bg-deep blueprint-deep py-24 md:py-32 px-6 overflow-hidden">
  <div class="max-w-[1200px] mx-auto relative z-10">
    <p class="font-mono text-cream/60 text-sm tracking-[0.18em] uppercase mb-5 text-balance">
      Leadership · Term {term}
    </p>
    <h1 class="display text-5xl md:text-7xl text-cream leading-[1.02] max-w-3xl">
      Meet the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">board</em>.
    </h1>
    <p class="mt-7 text-cream/80 max-w-xl text-lg">
      Driving the mission of Hispanic excellence in engineering at Boston
      University. Our leadership focuses on professional development,
      community impact, and academic success.
    </p>
  </div>

  <!-- Decorative term watermark -->
  <div class="absolute right-0 bottom-0 opacity-10 pointer-events-none select-none hidden md:block">
    <span class="display text-[200px] lg:text-[280px] leading-none text-cream translate-y-1/4 inline-block">{termShort}</span>
  </div>
</header>

<!-- 01 — ROSTER -->
<section class="max-w-[1200px] mx-auto px-6 py-20 md:py-28">
  <SectionIndex label="Roster" />
  <h2 class="display text-3xl md:text-4xl text-ink mt-5 max-w-2xl">The officer corps.</h2>
  <p class="mt-4 text-ink-muted max-w-md">
    {isLatest
      ? "Elected each year to steer events, outreach, and finances — one seat per portfolio."
      : `The ${term} board. `}
    {!isLatest && <a href="/about/board" class="text-accent underline underline-offset-4">See the current board.</a>}
  </p>

  <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-outline-soft border border-outline-soft">
    {officers.map((member) => (
      <div class="bg-bg p-5 sm:p-7 flex flex-row gap-5 sm:flex-col sm:gap-0">
        <div class="w-24 shrink-0 self-start sm:w-auto sm:self-auto aspect-[4/5] bg-surface-soft overflow-hidden sm:mb-5">
          <img src={member.photo} alt={member.name === "TBD" ? "" : member.name} class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="min-w-0 flex flex-1 flex-col">
          <p class="font-mono text-xs sm:text-sm text-accent tracking-wide uppercase mb-2 sm:mb-3">{member.role}</p>
          <h3 class="display text-2xl md:text-3xl text-ink">{member.name}</h3>
          {member.bio && <p class="font-serif italic text-ink-muted mt-2 sm:mt-3">"{member.bio}"</p>}
          {(member.major || details(member)) && (
            <div class="mt-auto pt-4 sm:pt-6">
              {member.major && <p class="font-mono text-xs text-ink tracking-wide uppercase">{member.major}</p>}
              {details(member) && <p class="font-mono text-xs text-ink-muted tracking-wide uppercase mt-1">{details(member)}</p>}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
  {officers.length === 0 && (
    <p class="mt-10 font-mono text-sm uppercase tracking-[0.12em] text-ink-muted">Roster coming soon.</p>
  )}

  {pastTerms.length > 0 && (
    <nav aria-label="Past boards" class="mt-10 flex flex-wrap items-baseline gap-x-5 gap-y-2 font-mono text-xs uppercase tracking-[0.12em]">
      <span class="text-ink-muted">{isLatest ? "Past boards" : "Other years"}</span>
      {pastTerms.map((t) => (
        <a href={t === terms[0] ? "/about/board" : `/about/board?term=${encodeURIComponent(t)}`} class="text-link hover:text-accent">{t}</a>
      ))}
    </nav>
  )}
</section>

{advisor && (
  <>
    <div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

    <!-- 02 — FACULTY ADVISOR -->
    <section class="max-w-[1200px] mx-auto px-6 py-20 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-12">
      <div class="md:col-span-5">
        <SectionIndex label="Faculty Advisor" />
        <h2 class="display text-3xl md:text-4xl text-ink mt-5">The chapter's anchor.</h2>
        <p class="mt-4 text-ink-muted max-w-md">
          Our faculty advisor bridges the chapter and the College of Engineering.
        </p>
      </div>
      <div class="md:col-span-7">
        <div class="bg-bg p-5 sm:p-7 border border-outline-soft flex flex-row gap-5 sm:gap-6">
          <div class="w-24 sm:w-44 shrink-0 self-start sm:self-auto aspect-[4/5] bg-surface-soft overflow-hidden">
            <img src={advisor.photo} alt={advisor.name} class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="min-w-0 flex flex-col">
            <p class="font-mono text-sm text-accent tracking-wide uppercase mb-3">{advisor.role}</p>
            <h3 class="display text-2xl md:text-3xl text-ink">{advisor.name}</h3>
            {advisor.bio && <p class="font-serif italic text-ink-muted mt-3">"{advisor.bio}"</p>}
            {(advisor.major || details(advisor)) && (
              <div class="mt-6 pt-6 border-t border-outline-soft">
                {advisor.major && <p class="font-mono text-xs text-ink tracking-wide uppercase">{advisor.major}</p>}
                {details(advisor) && <p class="font-mono text-xs text-ink-muted tracking-wide uppercase mt-1">{details(advisor)}</p>}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  </>
)}

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 03 — VISION -->
<section class="max-w-[1200px] mx-auto px-6 py-20 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-12">
  <div class="md:col-span-5">
    <SectionIndex label="Vision" accent="scarlet" />
    <h2 class="display text-3xl md:text-4xl text-ink mt-5">A collaborative engine.</h2>
    <p class="mt-4 text-ink-muted max-w-md">
      The board is more than just leadership. We meet weekly to discuss member
      engagement, corporate sponsorships, and the implementation of our
      "SHPE Familia" core values.
    </p>
    <div class="mt-8 aspect-[16/9] overflow-hidden bg-deep">
      <img
        src="/assets/events/leadershpe-live-2023.jpg"
        alt="BU SHPE at LeaderSHPE Live 2023"
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>
  </div>
  <div class="md:col-span-7">
    <div class="grid grid-cols-1 gap-px bg-outline-soft border border-outline-soft">
      {visionItems.map((text, i) => (
        <div class="bg-bg p-7 flex gap-5 items-start">
          <span class="font-mono text-sm text-accent tracking-wide shrink-0 pt-0.5">
            {String(i + 1).padStart(2, "0")}
          </span>
          <p class="text-ink">{text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<CtaBand
  heading={`Lead with <em class="font-serif italic font-normal lowercase tracking-normal text-accent">us</em>.`}
  body="Interested in joining the extended board or leading a specific committee? We are always looking for passionate members to help organize events and manage outreach."
  primaryCta={{ label: "Apply for Committee", href: "/join" }}
  secondaryCta={{ label: "Our Constitution", href: siteData.constitutionUrl }}
/>
