---
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import CtaBand from "@/components/CtaBand.astro";
import PhotoViewer from "@/components/PhotoViewer.astro";

import siteData from "@/data/site.json";
import type { EventPhoto, EventRecord } from "@/lib/server/events";
import type { ConventionRecord, VolunteeringRecord } from "@/lib/server/content";
import { formatShpeYear, shpeYearOf } from "@/lib/shpe-year";

interface Props {
  events: EventRecord[];
  /** Extra photos per event id (event_photos), shown after each event's cover. */
  extraPhotos?: Map<number, EventPhoto[]>;
  /** Convention delegation record (D1), newest first. */
  conventions: ConventionRecord[];
  /** Volunteering programs (D1), in display order. */
  programs: VolunteeringRecord[];
}

const { conventions, programs } = Astro.props;

// A convention photo can be both an event cover and a convention-record photo;
// show it once, filed under Conferences.
const conferenceSrcs = new Set(conventions.flatMap((c) => c.photos));
const seenSrcs = new Set<string>();
// `year` files each frame under a SHPE year (Aug–Jul), keyed by its start year
// ("2026" -> header "26-27"): the event's date; the convention year (the
// convention runs in the fall, so it opens that SHPE year); a volunteering
// program's SHPE year. Programs without one file as "" (Undated).
const eventYear = (date: string) => String(shpeYearOf(date));
const allPhotos = [
  // Events without a photo have nothing to show in the grid. Newest event
  // first (props arrive in creation order); ties keep creation order.
  ...Astro.props.events
    .filter((e) => e.photo)
    .sort((a, b) => b.date.localeCompare(a.date))
    .flatMap((e) => [
      { src: e.photo, alt: e.title, group: "Events", year: eventYear(e.date) },
      ...(Astro.props.extraPhotos?.get(e.id) ?? []).map((p) => ({ src: p.url, alt: e.title, group: "Events", year: eventYear(e.date) })),
    ]),
  ...programs.flatMap((v) =>
    v.photos.map((src) => ({ src, alt: v.name, group: "Volunteering", year: v.shpeYear != null ? String(v.shpeYear) : "" }))
  ),
  ...conventions.flatMap((c) =>
    c.photos.map((src) => ({
      src,
      alt: `${c.region ?? "Conference"} ${c.year} — ${c.city}`,
      group: "Conferences",
      year: String(c.year),
    }))
  ),
].filter((p) => {
  if (!p.src || seenSrcs.has(p.src)) return false;
  if (p.group !== "Conferences" && conferenceSrcs.has(p.src)) return false;
  seenSrcs.add(p.src);
  return true;
});
type Frame = (typeof allPhotos)[number];

// SHPE-year groups, newest first; undated frames close the archive. Within a
// year, frames keep the order above (events newest-first, then volunteering,
// then conventions).
const years = [...new Set(allPhotos.map((p) => p.year))].sort((a, b) =>
  !a ? 1 : !b ? -1 : b.localeCompare(a)
);
const yearCount = new Map(years.map((y) => [y, allPhotos.filter((p) => p.year === y).length]));

// Phones preview only the first ~PREVIEW frames; the rest sit in a <details>
// ("Show all N frames"), which md+ always shows (see <style>). A year cut
// mid-way is cut on a multiple of 6 frames, so its first half ends on a full
// row at 2 or 3 columns. Its second half renders into the same grid as
// .gallery-tail frames (hidden on phones until "Show all" opens), so any
// column count — 4 at lg — reads the year as one seamless grid.
const PREVIEW = 24;
const ROW = 6;
type Block = { year: string; photos: Frame[]; continued: boolean };
const head: Block[] = [];
const tail: Block[] = [];
let budget = PREVIEW;
let overflowed = false;
for (const year of years) {
  const photos = allPhotos.filter((p) => p.year === year);
  const take = overflowed ? 0 : budget >= photos.length ? photos.length : Math.max(0, Math.round(budget / ROW) * ROW);
  if (take > 0) head.push({ year, photos: photos.slice(0, take), continued: false });
  if (take < photos.length) {
    tail.push({ year, photos: photos.slice(take), continued: take > 0 });
    overflowed = true;
  }
  budget -= take;
}
// Frame indices run across head + tail in display order.
const indexOf = new Map([...head, ...tail].flatMap((b) => b.photos).map((p, i) => [p, i]));
// A continued year's second half, keyed by year, drawn inside its first half's grid.
const continuation = new Map(tail.filter((b) => b.continued).map((b) => [b.year, b.photos]));
const restTail = tail.filter((b) => !b.continued);

const yearLabel = (y: string) => (y ? formatShpeYear(Number(y)) : "Undated");
const frameLabel = (n: number) => `${n} ${n === 1 ? "frame" : "frames"}`;
const blockCls = "mt-12 first:mt-0 md:mt-16";
// md+: the year header pins under the fixed 72px nav while its frames scroll.
const headerCls = "flex items-baseline justify-between gap-4 border-b border-outline-soft pb-3 md:sticky md:top-[72px] md:z-10 md:bg-bg md:pt-4";
// Phones: 2-up so frames stay legible; the preview keeps the wall short.
const gridCls = "grid grid-cols-2 gap-1 sm:grid-cols-3 sm:gap-2 md:grid-cols-3 md:gap-2 lg:grid-cols-4";
const frameCls =
  "group block aspect-[4/3] w-full overflow-hidden border border-outline-soft bg-surface-soft focus:outline-none focus:ring-2 focus:ring-accent";
const imgCls = "h-full w-full object-cover group-hover:scale-[1.03] [transition:opacity_0.4s_ease,transform_0.5s_ease]";

// Per-category counts for the manifest strip
const counts = {
  All: allPhotos.length,
  Events: allPhotos.filter((p) => p.group === "Events").length,
  Volunteering: allPhotos.filter((p) => p.group === "Volunteering").length,
  Conferences: allPhotos.filter((p) => p.group === "Conferences").length,
};

// Category chips appear only once a category has enough photos to be worth
// filtering — re-added automatically as the archive grows.
const CHIP_MIN = 4;
const allFilters = ["All", "Events", "Volunteering", "Conferences"] as const;
const filters = allFilters.filter((label) => label === "All" || counts[label] >= CHIP_MIN);

const chipBase =
  "inline-flex shrink-0 items-center whitespace-nowrap font-mono text-xs uppercase tracking-[0.14em] px-4 py-2 min-h-11 md:min-h-0 border transition-colors";
const chipInactive = "border-outline-soft text-ink-muted hover:border-ink hover:text-ink";
---

<!-- HERO -->
<header class="relative w-full bg-deep blueprint-deep py-16 md:py-28 px-6 overflow-hidden">
  <div class="max-w-[1152px] mx-auto relative z-10">
    <p class="font-mono text-cream/60 text-xs tracking-[0.14em] md:text-sm md:tracking-[0.18em] uppercase mb-5 text-balance">
      Photo Archive · {counts.All} frames on file
    </p>
    <h1 class="display text-5xl md:text-7xl text-cream leading-[1.02] max-w-3xl">
      Moments from the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">familia</em>.
    </h1>
    <p class="mt-7 text-cream/80 max-w-xl text-lg">
      A visual record of the chapter — events, volunteering, and conference delegations, logged frame by frame.
    </p>
  </div>

</header>

<!-- 01 — ARCHIVE -->
<section
  id="gallery-dossier-root"
  class="max-w-[1200px] mx-auto px-6 py-16 md:py-28"
>
  <SectionIndex label="Archive" />
  <h2 class="display text-3xl md:text-4xl text-ink mt-5 max-w-2xl">The whole familia, on file.</h2>
  <p class="mt-4 text-ink-muted max-w-2xl">
    Filter the record by category. Tap any frame to open it full-size.
  </p>

  <!-- Mono filter chips -->
  <nav aria-label="Filter gallery by category" class="-mx-6 mt-8 flex gap-3 overflow-x-auto px-6 [scrollbar-width:none] md:mx-0 md:mt-10 md:flex-wrap md:overflow-visible md:px-0">
    {filters.map((label) => {
      const value = label === "All" ? "" : label;
      const href = value ? `?cat=${encodeURIComponent(value)}` : "?";
      return (
        <a
          data-chip-d
          data-chip-value={value}
          href={href}
          class:list={[chipBase, chipInactive]}
        >
          {label}
        </a>
      );
    })}
  </nav>

  <!-- Empty state -->
  <div
    data-empty-state-d
    hidden
    class="mt-8 md:mt-12 flex flex-col items-center justify-center border border-outline-soft bg-surface-soft py-20 text-center"
  >
    <p class="font-mono text-sm text-ink-muted uppercase tracking-[0.14em]">No frames in this category yet.</p>
    <p class="pullquote mx-auto max-w-md mt-3">Check back soon.</p>
  </div>

  <!-- Contact sheet, filed by year: fixed-aspect frames, so loading never shifts the layout -->
  <div class="mt-10 md:mt-14" id="gallery-grid-d" data-viewer-group>
    {head.map((b) => (
      <div data-year-group-d class={blockCls}>
        <h3 class={headerCls}>
          <span class="display text-2xl md:text-3xl text-ink leading-none">{yearLabel(b.year)}</span>
          <span class="mono-label" data-year-count-d={b.year}>{frameLabel(yearCount.get(b.year) ?? 0)}</span>
        </h3>
        <div class:list={[gridCls, "mt-4 md:mt-5"]}>
          {b.photos.map((p) => (
            <button type="button" class={frameCls} data-gallery-index-d={indexOf.get(p)} data-category={p.group} data-year-d={p.year} data-viewer-src={p.src} data-viewer-alt={p.alt}>
              <img src={p.src} alt={p.alt} loading="lazy" decoding="async" data-fade class={imgCls} />
            </button>
          ))}
          {(continuation.get(b.year) ?? []).map((p) => (
            <button type="button" class:list={[frameCls, "gallery-tail"]} data-gallery-index-d={indexOf.get(p)} data-category={p.group} data-year-d={p.year} data-viewer-src={p.src} data-viewer-alt={p.alt}>
              <img src={p.src} alt={p.alt} loading="lazy" decoding="async" data-fade class={imgCls} />
            </button>
          ))}
        </div>
      </div>
    ))}

    {tail.length > 0 && (
      <details data-more-d data-preview-d={PREVIEW} class="gallery-more group/more">
        <summary class="gallery-more-summary mt-8 flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 border-y border-outline-soft font-mono text-xs uppercase tracking-[0.14em] text-ink group-open/more:hidden [&::-webkit-details-marker]:hidden">
          <span>Show all <span data-more-count-d>{allPhotos.length}</span> frames</span>
          <span aria-hidden="true" class="w-4 text-center text-lg leading-none text-accent">+</span>
        </summary>
        {restTail.map((b) => (
          <div data-year-group-d class={blockCls}>
            <h3 class={headerCls}>
              <span class="display text-2xl md:text-3xl text-ink leading-none">{yearLabel(b.year)}</span>
              <span class="mono-label" data-year-count-d={b.year}>{frameLabel(yearCount.get(b.year) ?? 0)}</span>
            </h3>
            <div class:list={[gridCls, "mt-4 md:mt-5"]}>
              {b.photos.map((p) => (
                <button type="button" class={frameCls} data-gallery-index-d={indexOf.get(p)} data-category={p.group} data-year-d={p.year} data-viewer-src={p.src} data-viewer-alt={p.alt}>
                  <img src={p.src} alt={p.alt} loading="lazy" decoding="async" data-fade class={imgCls} />
                </button>
              ))}
            </div>
          </div>
        ))}
      </details>
    )}
  </div>
</section>

<PhotoViewer />

<script is:inline>
  (function () {
    var root = document.getElementById("gallery-dossier-root");
    if (!root) return;

    var chips = root.querySelectorAll("[data-chip-d]");
    var items = root.querySelectorAll("[data-gallery-index-d]");
    var emptyState = root.querySelector("[data-empty-state-d]");

    var inactiveClasses = ["border-outline-soft", "text-ink-muted", "hover:border-ink", "hover:text-ink"];
    var activeClasses = ["bg-ink", "text-cream", "border-ink"];

    function setActive(value) {
      chips.forEach(function (chip) {
        var chipValue = chip.getAttribute("data-chip-value") || "";
        if (chipValue === value) {
          inactiveClasses.forEach(function (c) { chip.classList.remove(c); });
          activeClasses.forEach(function (c) { chip.classList.add(c); });
          chip.setAttribute("aria-current", "true");
        } else {
          activeClasses.forEach(function (c) { chip.classList.remove(c); });
          inactiveClasses.forEach(function (c) { chip.classList.add(c); });
          chip.removeAttribute("aria-current");
        }
      });
    }

    function applyFilter(cat) {
      cat = cat || "";
      setActive(cat);
      var anyVisible = false;
      items.forEach(function (el) {
        var matches = !cat || el.getAttribute("data-category") === cat;
        el.hidden = !matches;
        if (matches) anyVisible = true;
      });
      if (emptyState) emptyState.hidden = anyVisible;

      // Year groups: recount each year; hide the years (and continued halves)
      // with nothing left in them.
      var yearN = {};
      root.querySelectorAll("[data-year-count-d]").forEach(function (el) {
        var y = el.getAttribute("data-year-count-d");
        var n = root.querySelectorAll('[data-year-d="' + y + '"]:not([hidden])').length;
        yearN[y] = n;
        el.textContent = n + (n === 1 ? " frame" : " frames");
      });
      var strandedHeader = false;
      root.querySelectorAll("[data-year-group-d]").forEach(function (g) {
        var own = g.querySelectorAll("[data-gallery-index-d]:not([hidden]):not(.gallery-tail)").length;
        var countEl = g.querySelector("[data-year-count-d]");
        var n = countEl ? yearN[countEl.getAttribute("data-year-count-d")] : own;
        g.hidden = n === 0;
        // A year whose matches all sit in its collapsed second half.
        if (countEl && own === 0 && n > 0) strandedHeader = true;
      });
      // Phones' "Show all" row: count the filtered set; open it when the
      // preview would be too thin to stand alone, hide it when nothing is below.
      var more = root.querySelector("[data-more-d]");
      if (more) {
        var below = more.querySelectorAll("[data-gallery-index-d]:not([hidden])").length
          + root.querySelectorAll(".gallery-tail:not([hidden])").length;
        var total = root.querySelectorAll("[data-gallery-index-d]:not([hidden])").length;
        var preview = Number(more.getAttribute("data-preview-d")) || 0;
        more.hidden = below === 0;
        if (below > 0 && (strandedHeader || total - below < preview / 2)) more.open = true;
        var moreCount = more.querySelector("[data-more-count-d]");
        if (moreCount) moreCount.textContent = total;
      }
    }

    var params = new URLSearchParams(location.search);
    applyFilter(params.get("cat"));

    chips.forEach(function (chip) {
      chip.addEventListener("click", function (e) {
        e.preventDefault();
        var value = chip.getAttribute("data-chip-value") || "";
        var url = value
          ? location.pathname + "?cat=" + encodeURIComponent(value)
          : location.pathname;
        history.pushState({}, "", url);
        applyFilter(value);
      });
    });

    window.addEventListener("popstate", function () {
      var p = new URLSearchParams(location.search);
      applyFilter(p.get("cat"));
    });

  })();
</script>

<style>
  /* md+: the archive is never collapsed — show the <details> body, drop its row.
     Browsers without ::details-content keep the row, so nothing is unreachable. */
  @media (min-width: 48rem) {
    @supports selector(::details-content) {
      .gallery-more::details-content { content-visibility: visible; display: block; }
      .gallery-more-summary { display: none; }
    }
  }
  /* Phones: a split year's second half waits for "Show all", like the rest. */
  @media (max-width: 47.98rem) {
    #gallery-grid-d:not(:has(> .gallery-more[open])) .gallery-tail { display: none; }
  }
</style>

<!-- CTA -->
<CtaBand
  heading={`Have photos from a SHPE <em class="font-serif italic font-normal lowercase tracking-normal text-accent">event</em>?`}
  body="Send your shots to the chapter and we'll log them into the archive alongside the rest of the record."
  primaryCta={{ label: "Submit photos", href: `mailto:${siteData.contactEmail}?subject=Gallery%20Submission` }}
  secondaryCta={{ label: "Browse events", href: "/events" }}
/>
