---
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import CtaBand from "@/components/CtaBand.astro";
import PhotoViewer from "@/components/PhotoViewer.astro";

import volunteeringData from "@/data/volunteering.json";
import conferencesData from "@/data/conferences.json";
import siteData from "@/data/site.json";
import type { EventPhoto, EventRecord } from "@/lib/server/events";

interface Props {
  events: EventRecord[];
  /** Extra photos per event id (event_photos), shown after each event's cover. */
  extraPhotos?: Map<number, EventPhoto[]>;
}

const allPhotos = [
  // Events without a photo have nothing to show in the grid.
  ...Astro.props.events
    .filter((e) => e.photo)
    .flatMap((e) => [
      { src: e.photo, alt: e.title, group: "Events" },
      ...(Astro.props.extraPhotos?.get(e.id) ?? []).map((p) => ({ src: p.url, alt: e.title, group: "Events" })),
    ]),
  ...volunteeringData.flatMap((v) =>
    v.photos.map((src) => ({ src, alt: v.name, group: "Volunteering" }))
  ),
  ...conferencesData.flatMap((c) =>
    c.photos.map((src) => ({
      src,
      alt: `${c.region ?? "Conference"} ${c.year} — ${c.city}`,
      group: "Conferences",
    }))
  ),
];

// Per-category counts for the manifest strip
const counts = {
  All: allPhotos.length,
  Events: allPhotos.filter((p) => p.group === "Events").length,
  Volunteering: allPhotos.filter((p) => p.group === "Volunteering").length,
  Conferences: allPhotos.filter((p) => p.group === "Conferences").length,
};

// Category chips appear only once a category has enough photos to be worth
// filtering — re-added automatically as the archive grows.
const CHIP_MIN = 4;
const allFilters = ["All", "Events", "Volunteering", "Conferences"] as const;
const filters = allFilters.filter((label) => label === "All" || counts[label] >= CHIP_MIN);

const chipBase =
  "inline-flex shrink-0 items-center whitespace-nowrap font-mono text-xs uppercase tracking-[0.14em] px-4 py-2 min-h-11 md:min-h-0 border transition-colors";
const chipInactive = "border-outline-soft text-ink-muted hover:border-ink hover:text-ink";
---

<!-- HERO -->
<header class="relative w-full bg-deep blueprint-deep py-24 md:py-32 px-6 overflow-hidden">
  <div class="max-w-[1200px] mx-auto relative z-10">
    <p class="font-mono text-cream/60 text-sm tracking-[0.18em] uppercase mb-5 text-balance">
      Photo Archive · {counts.All} frames on file
    </p>
    <h1 class="display text-5xl md:text-7xl text-cream leading-[1.02] max-w-3xl">
      Moments from the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">familia</em>.
    </h1>
    <p class="mt-7 text-cream/80 max-w-xl text-lg">
      A visual record of the chapter — events, volunteering, and conference delegations, logged frame by frame.
    </p>
  </div>

  <div class="absolute right-0 bottom-0 opacity-10 pointer-events-none select-none hidden md:block">
    <span class="display text-[200px] lg:text-[280px] leading-none text-cream translate-y-1/4 inline-block">{counts.All}</span>
  </div>
</header>

<!-- 01 — ARCHIVE -->
<section
  id="gallery-dossier-root"
  class="max-w-[1200px] mx-auto px-6 py-20 md:py-28"
>
  <SectionIndex label="Archive" />
  <h2 class="display text-3xl md:text-4xl text-ink mt-5 max-w-2xl">The whole familia, on file.</h2>
  <p class="mt-4 text-ink-muted max-w-2xl">
    Filter the record by category. Tap any frame to open it full-size.
  </p>

  <!-- Mono filter chips -->
  <nav aria-label="Filter gallery by category" class="-mx-6 mt-10 flex gap-3 overflow-x-auto px-6 [scrollbar-width:none] md:mx-0 md:flex-wrap md:overflow-visible md:px-0">
    {filters.map((label) => {
      const value = label === "All" ? "" : label;
      const href = value ? `?cat=${encodeURIComponent(value)}` : "?";
      return (
        <a
          data-chip-d
          data-chip-value={value}
          href={href}
          class:list={[chipBase, chipInactive]}
        >
          {label}
        </a>
      );
    })}
  </nav>

  <!-- Empty state -->
  <div
    data-empty-state-d
    hidden
    class="mt-12 flex flex-col items-center justify-center border border-outline-soft bg-surface-soft py-20 text-center"
  >
    <p class="font-mono text-sm text-ink-muted uppercase tracking-[0.14em]">No frames in this category yet.</p>
    <p class="pullquote mx-auto max-w-md mt-3">Check back soon.</p>
  </div>

  <!-- Contact sheet: fixed-aspect frames, so loading never shifts the layout -->
  <div class="mt-12 grid grid-cols-2 gap-2 sm:gap-3 lg:grid-cols-3" id="gallery-grid-d" data-viewer-group>
    {allPhotos.map((p, i) => (
      <button
        type="button"
        class="group block aspect-[4/3] w-full overflow-hidden border border-outline-soft bg-surface-soft focus:outline-none focus:ring-2 focus:ring-accent"
        data-gallery-index-d={i}
        data-category={p.group}
        data-viewer-src={p.src}
        data-viewer-alt={p.alt}
      >
        <img
          src={p.src}
          alt={p.alt}
          loading="lazy"
          decoding="async"
          data-fade
          class="h-full w-full object-cover group-hover:scale-[1.03] [transition:opacity_0.4s_ease,transform_0.5s_ease]"
        />
      </button>
    ))}
  </div>
</section>

<PhotoViewer />

<script is:inline>
  (function () {
    var root = document.getElementById("gallery-dossier-root");
    if (!root) return;

    var chips = root.querySelectorAll("[data-chip-d]");
    var items = root.querySelectorAll("[data-gallery-index-d]");
    var emptyState = root.querySelector("[data-empty-state-d]");

    var inactiveClasses = ["border-outline-soft", "text-ink-muted", "hover:border-ink", "hover:text-ink"];
    var activeClasses = ["bg-ink", "text-cream", "border-ink"];

    function setActive(value) {
      chips.forEach(function (chip) {
        var chipValue = chip.getAttribute("data-chip-value") || "";
        if (chipValue === value) {
          inactiveClasses.forEach(function (c) { chip.classList.remove(c); });
          activeClasses.forEach(function (c) { chip.classList.add(c); });
          chip.setAttribute("aria-current", "true");
        } else {
          activeClasses.forEach(function (c) { chip.classList.remove(c); });
          inactiveClasses.forEach(function (c) { chip.classList.add(c); });
          chip.removeAttribute("aria-current");
        }
      });
    }

    function applyFilter(cat) {
      cat = cat || "";
      setActive(cat);
      var anyVisible = false;
      items.forEach(function (el) {
        var matches = !cat || el.getAttribute("data-category") === cat;
        el.hidden = !matches;
        if (matches) anyVisible = true;
      });
      if (emptyState) emptyState.hidden = anyVisible;
    }

    var params = new URLSearchParams(location.search);
    applyFilter(params.get("cat"));

    chips.forEach(function (chip) {
      chip.addEventListener("click", function (e) {
        e.preventDefault();
        var value = chip.getAttribute("data-chip-value") || "";
        var url = value
          ? location.pathname + "?cat=" + encodeURIComponent(value)
          : location.pathname;
        history.pushState({}, "", url);
        applyFilter(value);
      });
    });

    window.addEventListener("popstate", function () {
      var p = new URLSearchParams(location.search);
      applyFilter(p.get("cat"));
    });

  })();
</script>

<!-- CTA -->
<CtaBand
  heading={`Have photos from a SHPE <em class="font-serif italic font-normal lowercase tracking-normal text-accent">event</em>?`}
  body="Send your shots to the chapter and we'll log them into the archive alongside the rest of the record."
  primaryCta={{ label: "Submit photos", href: `mailto:${siteData.contactEmail}?subject=Gallery%20Submission` }}
  secondaryCta={{ label: "Browse events", href: "/events" }}
/>
