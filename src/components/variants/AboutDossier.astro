---
import StatCountUp from "@/components/conferences/StatCountUp.astro";
import CtaBand from "@/components/CtaBand.astro";

// PLACEHOLDER — chapter stats. Update with real numbers when known.
const chapterStats = [
  { value: "50+", label: "Active members" },
  { value: "12",  label: "National conventions attended" },
  { value: "1,000+", label: "Volunteer hours since 2020" },
];

const values = [
  { label: "Familia", gloss: "A home in STEM, first and always." },
  { label: "Service", gloss: "Engineering that gives back to Greater Boston." },
  { label: "Education", gloss: "Peer tutoring, mentorship, academic support." },
  { label: "Resilience", gloss: "Hispanic excellence, sustained across generations." },
];

const eventCategories = [
  {
    label: "Professional",
    description: "Resume reviews, company visits, recruiter sessions.",
    photo: "/assets/events/capital-one-workshop.jpg",
    href: "/events/all?cat=Professional",
  },
  {
    label: "Cultural",
    description: "Cafecitos and conversations on Latin American topics.",
    photo: "/assets/events/navidad-en-familia.jpg",
    href: "/events/all?cat=Cultural",
  },
  {
    label: "Social",
    description: "Familia-bonding events, game nights, field days.",
    photo: "/assets/events/indoor-field-day.jpg",
    href: "/events/all?cat=Social",
  },
  {
    label: "Study Nights",
    description: "Peer tutoring across STEM courses.",
    photo: "/assets/events/resume-review-ge.png",
    href: "/events",
  },
  {
    label: "Volunteering",
    description: "Service across Greater Boston.",
    photo: "/assets/volunteering/museum-of-science-1.jpeg",
    href: "/volunteering",
  },
];

const exploreLinks = [
  {
    href: "/about/national",
    eyebrow: "SHPE Nationals",
    title: "The national network",
    description: "Est. 1974 in Los Angeles — history, mission, and five pillars.",
  },
  {
    href: "/about/board",
    eyebrow: "E-Board",
    title: "Meet the board",
    description: "The students running the chapter this term.",
  },
  {
    href: "/about/governance",
    eyebrow: "Governance",
    title: "How we run",
    description: "The constitution article by article, the nine-seat board, and our faculty advisor.",
  },
];

// Shared grid for everything that hangs off the thread:
// left third (before the line) / right two-thirds (after the line).
const ROW = "md:grid md:grid-cols-[1fr_2fr]";
---

<!-- HERO -->
<header class="relative w-full bg-deep blueprint-deep py-24 md:py-32 px-6 overflow-hidden">
  <div class="max-w-[1200px] mx-auto relative z-10">
    <p class="font-mono text-cream/60 text-sm tracking-[0.18em] uppercase mb-5">Boston University</p>
    <h1 class="display text-5xl md:text-7xl text-cream leading-[1.02] max-w-3xl">
      A <em class="font-serif italic font-normal lowercase tracking-normal text-accent">familia</em> of engineers.
    </h1>
    <p class="mt-7 text-cream/80 max-w-xl text-lg">
      <span class="font-serif italic text-cream">¡Bienvenidos!</span> BU SHPE has built a home in STEM for Hispanic students at Boston University — engineers, designers, scientists, mentors, allies.
    </p>
  </div>
</header>

<!--
  THE CHAPTER THREAD
  One continuous vertical rule runs from the hero to the CTA. Each section is
  a numbered chapter anchored to it: chapter numbers connect from the left,
  content hangs to the right (mobile: thread sits at the left edge).
-->
<section class="max-w-[1200px] mx-auto px-6">
  <div class="relative pt-16 pb-20 md:pt-24 md:pb-28">
    <!-- the thread -->
    <span class="absolute inset-y-0 left-0 md:left-1/3 w-px bg-rule/50" aria-hidden="true"></span>
    <span class="absolute top-0 left-0 md:left-1/3 -translate-x-1/2 h-2 w-2 rotate-45 bg-accent" aria-hidden="true"></span>
    <span class="absolute bottom-0 left-0 md:left-1/3 -translate-x-1/2 h-2 w-2 rotate-45 bg-accent" aria-hidden="true"></span>

    <div class="relative">
      <!-- 01 — VALUES -->
      <div class:list={[ROW, "md:items-center"]}>
        <div class="hidden md:flex items-center gap-4">
          <span class="mono-label text-ink-muted">01 — Values</span>
          <span class="h-px flex-1 bg-rule/50" aria-hidden="true"></span>
        </div>
        <div class="pl-8 md:pl-10">
          <p class="mono-label text-ink-muted mb-3 md:hidden">01 — Values</p>
          <h2 class="display text-3xl md:text-4xl text-ink">Four words we organize around.</h2>
        </div>
      </div>

      <div class="mt-10 md:mt-6">
        {values.map((v) => (
          <div class:list={[ROW, "md:items-baseline py-5 md:py-7"]}>
            <p class="pl-8 md:pl-0 md:pr-10 md:text-right">
              <span class="display text-4xl md:text-6xl leading-none text-ink">{v.label}</span>
            </p>
            <p class="pl-8 md:pl-10 mt-2 md:mt-0 text-ink-muted max-w-md">{v.gloss}</p>
          </div>
        ))}
      </div>

      <!-- 02 — KEEP EXPLORING -->
      <div class:list={[ROW, "md:items-center mt-24 md:mt-32"]}>
        <div class="hidden md:flex items-center gap-4">
          <span class="mono-label text-ink-muted">02 — Keep exploring</span>
          <span class="h-px flex-1 bg-rule/50" aria-hidden="true"></span>
        </div>
        <div class="pl-8 md:pl-10">
          <p class="mono-label text-ink-muted mb-3 md:hidden">02 — Keep exploring</p>
          <h2 class="display text-3xl md:text-4xl text-ink">More of the story.</h2>
          <p class="mt-3 text-ink-muted max-w-md">
            The national organization we belong to, the students who run the chapter, and the rules we run it by.
          </p>
        </div>
      </div>

      <div class="mt-8 md:mt-4">
        {exploreLinks.map((link) => (
          <a href={link.href} class:list={["group block", ROW, "md:items-baseline py-6 md:py-8"]}>
            <p class="pl-8 md:pl-0 md:pr-10 md:text-right">
              <span class="mono-label text-ink-muted">{link.eyebrow}</span>
            </p>
            <div class="pl-8 md:pl-10">
              <p class="display text-3xl md:text-4xl text-ink transition-colors group-hover:text-accent">
                {link.title}
                <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1.5">→</span>
              </p>
              <p class="mt-2 text-sm text-ink-muted max-w-md">{link.description}</p>
            </div>
          </a>
        ))}
      </div>

      <!-- 03 — BY THE NUMBERS -->
      <div class:list={[ROW, "md:items-center mt-24 md:mt-32"]}>
        <div class="hidden md:flex items-center gap-4">
          <span class="mono-label text-ink-muted">03 — By the numbers</span>
          <span class="h-px flex-1 bg-rule/50" aria-hidden="true"></span>
        </div>
        <div class="pl-8 md:pl-10">
          <p class="mono-label text-ink-muted mb-3 md:hidden">03 — By the numbers</p>
          <h2 class="display text-3xl md:text-4xl text-ink">What our familia adds up to.</h2>
        </div>
      </div>

      <div class:list={[ROW, "md:items-end mt-10 md:mt-12"]}>
        <p class="pl-8 md:pl-0 md:pr-10 md:text-right md:justify-self-end text-sm text-ink-muted max-w-[28ch]">
          Years of gatherings, conventions, and service — kept by the chapter, one member at a time.
        </p>
        <div class="pl-8 md:pl-10 mt-8 md:mt-0 flex flex-col sm:flex-row gap-10 md:gap-14 lg:gap-20">
          {chapterStats.map((stat) => (
            <StatCountUp value={stat.value} label={stat.label} accent />
          ))}
        </div>
      </div>

      <!-- 04 — GATHERINGS -->
      <div class:list={[ROW, "md:items-center mt-24 md:mt-32"]}>
        <div class="hidden md:flex items-center gap-4">
          <span class="mono-label text-ink-muted">04 — Gatherings</span>
          <span class="h-px flex-1 bg-rule/50" aria-hidden="true"></span>
        </div>
        <div class="pl-8 md:pl-10">
          <p class="mono-label text-ink-muted mb-3 md:hidden">04 — Gatherings</p>
          <h2 class="display text-3xl md:text-4xl text-ink">Five kinds of gatherings.</h2>
          <p class="mt-3 text-ink-muted max-w-md">
            Across the year, the chapter comes together in a handful of distinct ways.
          </p>
        </div>
      </div>

      <!-- full-width photo plate; the thread passes behind it -->
      <div class="mt-10 md:mt-14 pl-8 md:pl-0 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-5">
        {eventCategories.map((cat) => (
          <a
            href={cat.href}
            class="group relative block aspect-[3/4] overflow-hidden bg-surface-soft rounded-[var(--radius-card)]"
          >
            <img
              src={cat.photo}
              alt={cat.label}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/30 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-5">
              <span class="block font-mono uppercase tracking-[0.12em] text-xs font-medium text-cream/80 mb-2">
                {cat.label}
              </span>
              <p class="text-sm leading-snug text-cream">{cat.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<CtaBand
  heading={`Become part of the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">familia</em>.`}
  body="The chapter is still built one member at a time. Add your name to the next chapter of the story."
  primaryCta={{ label: "Join the chapter", href: "/join" }}
  secondaryCta={{ label: "Browse events", href: "/events" }}
/>
