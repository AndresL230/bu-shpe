---
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import CtaBand from "@/components/CtaBand.astro";
import Icon from "@/components/Icon.astro";

import siteData from "@/data/site.json";
import type { VolunteeringRecord } from "@/lib/server/content";
import { formatShpeYear } from "@/lib/shpe-year";

interface Props {
  /** Programs in display order (D1). */
  programs: VolunteeringRecord[];
}

const { programs } = Astro.props;
---

<!-- HERO -->
<header class="relative w-full bg-deep blueprint-deep py-16 md:py-28 px-6 overflow-hidden">
  <div class="max-w-[1152px] mx-auto relative z-10">
    <p class="font-mono text-cream/60 text-xs tracking-[0.14em] md:text-sm md:tracking-[0.18em] uppercase mb-5">Volunteering · Greater Boston</p>
    <h1 class="display text-5xl md:text-7xl text-cream leading-[1.02] max-w-3xl">
      <em class="font-serif italic font-normal lowercase tracking-normal text-accent">Service</em> is part of the SHPE familia.
    </h1>
    <p class="mt-7 text-cream/80 max-w-xl text-lg">
      We show up for Greater Boston — at museums, food banks, and on the street with meals.
    </p>
  </div>

  <!-- Decorative watermark -->
</header>

<!-- 01 — PROGRAMS -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28">
  <SectionIndex label="Programs" />
  <h2 class="display text-3xl md:text-4xl text-ink mt-5 max-w-2xl">The field log.</h2>
  <p class="mt-4 text-ink-muted max-w-md">
    Where the chapter has shown up — museums, food banks, and meals on the street.
  </p>

  <div class="mt-12 flex flex-col gap-px bg-outline-soft border border-outline-soft">
    {programs.map((program, index) => (
      <article class="bg-bg grid grid-cols-1 md:grid-cols-12 gap-0 md:gap-10 items-stretch">

        {/* Image side — md:col-span-7, alternates left/right */}
        <div
          class:list={[
            "md:col-span-7",
            index % 2 === 0 ? "md:order-1" : "md:order-2",
          ]}
        >
          {program.photos.length >= 2 ? (
            /* Phones: one 16:9 slot like every other card (second photo is desktop-only) */
            <div class="grid grid-cols-2 max-md:grid-cols-1 gap-px bg-outline-soft h-full">
              <div class="photo-warm overflow-hidden">
                <img
                  src={program.photos[0]}
                  alt={`${program.name} — photo 1`}
                  class="w-full h-full object-cover aspect-[16/9] md:aspect-[4/3]"
                  loading="lazy"
                />
              </div>
              <div class="photo-warm overflow-hidden max-md:hidden">
                <img
                  src={program.photos[1]}
                  alt={`${program.name} — photo 2`}
                  class="w-full h-full object-cover aspect-[4/3]"
                  loading="lazy"
                />
              </div>
            </div>
          ) : program.photos.length === 1 ? (
            <div class="photo-warm overflow-hidden h-full">
              <img
                src={program.photos[0]}
                alt={`${program.name}`}
                class="w-full h-full object-cover aspect-[16/9] md:aspect-auto md:min-h-[18rem]"
                loading="lazy"
              />
            </div>
          ) : (
            <>
              <div class="bg-deep blueprint-deep p-12 h-full min-h-[14rem] hidden md:flex flex-col justify-center">
                <p class="pullquote text-cream! text-left leading-snug">
                  "{program.description.split(".")[0]}."
                </p>
              </div>
              {/* Phones: no photo — a navy title card fills the same media slot */}
              <div class="md:hidden relative overflow-hidden bg-deep blueprint-deep aspect-[16/7]" aria-hidden="true">
                <span class="absolute right-5 -bottom-6 display text-[10rem] leading-none text-cream/10 tabular-nums select-none">{String(index + 1).padStart(2, "0")}</span>
              </div>
            </>
          )}
        </div>

        {/* Text side — md:col-span-5, opposite order */}
        <div
          class:list={[
            "md:col-span-5 flex flex-col justify-center gap-4 p-7 md:p-9",
            index % 2 === 0 ? "md:order-2" : "md:order-1",
          ]}
        >
          <p class="font-mono text-sm text-accent tracking-wide uppercase md:hidden">
            {String(index + 1).padStart(2, "0")} · Field Log{program.shpeYear != null && <span class="text-ink-muted"> · {formatShpeYear(program.shpeYear)}</span>}
          </p>
          {program.shpeYear != null && <p class="mono-label max-md:hidden">{formatShpeYear(program.shpeYear)}</p>}
          <h3 class="display text-2xl md:text-3xl text-ink">{program.name}</h3>
          <p class="text-sm leading-relaxed text-ink-muted">{program.description}</p>
        </div>

      </article>
    ))}
  </div>
</section>

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 02 — IMPACT -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-12">
  <div class="md:col-span-5">
    <SectionIndex label="Impact" />
    <h2 class="display text-3xl md:text-4xl text-ink mt-5">What showing up adds up to.</h2>
    <p class="mt-4 text-ink-muted max-w-md">
      Pulled straight from the field log — no rounding up.
    </p>
  </div>
  <div class="md:col-span-7">
    <!-- Phones: ledger rows (value + label) instead of boxes -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-outline-soft border border-outline-soft max-sm:gap-0 max-sm:bg-transparent max-sm:border-x-0 max-sm:border-b-0 max-sm:divide-y max-sm:divide-outline-soft md:gap-0 md:bg-transparent md:border-x-0 md:border-b-0 md:divide-x md:divide-outline-soft">
      {[
        { value: "16,000", label: "lbs of food sorted in one afternoon — Greater Boston Food Bank" },
        { value: "2", label: "Rhetty-to-Go meal routes — Kenmore & Back Bay" },
        { value: "3", label: "standing community partners across Greater Boston" },
      ].map((stat) => (
        <div class="bg-bg p-7 md:bg-transparent md:px-7 md:pt-6 md:pb-0 md:first:pl-0 md:last:pr-0 max-sm:grid max-sm:grid-cols-[7rem_1fr] max-sm:items-baseline max-sm:gap-x-5 max-sm:bg-transparent max-sm:px-0 max-sm:py-5">
          <p class="display text-4xl md:text-5xl leading-none text-accent tabular-nums">{stat.value}</p>
          <p class="mt-3 font-mono text-xs text-ink-muted uppercase tracking-[0.12em] leading-relaxed max-sm:mt-0">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<div class="max-w-[1200px] mx-auto px-6"><div class="border-t border-outline-soft"></div></div>

<!-- 03 — GET INVOLVED -->
<section class="max-w-[1200px] mx-auto px-6 py-16 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-12">
  <div class="md:col-span-5">
    <SectionIndex label="Get Involved" />
    <h2 class="display text-3xl md:text-4xl text-ink mt-5">Have a partner in mind?</h2>
    <p class="mt-4 text-ink-muted max-w-md">
      Tell us where you'd like to serve next.
    </p>
  </div>
  <div class="md:col-span-7">
    <!-- Phones: hairline rows (inline number + title) instead of boxes -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-outline-soft border border-outline-soft max-sm:gap-0 max-sm:bg-transparent max-sm:border-x-0 max-sm:border-b-0 max-sm:divide-y max-sm:divide-outline-soft md:grid-cols-1 md:gap-0 md:bg-transparent md:border-x-0 md:divide-y md:divide-outline-soft">
      {[
        { t: "Get on the list", d: "Volunteer calls go out through the mailing list first." },
        { t: "Show up", d: "Most outings are a single afternoon — no experience needed." },
        { t: "Bring an idea", d: "Know an organization that could use engineers? Tell us." },
      ].map((step, i) => (
        <div class="bg-bg p-7 md:grid md:grid-cols-[12rem_1fr] md:items-baseline md:gap-x-8 md:bg-transparent md:px-0 md:py-6 max-sm:grid max-sm:grid-cols-[auto_1fr] max-sm:items-baseline max-sm:gap-x-5 max-sm:bg-transparent max-sm:px-0 max-sm:py-5">
          <p class="font-mono text-accent text-sm md:hidden">{String(i + 1).padStart(2, "0")}</p>
          <p class="display text-xl text-ink mt-2 max-sm:mt-0 md:mt-0">{step.t}</p>
          <p class="mt-2 text-ink-muted text-sm max-sm:col-start-2 md:mt-0">{step.d}</p>
        </div>
      ))}
    </div>
    <a
      href={`mailto:${siteData.contactEmail}?subject=Volunteer%20Idea`}
      class="group mt-5 inline-flex min-h-11 items-center gap-2 md:mt-8 md:min-h-0 font-mono text-sm text-ink-muted tracking-wide uppercase hover:text-accent transition-colors md:font-sans md:text-base md:font-medium md:normal-case md:tracking-normal md:text-ink md:hover:text-accent"
    >
      <span class="border-b border-outline-soft group-hover:border-accent transition-colors pb-1 md:border-current md:pb-0.5 md:group-hover:border-current">Send us your idea</span>
      <Icon name="arrow-forward" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
    </a>
  </div>
</section>

<!-- CTA -->
<CtaBand
  heading={`Pay it <em class="font-serif italic font-normal lowercase tracking-normal text-accent">forward</em>.`}
  body="Build community. Show up for Greater Boston. Bring an idea and we'll find a way to serve."
  primaryCta={{ label: "Send us your idea", href: `mailto:${siteData.contactEmail}?subject=Volunteer%20Idea` }}
  secondaryCta={{ label: "Join the chapter", href: "/join" }}
/>
