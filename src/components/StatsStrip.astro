---
interface Props {
  stats: { value: string; label: string }[];
  background?: "soft" | "white";
}

const { stats, background = "soft" } = Astro.props;
const bgClass = background === "soft" ? "bg-surface-soft" : "bg-surface";
---
<section class={`border-y border-rule py-12 px-6 ${bgClass}`}>
  <div class="max-w-[1200px] mx-auto grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-24">
    {stats.map((stat) => (
      <div class="flex flex-col items-start">
        <span class="display text-6xl md:text-7xl text-ink leading-none">{stat.value}</span>
        <span class="eyebrow mt-2 text-ink-muted">{stat.label}</span>
      </div>
    ))}
  </div>
</section>
