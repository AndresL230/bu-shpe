---
import type { Conference } from "@/types";
interface Props { conf: Conference; index: number; }
const { conf, index } = Astro.props;
const idx = String(index + 1).padStart(2, "0");
// Phones: only the newest entry (index 0) keeps the full plate. Every later
// entry collapses to a compact row — square thumb left, text right — so the
// log reads as an index rather than eight stacked full-width cards.
// Desktop (md+) is the same layout for every entry.
const compact = index > 0;
const hasMeta = (conf.headcount != null && conf.headcount > 0) || (conf.outcomes?.length ?? 0) > 0;
---
<article class:list={["grid grid-cols-1 md:grid-cols-12 gap-8 items-start", compact && "max-md:grid-cols-[6.5rem_1fr] max-md:gap-4"]}>
  <div class="md:col-span-5">
    {conf.photos[0] ? (
      <div class:list={["aspect-[16/10] overflow-hidden border border-outline-soft photo-warm", compact && "max-md:aspect-square"]}>
        <img src={conf.photos[0]} alt={`SHPE convention ${conf.year} in ${conf.city}`} class="w-full h-full object-cover" loading="lazy" />
      </div>
    ) : (
      <div class:list={["blueprint aspect-[16/10] border border-outline-soft bg-surface-soft flex flex-col items-center justify-center gap-2", compact ? "max-md:aspect-square max-md:gap-1" : "max-md:aspect-[16/6]"]}>
        <span class:list={["display text-5xl text-ink/15 leading-none", compact && "max-md:text-3xl"]} aria-hidden="true">{conf.year}</span>
        {compact ? (
          <span class="mono-label"><span class="md:hidden">No photos</span><span class="max-md:hidden">No photos on file</span></span>
        ) : (
          <span class="mono-label">No photos on file</span>
        )}
      </div>
    )}
  </div>
  <div class="md:col-span-7">
    <div class:list={["flex items-center gap-3 mb-3", compact && "max-md:mb-1.5"]}>
      <span class="mono-label text-ink">{idx}</span>
      <span class:list={["font-mono text-accent text-sm tracking-[0.12em] uppercase", compact && "max-md:text-xs"]}>{compact ? (
        <><span class="md:hidden">{conf.year}</span><span class="max-md:hidden">{conf.region ?? "National Convention"} · {conf.year}</span></>
      ) : (
        <>{conf.region ?? "National Convention"} · {conf.year}</>
      )}</span>
    </div>
    <h2 class:list={["display text-3xl md:text-4xl text-ink", compact && "max-md:text-2xl"]}>{conf.city}</h2>
    <p class:list={["mt-3 text-ink-muted max-w-xl", compact && "max-md:mt-1.5 max-md:text-sm max-md:line-clamp-3"]}>{conf.description}</p>

    <div class:list={["mt-5 flex flex-wrap gap-x-10 gap-y-3", compact && "max-md:mt-3 max-md:flex-col max-md:gap-y-1.5", compact && !hasMeta && "max-md:hidden"]}>
      {conf.headcount != null && conf.headcount > 0 && (
        <div><span class="display text-3xl text-ink">{conf.headcount}</span><span class="mono-label ml-2">delegates</span></div>
      )}
      {conf.outcomes?.map((o) => (
        <div class:list={["flex items-center gap-2 text-ink", compact && "max-md:items-baseline"]}><span class="font-mono text-accent" aria-hidden="true">›</span><span class:list={["text-sm", compact && "max-md:text-xs"]}>{o}</span></div>
      ))}
    </div>

    {conf.quote && (
      <blockquote class="mt-6 border-l-2 border-accent pl-5">
        <p class="pullquote text-ink">“{conf.quote.text}”</p>
        <cite class="mono-label not-italic mt-2 block">— {conf.quote.attribution}</cite>
      </blockquote>
    )}
  </div>
</article>
