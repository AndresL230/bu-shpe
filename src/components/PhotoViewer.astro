---
/**
 * Full-screen photo viewer shared by every gallery on the site.
 * Any element with data-viewer-src (+ optional data-viewer-alt) opens it;
 * prev/next, arrow keys and swipe step through the visible items inside the
 * nearest [data-viewer-group]. Safe to include more than once per page:
 * the script is bundled once and uses the first viewer dialog it finds.
 */
---
<dialog
  data-photo-viewer
  aria-label="Photo viewer"
  class="photo-viewer m-0 h-dvh max-h-none w-screen max-w-none bg-deep/85 p-0 backdrop-blur-md"
>
  <figure data-pv-stage class="flex h-full w-full items-center justify-center px-3 py-16 sm:px-20">
    <img data-pv-image alt="" class="block max-h-full max-w-full object-contain shadow-2xl" />
  </figure>
  <!-- Caption + count sit in their own bar so the photo stays exactly centered. -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 mx-auto flex max-w-3xl items-baseline justify-between gap-4 px-4 pb-5 sm:px-20">
    <span data-pv-caption class="truncate text-sm text-cream/85"></span>
    <span data-pv-count class="shrink-0 font-mono text-xs tracking-[0.12em] text-cream/70"></span>
  </div>
  <button type="button" data-pv-close class="pv-btn right-3 top-3" aria-label="Close">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <button type="button" data-pv-prev class="pv-btn pv-side left-2 sm:left-4" aria-label="Previous photo">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
  </button>
  <button type="button" data-pv-next class="pv-btn pv-side right-2 sm:right-4" aria-label="Next photo">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
  </button>
</dialog>

<style is:global>
  /*
   * Gallery tiles: fixed-aspect frames with a tinted placeholder, so nothing
   * shifts while photos load; each photo fades in once it has arrived.
   */
  @media (scripting: enabled) {
    img[data-fade] { opacity: 0; transition: opacity 0.4s ease; }
    img[data-fade].is-loaded { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    img[data-fade] { transition: none; }
  }
</style>

<style>
  .photo-viewer[open] { display: block; }
  .photo-viewer::backdrop { background: transparent; }
  .pv-btn {
    position: absolute;
    z-index: 10;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in srgb, var(--color-cream) 35%, transparent);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-deep) 70%, transparent);
    color: var(--color-cream);
    padding: 0;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .pv-btn svg { display: block; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .pv-btn:hover { background: var(--color-cream); color: var(--color-ink); }
  .pv-btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .pv-btn[hidden] { display: none; }
  /* Arrows sit at the photo's vertical center, at the screen edges. */
  .pv-side { top: 50%; transform: translateY(-50%); }
</style>

<script>
  const markLoaded = (img: HTMLImageElement) => img.classList.add("is-loaded");
  document.querySelectorAll<HTMLImageElement>("img[data-fade]").forEach((img) => {
    if (img.complete) markLoaded(img);
    else {
      img.addEventListener("load", () => markLoaded(img), { once: true });
      img.addEventListener("error", () => markLoaded(img), { once: true });
    }
  });

  const dlg = document.querySelector<HTMLDialogElement>("dialog[data-photo-viewer]");
  if (dlg) {
    // The viewer may sit inside a hidden design variant; lift it to <body> so it can always show.
    document.body.appendChild(dlg);
    const q = <T extends Element>(s: string) => dlg.querySelector<T>(s)!;
    const img = q<HTMLImageElement>("[data-pv-image]");
    const caption = q<HTMLElement>("[data-pv-caption]");
    const count = q<HTMLElement>("[data-pv-count]");
    const prev = q<HTMLButtonElement>("[data-pv-prev]");
    const next = q<HTMLButtonElement>("[data-pv-next]");
    let items: HTMLElement[] = [];
    let pos = 0;

    const render = () => {
      const el = items[pos];
      img.src = el.dataset.viewerSrc!;
      img.alt = el.dataset.viewerAlt ?? "";
      caption.textContent = el.dataset.viewerAlt ?? "";
      const many = items.length > 1;
      count.textContent = many ? `${String(pos + 1).padStart(2, "0")} / ${String(items.length).padStart(2, "0")}` : "";
      prev.hidden = next.hidden = !many;
    };
    const step = (d: number) => {
      if (items.length < 2) return;
      pos = (pos + d + items.length) % items.length;
      render();
    };

    document.addEventListener("click", (e) => {
      const trigger = (e.target as Element).closest<HTMLElement>("[data-viewer-src]");
      if (!trigger || dlg.contains(trigger)) return;
      e.preventDefault();
      const group = trigger.closest("[data-viewer-group]") ?? document;
      // Only visible items, so filtered-out gallery tiles are skipped.
      items = [...group.querySelectorAll<HTMLElement>("[data-viewer-src]")].filter((el) => el.offsetParent !== null);
      pos = Math.max(0, items.indexOf(trigger));
      render();
      dlg.showModal();
    });

    q("[data-pv-close]").addEventListener("click", () => dlg.close());
    prev.addEventListener("click", () => step(-1));
    next.addEventListener("click", () => step(1));
    // Tap on the dark area (not the photo or a button) closes.
    dlg.addEventListener("click", (e) => {
      const t = e.target as Element;
      if (t === dlg || t.matches("[data-pv-stage]")) dlg.close();
    });
    dlg.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
    });
    let x0: number | null = null;
    dlg.addEventListener("touchstart", (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener("touchend", (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
      x0 = null;
    });
    dlg.addEventListener("close", () => img.removeAttribute("src"));
  }
</script>
