---
import SectionHeading from "@/components/SectionHeading.astro";
import employersData from "@/data/employers.json";
import type { EmployerGroup } from "@/types";

const groups = employersData as EmployerGroup[];

// Prefer an in-repo logo file when we have one; otherwise pull the brand's
// real logo from a token-free logo service by domain (fallback=false makes it
// 404 when no logo exists, so the inline onerror reveals the company name).
const logoSrc = (c: { domain?: string; logo?: string }) =>
  c.logo ?? (c.domain ? `https://unavatar.io/${c.domain}?fallback=false` : "");

// Secondary source: when the logo service has no match, fall back to the
// brand's favicon (reliable for any real domain) before showing plain text.
const faviconSrc = (domain?: string) =>
  domain ? `https://www.google.com/s2/favicons?sz=128&domain=${domain}` : "";
---

<section
  id="employers"
  class="scroll-mt-[88px] bg-surface-soft border-y border-rule reveal"
>
  <div class="max-w-[1200px] mx-auto px-6 py-24">
    <SectionHeading
      eyebrow="OUR MEMBERS"
      title="Where SHPE Takes Us"
      lede="BU SHPE members and alumni have gone on to work at companies shaping the future of engineering, technology, and science."
    />

    {groups.map((group) => (
      <div class="mt-14">
        <p class="eyebrow text-ink-muted mb-6">{group.industry}</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-px bg-rule/20">
          {group.companies.map((company) => (
            <div class="group flex aspect-[4/3] items-center justify-center bg-surface p-6 text-center transition-colors hover:bg-cream/30">
              <img
                src={logoSrc(company)}
                data-fallback={faviconSrc(company.domain)}
                alt={company.name}
                loading="lazy"
                referrerpolicy="no-referrer"
                class="employer-logo max-h-16 w-auto max-w-[72%] object-contain transition-transform duration-300 group-hover:scale-105"
              />
              <span
                class="display text-base tracking-wide text-ink"
                style="display:none"
              >{company.name}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<script is:inline>
  (function () {
    function fallback(img) {
      var fb = img.getAttribute("data-fallback");
      if (fb) {
        img.removeAttribute("data-fallback");
        img.src = fb;
      } else {
        img.style.display = "none";
        var label = img.nextElementSibling;
        if (label) label.style.display = "block";
      }
    }
    document.querySelectorAll("img.employer-logo").forEach(function (img) {
      img.addEventListener("error", function () { fallback(img); });
      // catch images that already failed before this script ran
      if (img.complete && img.naturalWidth === 0) fallback(img);
    });
  })();
</script>
