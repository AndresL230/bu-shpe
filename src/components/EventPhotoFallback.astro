---
/**
 * Typographic stand-in for an event card's photo slot when an event has no
 * photo (admins can publish without one). Fills its parent; the parent keeps
 * its own aspect ratio and background, so the card layout doesn't shift.
 */
interface Props {
  label: string;
  tone?: "classic" | "dossier";
  class?: string;
}

const { label, tone = "classic", class: className } = Astro.props;
---

<div
  class:list={["flex h-full w-full items-center justify-center p-2 sm:p-6", className]}
  aria-hidden="true"
>
  {tone === "dossier" ? (
    <span class="max-w-full text-center font-mono text-[0.55rem] uppercase tracking-[0.06em] text-ink-muted sm:text-sm sm:tracking-[0.14em]">{label}</span>
  ) : (
    <span class="display text-3xl md:text-4xl uppercase text-ink/15 text-center leading-none">{label}</span>
  )}
</div>
