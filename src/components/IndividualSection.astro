---
import type { GivingImpact } from "@/types";
import supportData from "@/data/support.json";

const donationFunds = (supportData as { donationFunds: string[]; givingImpact: GivingImpact[] }).donationFunds;
const givingImpact = (supportData as { donationFunds: string[]; givingImpact: GivingImpact[] }).givingImpact;
---

<!-- Where it goes — asymmetric -->
<section class="reveal py-20 md:py-28">
  <div class="mx-auto grid max-w-[1200px] grid-cols-1 gap-10 px-6 md:grid-cols-12 md:gap-16">
    <div class="md:col-span-5">
      <p class="eyebrow text-accent">WHERE IT GOES</p>
      <h2 class="display mt-4 text-3xl leading-[1.05] text-ink md:text-4xl">
        Every gift, straight to the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">students</em>.
      </h2>
      <p class="mt-6 leading-relaxed text-ink-muted">
        Your generosity removes barriers and opens doors, helping members show up fully at conferences, in mentorship rooms, and on the recruiting floor.
      </p>
    </div>
    <ul class="flex flex-col divide-y divide-rule/25 md:col-span-7 md:pt-1">
      {donationFunds.map((fund, i) => (
        <li class="flex items-baseline gap-5 py-5 first:pt-0">
          <span class="font-cond text-sm tracking-widest text-accent tabular-nums">0{i + 1}</span>
          <span class="text-lg leading-snug text-ink md:text-xl">{fund}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Impact — soft band for rhythm -->
<section class="reveal border-y border-outline-soft/50 bg-surface-soft">
  <div class="mx-auto max-w-[1200px] px-6 py-20 md:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow text-accent">YOUR IMPACT</p>
      <h2 class="display mt-4 text-3xl leading-[1.05] text-ink md:text-4xl">
        What your gift makes possible.
      </h2>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {givingImpact.map((item) => (
        <div class="rounded-[var(--radius-card)] border border-rule/30 bg-surface p-6">
          <p class="display mb-3 text-4xl leading-none text-accent">{item.amount}</p>
          <p class="text-sm leading-relaxed text-ink-muted">{item.outcome}</p>
        </div>
      ))}
    </div>
  </div>
</section>
