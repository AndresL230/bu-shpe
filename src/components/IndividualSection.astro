---
import type { GivingImpact } from "@/types";
import supportData from "@/data/support.json";
import siteData from "@/data/site.json";
import SectionIndex from "@/components/conferences/SectionIndex.astro";
import Icon from "@/components/Icon.astro";

const givingImpact = (supportData as { givingImpact: GivingImpact[] }).givingImpact;

// Give actions — labels from support.json, hrefs single-sourced from site.json.
const cta = supportData.closingCta;
const hrefSources: Record<string, string> = {
  donateUrl: siteData.donateUrl,
  contactEmail: `mailto:${siteData.contactEmail}`,
};
const hrefFor = (source: string) => hrefSources[source] ?? siteData.donateUrl;

const primary = { label: cta.primary.label, href: hrefFor(cta.primary.hrefSource) };
const secondary = { label: cta.secondary.label, href: hrefFor(cta.secondary.hrefSource) };
const primaryExternal = /^https?:/.test(primary.href);
---

<!-- Continuous canvas: sticky intro rail + outcome cards, closing on the give actions -->
<section class="reveal py-16 md:py-32">
  <div class="mx-auto max-w-[1200px] px-6">
    <!-- Phones: the rail dissolves (display: contents) so the give actions can
         drop below the outcome list via order-last; desktop DOM/look unchanged. -->
    <div class="grid grid-cols-1 gap-x-16 gap-y-10 md:gap-y-12 md:grid-cols-12 max-md:gap-y-0">
      <!-- Sticky intro rail -->
      <div class="md:col-span-4 max-md:contents">
        <SectionIndex label="Where it goes" />
        <h2 class="display mt-4 text-3xl leading-[1.05] text-ink md:text-4xl">
          Every gift, straight to the <em class="font-serif italic font-normal lowercase tracking-normal text-accent">students</em>.
        </h2>
        <p class="mt-6 leading-relaxed text-ink-muted">
          Your generosity removes barriers and opens doors, helping members show up fully at conferences, in mentorship rooms, and on the recruiting floor.
        </p>
        <p class="mt-4 leading-relaxed text-ink-muted">
          Here's what it becomes.
        </p>

        <!-- Give actions — editorial text links, underline resolves into an arrow -->
        <div class="mt-8 md:mt-10 flex flex-col items-start gap-5 max-md:order-last max-md:items-center max-md:gap-3">
          <a
            href={primary.href}
            target={primaryExternal ? "_blank" : undefined}
            rel={primaryExternal ? "noopener" : undefined}
            class="give-action max-md:hidden!"
          >
            <span class="give-action-label">{primary.label}</span>
            <svg class="give-arrowhead" width="13" height="10" viewBox="0 0 13 10" fill="none" aria-hidden="true">
              <path d="M1 5h10M8 1.5 11.5 5 8 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>

          <!-- Phones: the standard primary button replaces the display-text link -->
          <a
            href={primary.href}
            target={primaryExternal ? "_blank" : undefined}
            rel={primaryExternal ? "noopener" : undefined}
            class="group inline-flex w-full items-center justify-center gap-2 btn-dossier md:hidden"
          >
            {primary.label}
            <Icon name="arrow-forward" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
          </a>

          <a href={secondary.href} class="give-secondary group">
            <span class="give-secondary-label">{secondary.label}</span>
            <Icon name="arrow-forward" class="h-4 w-4 transition-transform group-hover:translate-x-1 md:hidden" />
          </a>
        </div>
      </div>

      <!-- Outcome cards -->
      <div class="grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-rule/30 bg-rule/30 sm:grid-cols-2 md:col-span-8 max-md:mt-10">
        {givingImpact.map((item, i) => (
          <div class="rule-accent group bg-surface p-6 transition-colors hover:bg-bg md:p-8">
            <p class="font-cond text-sm tracking-widest text-accent/70 tabular-nums">0{i + 1}</p>
            <p class="display mt-3 text-2xl leading-[1.08] text-ink">{item.headline}</p>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* ---- Primary action: text link whose underline resolves into an arrow ---- */
  .give-action {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-cond);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 1.4rem;
    line-height: 1.1;
    color: var(--color-ink);
    text-decoration: none;
    padding-bottom: 0.32em;
  }

  .give-action-label {
    position: relative;
  }
  .give-action-label::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -0.32em;
    height: 2px;
    width: 100%;
    background: var(--color-accent);
    transition: width 250ms cubic-bezier(0.2, 0.7, 0.2, 1), background-color 250ms ease;
  }

  .give-arrowhead {
    position: absolute;
    left: 100%;
    bottom: 0;
    transform: translate(-10px, -14px);
    color: var(--color-accent);
    opacity: 0;
    transition:
      opacity 250ms cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 250ms cubic-bezier(0.2, 0.7, 0.2, 1),
      color 250ms ease;
  }

  .give-action:hover .give-action-label::after,
  .give-action:focus-visible .give-action-label::after {
    width: calc(100% + 34px);
    background: var(--color-accent-deep);
  }
  .give-action:hover .give-arrowhead,
  .give-action:focus-visible .give-arrowhead {
    opacity: 1;
    transform: translate(22px, -14px);
    color: var(--color-accent-deep);
  }

  .give-action:focus-visible {
    outline: none;
  }
  .give-action:focus-visible .give-action-label {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
    border-radius: 2px;
  }

  /* ---- Secondary action: quiet text link ---- */
  .give-secondary {
    position: relative;
    font-family: var(--font-cond);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 1rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    padding-bottom: 0.32em;
    transition: color 200ms ease;
  }
  .give-secondary::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0.06em;
    height: 1px;
    width: 100%;
    background: currentColor;
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .give-secondary:hover,
  .give-secondary:focus-visible {
    color: var(--color-ink);
  }
  .give-secondary:hover::after,
  .give-secondary:focus-visible::after {
    opacity: 0.5;
  }

  /* Phones: grow the quiet secondary link to a ~44px tap target without
     shifting layout (padding offset by an equal negative margin). */
  /* Phones: the secondary becomes the site's standard text link (matches
     CtaBand's secondary): Inter, sentence case, always-on underline, 44px tall. */
  @media (max-width: 767px) {
    .give-secondary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      padding-bottom: 0;
      font-family: var(--font-sans);
      font-weight: 500;
      text-transform: none;
      letter-spacing: normal;
      color: var(--color-ink);
    }
    .give-secondary::after {
      display: none;
    }
    .give-secondary-label {
      border-bottom: 1px solid currentColor;
      padding-bottom: 0.125rem;
    }
    .give-secondary:hover,
    .give-secondary:focus-visible {
      color: var(--color-accent);
    }
  }

  /* Reduced motion: arrow still appears on hover, just without the slide. */
  @media (prefers-reduced-motion: reduce) {
    .give-action-label::after,
    .give-arrowhead,
    .give-secondary,
    .give-secondary::after {
      transition: none;
    }
  }
</style>
